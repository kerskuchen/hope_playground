void RegisterEntityTypes() {
    Entities.Register(EntityType(name: "Brazier", info: TypeOf[Brazier](), icon: "",
        fields: entityFields_Brazier[0..5],
        exports: entityExports_Brazier[0..4],
        pool: &entityPool_Brazier,
        Spawn: () => &entityPool_Brazier.Add().Entity,
        Make: () => &New[Brazier]().Entity,
        Release: (Entity* e) => entityPool_Brazier.Remove((Brazier*)e),
        ClearPool: () => { entityPool_Brazier = Pool[Brazier](); },
        Prepare: null,
        DrawPreview: (Entity* e) => ((Brazier*)e).DrawPreview(),
        Destroyed: null));
    Entities.Register(EntityType(name: "Turret", info: TypeOf[Turret](), icon: "",
        fields: entityFields_Turret[0..7],
        exports: entityExports_Turret[0..5],
        pool: &entityPool_Turret,
        Spawn: () => &entityPool_Turret.Add().Entity,
        Make: () => &New[Turret]().Entity,
        Release: (Entity* e) => entityPool_Turret.Remove((Turret*)e),
        ClearPool: () => { entityPool_Turret = Pool[Turret](); },
        Prepare: null,
        DrawPreview: (Entity* e) => ((Turret*)e).DrawPreview(),
        Destroyed: null));
    Entities.Register(EntityType(name: "Spawner", info: TypeOf[Spawner](), icon: "ghosty_0",
        fields: entityFields_Spawner[0..5],
        exports: entityExports_Spawner[0..4],
        pool: &entityPool_Spawner,
        Spawn: () => &entityPool_Spawner.Add().Entity,
        Make: () => &New[Spawner]().Entity,
        Release: (Entity* e) => entityPool_Spawner.Remove((Spawner*)e),
        ClearPool: () => { entityPool_Spawner = Pool[Spawner](); },
        Prepare: null,
        DrawPreview: (Entity* e) => ((Spawner*)e).DrawPreview(),
        Destroyed: null));
    Entities.Register(EntityType(name: "Ghost", info: TypeOf[Ghost](), icon: "",
        fields: entityFields_Ghost[0..6],
        pool: &entityPool_Ghost,
        Spawn: () => &entityPool_Ghost.Add().Entity,
        Make: () => &New[Ghost]().Entity,
        Release: (Entity* e) => entityPool_Ghost.Remove((Ghost*)e),
        ClearPool: () => { entityPool_Ghost = Pool[Ghost](); },
        Prepare: (Entity* e) => ((Ghost*)e).Prepare(),
        DrawPreview: null,
        Destroyed: (Entity* e) => ((Ghost*)e).Destroyed()));
}
