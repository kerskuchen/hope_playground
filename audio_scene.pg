// The audio scene (F6, in the level phase): music in layers on the beat grid and the spatial
// audio test. The listener is the window's center; positions are window pixels relative to it.
//
//     M                 the music (MusicLayers: level1-step1 .. 3 at 100 BPM, from the next
//                       measure) on, or fading out
//     1, 2, 3           its intensity: crossfades over the half beat before the next measure
//     4, 5, 6           its target intensity 1, 2, 3: a layer a measure towards it (ramp up, cool down)
//     B                 a metronome (AudioPulse): a beep on every beat, higher on a measure's first
//     Space             the coin at the mouse (spatial; a oneshot: each one a little higher or
//                       lower, louder or softer)
//     T                 a 440 Hz sine at the mouse: pan, distance and Doppler can be heard
//     F                 the sine's falloff (linear, inverse)
//     K                 a minimum loudness of 0.2
//     R                 reverb: dry, a small room, a big hall (the farther, the wetter)
//     L                 the sine's low-pass filter
//     G                 slow motion (the global playback speed 0.5)

struct AudioScene {
    MusicLayers music;
    bool hasMusic;
    int bpm;
    AudioPulse metronome;
    bool isTicking;                // B
    AudioStreamId sine;
    Vec2 sinePosition;
    Vec2 sineVelocity;             // smoothed
    AudioFalloffCurve sineFalloff; // F switches it
    bool isSineFloored;            // K: a minimum loudness of 0.2
    int reverbRoom;                // R: 0 dry, 1 a small room, 2 a big hall (the farther, the wetter)
    bool isSineFiltered;           // L
}

extend AudioScene {
    init() {
        bpm = Audio.RecordingBpm("level1-step1");
        metronome = AudioPulse(AudioBeat.Beat, bpm);
        StartMusic();
    }

    void StartMusic() {
        music = MusicLayers(["level1-step1", "level1-step2", "level1-step3"], volume: 0.7, fadeIn: 1);
        hasMusic = true;
    }

    // Before the scene goes: its streams stop
    void Leave() {
        if (hasMusic)
            music.Stop(fadeOut: 0.3);
        if (sine.value != 0)
            Audio.Stop(sine, fadeOut: 0.05);
        Audio.globalPlaybackSpeed = 1;
    }

    // The sine's falloff by the window's shorter side: full loudness within a tenth of it, silent
    // (or at its minimum loudness) from 45 % of it on (both circles fit the window)
    AudioFalloffParams SineFalloff() {
        let side = (float)Min(Input.windowDim.x, Input.windowDim.y);
        return AudioFalloffParams(curve: sineFalloff, minDistance: side * 0.1, maxDistance: side * 0.45, minLoudness: isSineFloored ? 0.2 : 0, reverbAtMaxDistance: reverbRoom == 2 ? 0.9 : 0);
    }

    void DoFrame() {
        let mouse = Input.cursors.screen - (Vec2)Input.windowDim * 0.5;
        if (Input.KeyPressed(Scancode.Space))
            Audio.SetReverbSend(Audio.PlayOneshot("sfx_coin_double1", mouse, pitch: Between(0.9, 1.12), volume: Between(0.7, 1), falloff: SineFalloff()), reverbRoom == 0 ? 0 : 0.3);
        DoSpatialTest(mouse);
        DoMusic();
        Draw.LogLine("DSP time ", (int)(Audio.dspTime * 10) / 10.0, " s, real ", (int)(Audio.dspTimeReal * 10) / 10.0, " s");
        Render(mouse);
    }

    // The music in layers and the metronome on its beats
    void DoMusic() {
        if (Input.KeyPressed(Scancode.M)) {
            if (hasMusic) {
                music.Stop(fadeOut: 1);
                music.Free();
                hasMusic = false;
            } else {
                StartMusic();
            }
        }
        for (let level in 0..3) {
            if (hasMusic && Input.KeyPressed((Scancode)((int)Scancode.Alpha1 + level)))
                music.SetIntensity(level);
            if (hasMusic && Input.KeyPressed((Scancode)((int)Scancode.Alpha4 + level)))
                music.SetTargetIntensity(level);
        }
        if (hasMusic)
            music.Update();
        if (Input.KeyPressed(Scancode.B)) {
            isTicking = !isTicking;
            metronome = AudioPulse(AudioBeat.Beat, bpm);
        }
        // Each beat scheduled ahead at its exact time: a short beep (an octave higher on a measure's first)
        for (let beat = isTicking ? metronome.Poll() : AudioPulseBeat(); beat.isDue; beat = metronome.Poll()) {
            let first = beat.index % 4 == 0;
            let tick = Audio.Play("debug_sine440", AudioTrack.Sound, volume: 0.25, playbackSpeed: first ? 2 : 1, start: AudioTime.At(beat.time), fadeIn: 0.005);
            Audio.Stop(tick, fadeOut: 0.03, at: AudioTime.At(beat.time + 0.06));
        }
        let beatNow = Audio.IndexAt(AudioBeat.Beat, Audio.dspTime, bpm);
        Draw.LogLine("M music (", hasMusic, "), 1 2 3 intensity (", hasMusic ? music.intensity + 1 : 0, "), 4 5 6 target (", hasMusic ? music.targetIntensity + 1 : 0, "), B metronome (", isTicking, "): ", bpm, " BPM, measure ",
            Audio.IndexAt(AudioBeat.Measure, Audio.dspTime, bpm), " beat ", beatNow % 4 + 1);
    }

    void DoSpatialTest(Vec2 mouse) {
        let settings = Audio.spatialSettings;
        settings.panWidth = Input.windowDim.x * 0.5;
        Audio.SetListener(Vec2.Zero, Vec2.Zero);
        let dt = Max(Input.deltaTimeReal, 0.001);
        let velocity = (mouse - sinePosition) * (1 / dt);
        sineVelocity = Vec2.Lerp(sineVelocity, velocity, 0.3);        // smoothed: the mouse moves in steps
        sinePosition = mouse;
        let isPlaying = sine.value != 0 && !Audio.IsFinished(sine);
        let restart = false;
        if (Input.KeyPressed(Scancode.F)) {
            sineFalloff = sineFalloff == AudioFalloffCurve.Linear ? AudioFalloffCurve.Inverse : AudioFalloffCurve.Linear;
            restart = isPlaying;                  // the falloff is the stream's from its start
        }
        if (Input.KeyPressed(Scancode.K)) {
            isSineFloored = !isSineFloored;
            restart = isPlaying;
        }
        if (Input.KeyPressed(Scancode.R)) {
            reverbRoom = (reverbRoom + 1) % 3;
            if (reverbRoom == 1)
                Audio.SetReverb(AudioReverbParams(roomSize: 0.3, damping: 0.7, wetGain: 1, preDelay: 0.005));
            if (reverbRoom == 2)
                Audio.SetReverb(AudioReverbParams(roomSize: 0.92, damping: 0.25, wetGain: 1, preDelay: 0.04));
            restart = isPlaying;                  // (the distance's reverb is the falloff's)
        }
        if (Input.KeyPressed(Scancode.T) || restart) {
            if (isPlaying) {
                Audio.Stop(sine, fadeOut: 0.05);
                sine = AudioStreamId(0);
            }
            if (!isPlaying || restart) {
                sine = Audio.PlaySpatial("debug_sine440", sinePosition, sineVelocity, SineFalloff(), volume: 0.5, loop: true, fadeIn: 0.05);
                Audio.SetLowpass(sine, isSineFiltered ? 0.6 : 0);
                Audio.SetReverbSend(sine, reverbRoom == 0 ? 0 : 0.3);
            }
        }
        if (Input.KeyPressed(Scancode.L)) {
            isSineFiltered = !isSineFiltered;
            Audio.SetLowpass(sine, isSineFiltered ? 0.6 : 0, rampDuration: 0.3);
        }
        if (Input.KeyPressed(Scancode.G))
            Audio.globalPlaybackSpeed = Audio.globalPlaybackSpeed < 1 ? 1 : 0.5;
        Audio.SetPosition(sine, sinePosition, sineVelocity);
        Draw.LogLine("audio scene (F6): T sine, F falloff (", sineFalloff, "), K minimum loudness (", isSineFloored, "), R reverb (", reverbRoom == 0 ? "dry" : (reverbRoom == 1 ? "small room" : "big hall, wetter far away"), "), L low-pass (", isSineFiltered, "), G slow motion (", Audio.globalPlaybackSpeed, "), Space coin");
        if (let info = Audio.GetStream(sine)) {
            Draw.LogLine("sine at ", mouse.Flooredi(), " moving ", sineVelocity.Flooredi(), " px/s: volume ", (int)(info.volume * 100), " %, pan ",
                (int)(info.pan * 100), " %, reverb ", (int)(info.reverbSend * 100), " %, playback speed ", (int)(info.playbackSpeed * 1000) / 1000.0, " (", (int)(440 * info.playbackSpeed * Audio.globalPlaybackSpeed), " Hz), low-pass ", (int)(info.lowpass * 100), " %");
        }
    }

    // In window pixels: the listener in the middle, the falloff's distances around it, the sine;
    // the beats of the measure at the bottom (the current one lit; the intensity's color)
    void Render(Vec2 mouse) {
        let center = (Vec2)Input.windowDim * 0.5;
        let screen = (Color color) => DrawParams(color: color, space: DrawSpace.Screen);
        let beatNow = (int)(Audio.IndexAt(AudioBeat.Beat, Audio.dspTime, bpm) % 4);
        let level = hasMusic ? music.intensity : -1;
        let lit = level == 0 ? Color(0.4, 1, 0.5, 1) : level == 1 ? Color(1, 0.85, 0.3, 1) : level == 2 ? Color(1, 0.35, 0.3, 1) : Color(0.7, 0.7, 0.7, 1);
        for (let i in 0..4) {
            let box = Rect(Vec2(center.x - 90 + i * 46, Input.windowDim.y - 70), Vec2(36, 36));
            Draw.Rect(box, 2, screen(i == beatNow ? lit : Color(0.25, 0.25, 0.25, 1)));
        }
        let falloff = SineFalloff();
        Draw.CircleOutline(Circle(center, falloff.minDistance), 1, 2, screen(Color(0.4, 1, 0.4, 0.8)));
        Draw.CircleOutline(Circle(center, falloff.maxDistance), 1, 2, screen(Color(1, 0.4, 0.4, 0.6)));
        Draw.Line(center - Vec2(8, 0), center + Vec2(8, 0), 1, 3, screen(Color.White));
        Draw.Line(center - Vec2(0, 8), center + Vec2(0, 8), 1, 3, screen(Color.White));
        let isPlaying = sine.value != 0 && !Audio.IsFinished(sine);
        Draw.Circle(Circle(center + mouse, 5), 3, screen(isPlaying ? Color(1, 0.9, 0.3, 1) : Color(0.5, 0.5, 0.5, 0.8)));
        if (isPlaying)
            Draw.Line(center + mouse, center + mouse + sineVelocity * 0.1, 1, 3, screen(Color(0.3, 1, 1, 1)));
    }
}
