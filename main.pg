
////////////////////////////////////////////////////////////////////////////////////////////////////
// Susi

struct SusiTracks {
    AnimationPlayer tracksAnim;
    Transform xform;
    Vec2 vel;
    Vec2 acc;
    float rotVel;
    float rotAcc;
}

extend SusiTracks {
    init() {
        tracksAnim = AnimationPlayer(Draw.GetAnim("susi.run"));
        xform = Vec2(100, 100);
    }

    void DoFrame() {
        tracksAnim.Update();
        let dirMove = Input.ActionValue2D("move");
        let dirLook = Input.ActionValue2D("look");
        vel = 100 * dirMove;
        xform.pos += vel * Input.deltaTime;
        Draw.Sprite3D(tracksAnim.CurSprite3D(), xform, 20);
    }
}

struct Susi {
    Sprite3D* turretSprite;
    SusiTracks tracks;
}

extend Susi {
    init() {
        turretSprite = Draw.GetSprite3D("susi_turret");
        tracks = SusiTracks();
    }

    void DoFrame() {
        tracks.DoFrame();
    }
}

////////////////////////////////////////////////////////////////////////////////////////////////////
// The start scene (F1): Sorcy runs in circles, Susi drives, the audio tests

struct StartScene {
    float time;
    Susi susi;
    AnimationPlayer sorcyAnim;
    AnimationPlayer ghostyAnim;
    bool showsGrid;                // 6: a world grid at the window's resolution (DrawSpace.ScreenWorld)
    AudioStreamId music;           // M fades it out and in again
    ShakeId rumble;                // 4: a continuous shake, on and off
    bool isFollowingSusi;          // C: the camera follows Susi
    bool isRumbling;
    // The spatial audio test (T): a 440 Hz sine at the mouse, the listener in the screen's center
    AudioStreamId sine;
    Vec2 sinePosition;
    Vec2 sineVelocity;             // smoothed
    AudioFalloffCurve sineFalloff; // F switches it
    bool isSineFloored;            // K: a minimum loudness of 0.2
    int reverbRoom;                // R: 0 dry, 1 a small room, 2 a big hall (the farther, the wetter)
    bool isSineFiltered;           // L
}

extend StartScene {
    // T: a 440 Hz sine at the mouse (position and velocity relative to the screen's center, where
    // the listener is), so pan, distance and Doppler can be heard; F switches the falloff, L the
    // low-pass filter, K a minimum loudness, G slow motion (the global playback speed 0.5)
    // The sine's falloff: silent (or at its minimum loudness) from half the screen's diagonal on
    AudioFalloffParams SineFalloff() {
        return AudioFalloffParams(curve: sineFalloff, minDistance: 20, maxDistance: ((Vec2)Input.windowDim).Length() * 0.5, minLoudness: isSineFloored ? 0.2 : 0, reverbAtMaxDistance: reverbRoom == 2 ? 0.9 : 0);
    }

    void DoSpatialTest(Vec2 mouse) {
        let settings = Audio.spatialSettings;
        settings.panWidth = Input.windowDim.x * 0.5;
        Audio.SetListener(Vec2.Zero, Vec2.Zero);
        let dt = Max(Input.deltaTimeReal, 0.001);
        let velocity = (mouse - sinePosition) * (1 / dt);
        sineVelocity = Vec2.Lerp(sineVelocity, velocity, 0.3);        // smoothed: the mouse moves in steps
        sinePosition = mouse;
        let isPlaying = sine.value != 0 && !Audio.IsFinished(sine);
        let restart = false;
        if (Input.KeyPressed(Scancode.F)) {
            sineFalloff = sineFalloff == AudioFalloffCurve.Linear ? AudioFalloffCurve.Inverse : AudioFalloffCurve.Linear;
            restart = isPlaying;                  // the falloff is the stream's from its start
        }
        if (Input.KeyPressed(Scancode.K)) {
            isSineFloored = !isSineFloored;
            restart = isPlaying;
        }
        if (Input.KeyPressed(Scancode.R)) {
            reverbRoom = (reverbRoom + 1) % 3;
            if (reverbRoom == 1)
                Audio.SetReverb(AudioReverbParams(roomSize: 0.3, damping: 0.7, wetGain: 1, preDelay: 0.005));
            if (reverbRoom == 2)
                Audio.SetReverb(AudioReverbParams(roomSize: 0.92, damping: 0.25, wetGain: 1, preDelay: 0.04));
            restart = isPlaying;                  // (the distance's reverb is the falloff's)
        }
        if (Input.KeyPressed(Scancode.T) || restart) {
            if (isPlaying) {
                Audio.Stop(sine, fadeOut: 0.05);
                sine = AudioStreamId(0);
            }
            if (!isPlaying || restart) {
                sine = Audio.PlaySpatial("debug_sine440", sinePosition, sineVelocity, SineFalloff(), volume: 0.5, loop: true, fadeIn: 0.05);
                Audio.SetLowpass(sine, isSineFiltered ? 0.6 : 0);
                Audio.SetReverbSend(sine, reverbRoom == 0 ? 0 : 0.3);
            }
        }
        if (Input.KeyPressed(Scancode.L)) {
            isSineFiltered = !isSineFiltered;
            Audio.SetLowpass(sine, isSineFiltered ? 0.6 : 0, rampDuration: 0.3);
        }
        if (Input.KeyPressed(Scancode.G))
            Audio.globalPlaybackSpeed = Audio.globalPlaybackSpeed < 1 ? 1 : 0.5;
        Audio.SetPosition(sine, sinePosition, sineVelocity);
        Draw.LogLine("spatial test: T sine, F falloff (", sineFalloff, "), K minimum loudness (", isSineFloored, "), R reverb (", reverbRoom == 0 ? "dry" : (reverbRoom == 1 ? "small room" : "big hall, wetter far away"), "), L low-pass (", isSineFiltered, "), G slow motion (", Audio.globalPlaybackSpeed, "), Space coin");
        let info = Audio.GetStream(sine);
        if (info != null) {
            Draw.LogLine("sine at ", mouse.Flooredi(), " moving ", sineVelocity.Flooredi(), " px/s: volume ", (int)(info.volume * 100), " %, pan ",
                (int)(info.pan * 100), " %, reverb ", (int)(info.reverbSend * 100), " %, playback speed ", (int)(info.playbackSpeed * 1000) / 1000.0, " (", (int)(440 * info.playbackSpeed * Audio.globalPlaybackSpeed), " Hz), low-pass ", (int)(info.lowpass * 100), " %");
        }
        Draw.LogLine("DSP time ", (int)(Audio.dspTime * 10) / 10.0, " s, real ", (int)(Audio.dspTimeReal * 10) / 10.0, " s");
    }

    init() {
        susi = Susi();
        sorcyAnim = AnimationPlayer(Draw.GetAnim("sorcy.run"));
        ghostyAnim = AnimationPlayer(Draw.GetAnim("ghosty.default"));
        music = Audio.Play("level1-step1", AudioTrack.Music, volume: 0.7, loop: true, fadeIn: 1);
    }

    // Before the scene goes: its streams stop
    void Leave() {
        Camera.StopShakes();
        Camera.StopFollowing();
        Audio.Stop(music, fadeOut: 0.3);
        if (sine.value != 0)
            Audio.Stop(sine, fadeOut: 0.05);
    }

    void DoFrame() {
        Camera.isCentered = false;
        Camera.allowPanning = true;
        Camera.allowZooming = true;
        Camera.rotation = 20;

        if (Input.KeyDown(Scancode.Left))
            Camera.pos -= Vec2(0.1, 0);
        if (Input.KeyDown(Scancode.Right))
            Camera.pos += Vec2(0.1, 0);
        if (Input.KeyDown(Scancode.Up))
            Camera.pos -= Vec2(0, 0.1);
        if (Input.KeyDown(Scancode.Down))
            Camera.pos += Vec2(0, 0.1);

        // C: the camera follows Susi (glides to keep her in the middle of the canvas: the camera
        // is not centered, its pos is the canvas's top left)
        if (Input.KeyPressed(Scancode.C)) {
            isFollowingSusi = !isFollowingSusi;
            if (!isFollowingSusi)
                Camera.StopFollowing();
        }
        if (isFollowingSusi)
            Camera.target = susi.tracks.xform.pos - Camera.viewportDim * (0.5 / Camera.zoom);
        Draw.LogLine("C camera follows Susi (", isFollowingSusi, ")");

        Draw.Sprite(Draw.GetSprite("background"), Vec2(0, 0), 0);

        sorcyAnim.Update();
        let sorcy = sorcyAnim.CurSprite();
        let sorcyPos = Transform(Vec2(50, 50), time);
        Draw.Sprite(sorcy, sorcyPos, 20);
        Draw.Pixel(sorcyPos.pos, 21, Color.Red);
        Draw.Pixel(sorcy.GetAttachmentPos(0, sorcyPos), 21, Color.Green);
        Draw.Pixel(sorcy.GetAttachmentPos(1, sorcyPos), 21, Color.Orange);

        // Translucent sorting: ghosty (translucent, depth 20) floats between a far sorcy (depth 15)
        // and a near one (depth 25), drawn in the opposite order (near, ghosty, far): it must be
        // in front of the far one and behind the near one
        let idle = Draw.GetAnim("sorcy.idle").frames[0].sprite;
        let ghostX = 175 + 55 * Sin(time * 0.02);
        let movesLeft = Cos(time * 0.02) < 0;              // (the asset looks to the right)
        ghostyAnim.Update();
        Draw.Sprite(idle, Transform(Vec2(230, 70)), 25);
        Draw.Sprite(ghostyAnim.CurSprite(), Transform(Vec2(ghostX, 66)), 20, flipHorizontal: movesLeft);
        Draw.Sprite(idle, Transform(Vec2(150, 70)), 15);

        // 6: the world's grid at the window's resolution (thin lines whatever the canvas)
        if (Input.KeyPressed(Scancode.Alpha6))
            showsGrid = !showsGrid;
        if (showsGrid) {
            let grid = DrawParams(color: Color(0.2, 1, 0.4, 0.6), space: DrawSpace.ScreenWorld);
            for (let x = 0; x <= 320; x += 16) {
                Draw.Line(Vec2(x, 0), Vec2(x, 180), 0.35, 90, grid);
            }
            for (let y = 0; y <= 180; y += 16) {
                Draw.Line(Vec2(0, y), Vec2(320, y), 0.35, 90, grid);
            }
        }
        Draw.LogLine("6 world grid at the window's resolution (", showsGrid, "); ghosty floats between a far and a near sorcy");

        time += 1;

        // Audio: Space plays the coin at the mouse (spatial), M fades the music out and in again
        let mouse = Input.cursors.screen - (Vec2)Input.windowDim * 0.5;
        if (Input.KeyPressed(Scancode.Space))
            Audio.SetReverbSend(Audio.PlaySpatial("sfx_coin_double1", mouse, falloff: SineFalloff()), reverbRoom == 0 ? 0 : 0.3);
        DoSpatialTest(mouse);
        if (Input.KeyPressed(Scancode.M)) {
            if (Audio.IsFinished(music) || Audio.GetStream(music) == null || Audio.GetStream(music).volume < 0.01)
                music = Audio.Play("level1-step1", AudioTrack.Music, volume: 0.7, loop: true, fadeIn: 1);
            else
                Audio.Stop(music, fadeOut: 1);
        }
        let musicInfo = Audio.GetStream(music);
        if (musicInfo != null)
            Draw.LogLine("music ", (int)(musicInfo.position * 10) / 10.0, " s (", (int)musicInfo.percentFinished, " %)");

        // Camera shakes: 1 a pendulum towards the mouse, 2 a random one, 3 a rotational one,
        // 4 a continuous rumble on and off (they add up)
        if (Input.KeyPressed(Scancode.Alpha1))
            Camera.AddShake(Shake.Pendulum(mouse, 4, 0.5));
        if (Input.KeyPressed(Scancode.Alpha2))
            Camera.AddShake(Shake.Random(4, 0.6));
        if (Input.KeyPressed(Scancode.Alpha3))
            Camera.AddShake(Shake.Rotational(3, 0.8));
        if (Input.KeyPressed(Scancode.Alpha4)) {
            if (isRumbling)
                Camera.StopShake(rumble, 0.5);
            else
                rumble = Camera.AddShake(Shake.Random(1, 0, speed: 35));
            isRumbling = !isRumbling;
        }
        Draw.LogLine("shakes: 1 pendulum (to the mouse), 2 random, 3 rotational, 4 rumble (", isRumbling, "): offset ", Camera.shakeOffset.Flooredi(), ", rotation ", (int)(Camera.shakeRotation * 10) / 10.0);

        susi.DoFrame();

        let cursors = Input.cursors;
        Draw.LogLine("hello klaine feeese!!");
        Draw.LogLine("screen = ", cursors.screen.Flooredi());
        Draw.LogLine("ui     = ", cursors.ui.Flooredi());
        Draw.LogLine("world  = ", cursors.world.Flooredi());
        Draw.LogLine("cam-pos      = ", Camera.pos);
        Draw.LogLine("cam-zoom     = ", Camera.zoom);
        Draw.LogLine("cam-viewport = ", Camera.viewportDim);

        Draw.Rect(cursors.world, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Magenta, space: DrawSpace.World));
        Draw.Rect(cursors.ui + Vec2.UnitX, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Blue, space: DrawSpace.UI));
        Draw.Rect(cursors.ui - Vec2.UnitX, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Blue, space: DrawSpace.UI));
        Draw.Rect(cursors.ui + Vec2.UnitY, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Blue, space: DrawSpace.UI));
        Draw.Rect(cursors.ui - Vec2.UnitY, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Blue, space: DrawSpace.UI));
        Draw.Rect(cursors.screen + Vec2.Ones, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Black, space: DrawSpace.Screen));
        Draw.Rect(cursors.screen - Vec2.Ones, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Black, space: DrawSpace.Screen));
    }
}

////////////////////////////////////////////////////////////////////////////////////////////////////
// Game: one scene at a time, F1 the start scene, F2 the physics debug scene, F3 the tilemap
// editor, F4 the navigation scene. A scene lives in its phase (hope/memory.pg): the start, the
// physics and the navigation scene in the level phase, the editor in the editor phase. Switching wipes the phase of the scene that goes
// and makes the next one in its phase; its frames allocate there too.

enum Scene { Start, Physics, Editor, Navigation }

struct Playground {
    Scene scene;
    StartScene* start;             // the current scene's state (the others are null)
    PhysicsScene* physics;
    GameEditor* editor;
    NavScene* navigation;
}

extend Playground {
    init() {
        Input.RegisterAction("move", InputActionType.AxisRadial2D);
        Input.AddActionBinding("move", InputActionBinding(GamepadAxis2D.LeftStick, 0.1));
        Input.AddActionBinding("move", InputActionBinding(GamepadButton.MoveLeft, GamepadButton.MoveRight, GamepadButton.MoveUp, GamepadButton.MoveDown));
        Input.AddActionBinding("move", InputActionBinding(Scancode.A, Scancode.D, Scancode.W, Scancode.S));
        Input.AddActionBinding("move", InputActionBinding(Scancode.Left, Scancode.Right, Scancode.Up, Scancode.Down));

        Input.RegisterAction("look", InputActionType.AxisSquare2D);
        Input.AddActionBinding("look", InputActionBinding(GamepadAxis2D.RightStick, 0.1));
        Input.AddActionBinding("look", InputActionBinding(Scancode.Kp4, Scancode.Kp6, Scancode.Kp8, Scancode.Kp5));

        Input.RegisterAction("attack_1", InputActionType.ButtonTrigger);
        Input.AddActionBinding("attack_1", InputActionBinding(MouseButton.Left));
        Input.AddActionBinding("attack_1", InputActionBinding(GamepadButton.LeftShoulder));

        Input.RegisterAction("attack_2", InputActionType.ButtonTrigger);
        Input.AddActionBinding("attack_2", InputActionBinding(MouseButton.Left));
        Input.AddActionBinding("attack_2", InputActionBinding(GamepadButton.RightShoulder));

        Input.RegisterAction("attack_3", InputActionType.ButtonTrigger);
        Input.AddActionBinding("attack_3", InputActionBinding(MouseButton.Middle));
        Input.AddActionBinding("attack_3", InputActionBinding(GamepadAxis.LeftShoulderTrigger, 0.5));
        Input.AddActionBinding("attack_3", InputActionBinding(GamepadAxis.RightShoulderTrigger, 0.5));

        SwitchTo(Scene.Start);
    }

    void SwitchTo(Scene next) {
        // The scene that goes, with everything in its phase
        if (start != null) {
            start.Leave();
            start = null;
            Memory.WipeLevel();
        }
        if (physics != null) {
            physics = null;
            Memory.WipeLevel();
        }
        if (navigation != null) {
            navigation = null;
            Memory.WipeLevel();
        }
        if (editor != null) {
            editor.Leave();
            editor = null;
            Memory.WipeEditor();
        }
        scene = next;
        Draw.isCanvasFree = next != Scene.Start;
        if (next == Scene.Start) {
            ScopeAllocLevel();
            start = New[StartScene]();
            Draw.clearColor = Color.Black;
        } else if (next == Scene.Physics) {
            ScopeAllocLevel();
            physics = New[PhysicsScene]();
            Draw.clearColor = Color.Grey(0.12);
        } else if (next == Scene.Navigation) {
            ScopeAllocLevel();
            navigation = New[NavScene]();
            Draw.clearColor = Color.Grey(0.08);
        } else {
            ScopeAllocEditor();
            editor = New[GameEditor]();
            Draw.clearColor = Color.Grey(0.3);
        }
    }

    void DoFrame() {
        if (Input.KeyPressed(Scancode.F1) && scene != Scene.Start)
            SwitchTo(Scene.Start);
        if (Input.KeyPressed(Scancode.F2) && scene != Scene.Physics)
            SwitchTo(Scene.Physics);
        if (Input.KeyPressed(Scancode.F3) && scene != Scene.Editor)
            SwitchTo(Scene.Editor);
        if (Input.KeyPressed(Scancode.F4) && scene != Scene.Navigation)
            SwitchTo(Scene.Navigation);
        Draw.LogLine("F1 start, F2 physics, F3 editor, F4 navigation | level ", Memory.level.used / 1024, " KiB, editor ", Memory.editor.used / 1024, " KiB, persistent ", Memory.persistent.used / 1024, " KiB");
        if (scene == Scene.Editor) {
            ScopeAllocEditor();
            editor.DoFrame();
        } else {
            ScopeAllocLevel();
            if (scene == Scene.Physics)
                physics.DoFrame();
            else if (scene == Scene.Navigation)
                navigation.DoFrame();
            else
                start.DoFrame();
        }
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////
// hope_playground (formerly DungeonTracks, ported from the C# version), for trying out hope's
// features: Sorcy runs in circles, Susi (a 3D sprite on tracks) drives with the "move" action, F2
// switches to the physics debug scene, F3 to the tilemap editor, F4 to the navigation scene, F1 back.
//
// The game is a module (hope/game): a platform layer hosts it (the targets of hope.pgproj).


Playground* playground = null;

// Also on F5 (the runtime restarts the game in the internal mode; it wipes the level phase)
void CreateGame() {
    Memory.WipeEditor();                       // (the previous playground's editor scene)
    playground = New[Playground]();
}
void DoFrame() { playground.DoFrame(); }
Game GameMain() {
    return Game(info: AppInfo("hope playground", "hope_playground", "0.01", 320, 180), Create: CreateGame, DoFrame: DoFrame);
}
