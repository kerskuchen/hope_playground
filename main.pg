
////////////////////////////////////////////////////////////////////////////////////////////////////
// Susi

struct SusiTracks {
    AnimationPlayer tracksAnim;
    Transform xform;
    Vec2 vel;
    Vec2 acc;
    float rotVel;
    float rotAcc;
}

extend SusiTracks {
    init() {
        tracksAnim = AnimationPlayer(Draw.GetAnim("susi.run"));
        xform = Vec2(100, 100);
    }

    void DoFrame() {
        tracksAnim.Update();
        let dirMove = Input.ActionValue2D("move");
        let dirLook = Input.ActionValue2D("look");
        vel = 100 * dirMove;
        xform.pos += vel * Input.deltaTime;
        Draw.Sprite3D(tracksAnim.CurSprite3D(), xform, 20);
    }
}

struct Susi {
    Sprite3D* turretSprite;
    SusiTracks tracks;
}

extend Susi {
    init() {
        turretSprite = Draw.GetSprite3D("susi_turret");
        tracks = SusiTracks();
    }

    void DoFrame() {
        tracks.DoFrame();
    }
}

////////////////////////////////////////////////////////////////////////////////////////////////////
// The start demo (F3): Sorcy runs in circles, Susi drives, the camera tests (the audio tests:
// the audio demo, F6)

struct StartDemo {
    float time;
    Susi susi;
    AnimationPlayer sorcyAnim;
    AnimationPlayer ghostyAnim;
    bool showsGrid;                // 6: a world grid at the window's resolution (DrawSpace.ScreenWorld)
    ShakeId rumble;                // 4: a continuous shake, on and off
    bool isFollowingSusi;          // C: the camera follows Susi
    bool isRumbling;
}

extend StartDemo {
    init() {
        susi = Susi();
        sorcyAnim = AnimationPlayer(Draw.GetAnim("sorcy.run"));
        ghostyAnim = AnimationPlayer(Draw.GetAnim("ghosty.default"));
    }

    // Before the demo goes: its camera effects stop
    void Leave() {
        Camera.StopShakes();
        Camera.StopFollowing();
    }

    void DoFrame() {
        Camera.isCentered = false;
        Camera.allowPanning = true;
        Camera.allowZooming = true;
        Camera.rotation = 20;

        if (Input.KeyDown(Scancode.Left)) {
            Camera.pos -= Vec2(0.1, 0);
        }
        if (Input.KeyDown(Scancode.Right)) {
            Camera.pos += Vec2(0.1, 0);
        }
        if (Input.KeyDown(Scancode.Up)) {
            Camera.pos -= Vec2(0, 0.1);
        }
        if (Input.KeyDown(Scancode.Down)) {
            Camera.pos += Vec2(0, 0.1);
        }

        // C: the camera follows Susi (glides to keep her in the middle of the canvas: the camera
        // is not centered, its pos is the canvas's top left)
        if (Input.KeyPressed(Scancode.C)) {
            isFollowingSusi = !isFollowingSusi;
            if (!isFollowingSusi) {
                Camera.StopFollowing();
            }
        }
        if (isFollowingSusi) {
            Camera.target = susi.tracks.xform.pos - Camera.viewportDim * (0.5 / Camera.zoom);
        }
        Draw.LogLine("C camera follows Susi ({isFollowingSusi})");

        Draw.Sprite(Draw.GetSprite("background"), Vec2(0, 0), 0);

        sorcyAnim.Update();
        let sorcy = sorcyAnim.CurSprite();
        let sorcyPos = Transform(Vec2(50, 50), time);
        Draw.Sprite(sorcy, sorcyPos, 20);
        Draw.Pixel(sorcyPos.pos, 21, Color.Red);
        Draw.Pixel(sorcy.GetAttachmentPos(0, sorcyPos), 21, Color.Green);
        Draw.Pixel(sorcy.GetAttachmentPos(1, sorcyPos), 21, Color.Orange);

        // Translucent sorting: ghosty (translucent, depth 20) floats between a far sorcy (depth 15)
        // and a near one (depth 25), drawn in the opposite order (near, ghosty, far): it must be
        // in front of the far one and behind the near one
        let idle = Draw.GetAnim("sorcy.idle").frames[0].sprite;
        let ghostX = 175 + 55 * Sin(time * 0.02);
        let movesLeft = Cos(time * 0.02) < 0;              // (the asset looks to the right)
        ghostyAnim.Update();
        Draw.Sprite(idle, Transform(Vec2(230, 70)), 25);
        Draw.Sprite(ghostyAnim.CurSprite(), Transform(Vec2(ghostX, 66)), 20, flipHorizontal: movesLeft);
        Draw.Sprite(idle, Transform(Vec2(150, 70)), 15);

        // 6: the world's grid at the window's resolution (thin lines whatever the canvas)
        if (Input.KeyPressed(Scancode.Alpha6)) {
            showsGrid = !showsGrid;
        }
        if (showsGrid) {
            let grid = DrawParams(color: Color(0.2, 1, 0.4, 0.6), space: DrawSpace.ScreenWorld);
            for (let x = 0; x <= 320; x += 16) {
                Draw.Line(Vec2(x, 0), Vec2(x, 180), 0.35, 90, grid);
            }
            for (let y = 0; y <= 180; y += 16) {
                Draw.Line(Vec2(0, y), Vec2(320, y), 0.35, 90, grid);
            }
        }
        Draw.LogLine("6 world grid at the window's resolution ({showsGrid}); ghosty floats between a far and a near sorcy");

        time += 1;

        // (the mouse relative to the window's center: the pendulum shake's direction)
        let mouse = Input.cursors.screen - (Vec2)Input.windowDim * 0.5;

        // Camera shakes: 1 a pendulum towards the mouse, 2 a random one, 3 a rotational one,
        // 4 a continuous rumble on and off (they add up)
        if (Input.KeyPressed(Scancode.Alpha1)) {
            Camera.AddShake(Shake.Pendulum(mouse, 4, 0.5));
        }
        if (Input.KeyPressed(Scancode.Alpha2)) {
            Camera.AddShake(Shake.Random(4, 0.6));
        }
        if (Input.KeyPressed(Scancode.Alpha3)) {
            Camera.AddShake(Shake.Rotational(3, 0.8));
        }
        if (Input.KeyPressed(Scancode.Alpha4)) {
            if (isRumbling) {
                Camera.StopShake(rumble, 0.5);
            } else {
                rumble = Camera.AddShake(Shake.Random(1, 0, speed: 35));
            }
            isRumbling = !isRumbling;
        }
        Draw.LogLine("shakes: 1 pendulum (to the mouse), 2 random, 3 rotational, 4 rumble ({isRumbling}): offset {Camera.shakeOffset.Flooredi()}, rotation {(int)(Camera.shakeRotation * 10) / 10.0}");

        susi.DoFrame();

        let cursors = Input.cursors;
        Draw.LogLine("hello klaine feeese!!");
        Draw.LogLine("screen = {cursors.screen.Flooredi()}");
        Draw.LogLine("ui     = {cursors.ui.Flooredi()}");
        Draw.LogLine("world  = {cursors.world.Flooredi()}");
        Draw.LogLine("cam-pos      = {Camera.pos}");
        Draw.LogLine("cam-zoom     = {Camera.zoom}");
        Draw.LogLine("cam-viewport = {Camera.viewportDim}");

        Draw.Rect(cursors.world, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Magenta, space: DrawSpace.World));
        Draw.Rect(cursors.ui + Vec2.UnitX, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Blue, space: DrawSpace.UI));
        Draw.Rect(cursors.ui - Vec2.UnitX, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Blue, space: DrawSpace.UI));
        Draw.Rect(cursors.ui + Vec2.UnitY, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Blue, space: DrawSpace.UI));
        Draw.Rect(cursors.ui - Vec2.UnitY, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Blue, space: DrawSpace.UI));
        Draw.Rect(cursors.screen + Vec2.Ones, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Black, space: DrawSpace.Screen));
        Draw.Rect(cursors.screen - Vec2.Ones, Vec2.Ones, Depth.Nearest, DrawParams(color: Color.Black, space: DrawSpace.Screen));
    }
}

////////////////////////////////////////////////////////////////////////////////////////////////////
// Game: one demo at a time, F9 the scene demo, F2 the physics debug demo, F3 the start demo,
// F4 the navigation demo, F6 the audio demo, F7 the lighting demo, F8 the UI demo, F10 the
// effects demo (F1: hope's scene editor, over any of them). A demo lives in the level phase
// (hope/core.pg): switching wipes it and makes the next one there; its frames allocate there too.

enum Demo { Scene, Start, Physics, Navigation, Audio, Lighting, Ui, Effects, Legs }

// The player's settings (the UI demo's options), kept with hope's Storage (the value 'settings')
@Serializable
struct Settings {
    @Serialize float music = 1;
    @Serialize float sounds = 1;
    @Serialize bool showsHints = true;
}

extend Settings {
    void Apply() {
        Audio.SetTrackGain(AudioTrack.Music, music);
        Audio.SetTrackGain(AudioTrack.Sound, sounds);
    }
}

// The game's state: everything it keeps (Runtime.State, hope's state.pg: a code reload keeps it)
@State struct Playground {
    Demo demo;
    SceneDemo* scene;             // the current demo's state (the others are null)
    StartDemo* start;
    PhysicsDemo* physics;
    NavDemo* navigation;
    AudioDemo* audio;
    LightingDemo* lighting;
    UiDemo* ui;
    EffectsDemo* effects;
    LegsDemo* legs;
    Settings settings;
    bool areSettingsChanged;       // not saved yet (SaveSettings: leaving the options, the UI demo)
    string sceneDemoName;          // the scene the scene demo shows (kept when the demo is made again; persistent memory)
    int ghostsGone;                // (the entities demo's preview line)
    // The tests' (tests.pg)
    [Vec3, 8] legsLastFeet;        // the legs demo's feet in the last frame
    [int, 8] legsStretched;        // frames in a row a leg was too long (held back by a wall, it steps soon)
    [long, 3] testLevelUsed;       // the phases measured in the leak test
    [long, 3] testPersistentUsed;
}

extend Playground {
    init() {
        Storage.Read("settings", &settings);           // (none yet: the defaults)
        SaveSamples.Check[Settings]("settings");      // (the internal mode: save_samples/ still read the same)
        settings.Apply();

        Input.RegisterAction("move", InputActionType.AxisRadial2D);
        Input.AddActionBinding("move", InputActionBinding(GamepadAxis2D.LeftStick, 0.1));
        Input.AddActionBinding("move", InputActionBinding(GamepadButton.MoveLeft, GamepadButton.MoveRight, GamepadButton.MoveUp, GamepadButton.MoveDown));
        Input.AddActionBinding("move", InputActionBinding(Scancode.A, Scancode.D, Scancode.W, Scancode.S));
        Input.AddActionBinding("move", InputActionBinding(Scancode.Left, Scancode.Right, Scancode.Up, Scancode.Down));

        Input.RegisterAction("look", InputActionType.AxisSquare2D);
        Input.AddActionBinding("look", InputActionBinding(GamepadAxis2D.RightStick, 0.1));
        Input.AddActionBinding("look", InputActionBinding(Scancode.Kp4, Scancode.Kp6, Scancode.Kp8, Scancode.Kp5));

        Input.RegisterAction("attack_1", InputActionType.ButtonTrigger);
        Input.AddActionBinding("attack_1", InputActionBinding(MouseButton.Left));
        Input.AddActionBinding("attack_1", InputActionBinding(GamepadButton.LeftShoulder));

        Input.RegisterAction("attack_2", InputActionType.ButtonTrigger);
        Input.AddActionBinding("attack_2", InputActionBinding(MouseButton.Left));
        Input.AddActionBinding("attack_2", InputActionBinding(GamepadButton.RightShoulder));

        Input.RegisterAction("attack_3", InputActionType.ButtonTrigger);
        Input.AddActionBinding("attack_3", InputActionBinding(MouseButton.Middle));
        Input.AddActionBinding("attack_3", InputActionBinding(GamepadAxis.LeftShoulderTrigger, 0.5));
        Input.AddActionBinding("attack_3", InputActionBinding(GamepadAxis.RightShoulderTrigger, 0.5));
    }

    void SwitchTo(Demo next) {
        // The demo that goes, with everything in its phase
        if (scene != null) {
            scene.Leave();
            scene = null;
            Runtime.WipeLevel();
        }
        if (start != null) {
            start.Leave();
            start = null;
            Runtime.WipeLevel();
        }
        if (physics != null) {
            physics = null;
            Runtime.WipeLevel();
        }
        if (navigation != null) {
            navigation = null;
            Runtime.WipeLevel();
        }
        if (audio != null) {
            audio.Leave();
            audio = null;
            Runtime.WipeLevel();
        }
        if (lighting != null) {
            lighting.Leave();
            lighting = null;
            Runtime.WipeLevel();
        }
        if (effects != null) {
            effects.Leave();
            effects = null;
            Runtime.WipeLevel();
        }
        if (legs != null) {
            legs.Leave();
            legs = null;
            Runtime.WipeLevel();
        }
        if (ui != null) {
            SaveSettings();
            ui = null;
            Runtime.WipeLevel();
        }
        demo = next;
        Draw.isCanvasFree = next != Demo.Start && next != Demo.Lighting && next != Demo.Ui && next != Demo.Scene && next != Demo.Effects && next != Demo.Legs;    // (the games' fixed canvas)
        if (next == Demo.Scene) {
            with level;
            scene = New[SceneDemo]();
        } else if (next == Demo.Start) {
            with level;
            start = New[StartDemo]();
            Draw.clearColor = Color.Black;
        } else if (next == Demo.Physics) {
            with level;
            physics = New[PhysicsDemo]();
            Draw.clearColor = Color.Grey(0.12);
        } else if (next == Demo.Navigation) {
            with level;
            navigation = New[NavDemo]();
            Draw.clearColor = Color.Grey(0.08);
        } else if (next == Demo.Audio) {
            with level;
            audio = New[AudioDemo]();
            Draw.clearColor = Color.Grey(0.1);
        } else if (next == Demo.Lighting) {
            with level;
            lighting = New[LightingDemo]();
            Draw.clearColor = Color.Black;
        } else if (next == Demo.Effects) {
            with level;
            effects = New[EffectsDemo]();
            Draw.clearColor = Color(0.13, 0.13, 0.16, 1);
        } else if (next == Demo.Legs) {
            with level;
            legs = New[LegsDemo]();
            Draw.clearColor = Color(0.13, 0.13, 0.16, 1);
        } else {
            with level;
            ui = New[UiDemo]();
            Draw.clearColor = Color(0.09, 0.07, 0.13, 1);
        }
    }

    void SaveSettings() {
        if (areSettingsChanged && Storage.Write("settings", settings)) {
            areSettingsChanged = false;
        }
    }

    void DoFrame() {
        if (Input.KeyPressed(Scancode.F9) && demo != Demo.Scene) {
            SwitchTo(Demo.Scene);
        } else if (Input.KeyPressed(Scancode.F3) && demo != Demo.Start) {
            SwitchTo(Demo.Start);
        }
        if (Input.KeyPressed(Scancode.F2) && demo != Demo.Physics) {
            SwitchTo(Demo.Physics);
        }
        if (Input.KeyPressed(Scancode.F4) && demo != Demo.Navigation) {
            SwitchTo(Demo.Navigation);
        }
        if (Input.KeyPressed(Scancode.F6) && demo != Demo.Audio) {
            SwitchTo(Demo.Audio);
        }
        if (Input.KeyPressed(Scancode.F7) && demo != Demo.Lighting) {
            SwitchTo(Demo.Lighting);
        }
        if (Input.KeyPressed(Scancode.F8) && demo != Demo.Ui) {
            SwitchTo(Demo.Ui);
        }
        if (Input.KeyPressed(Scancode.F10) && !Input.isShiftDown && demo != Demo.Effects) {
            SwitchTo(Demo.Effects);
        }
        if (Input.KeyPressed(Scancode.F10) && Input.isShiftDown && demo != Demo.Legs) {
            SwitchTo(Demo.Legs);
        }
        // (Escape: a text field's or a dialog's first)
        if (Input.KeyPressed(Scancode.Escape) && demo != Demo.Ui && !Ui.isTyping) {
            Window.Quit();                         // (in the UI demo Escape goes back; the scene editor's unsaved changes ask first: hope)
        }
        Draw.LogLine("F1 scene editor, F9 scene, F2 physics, F3 start, F4 navigation, F6 audio, F7 lighting, F8 UI, F10 effects, Shift+F10 legs; F12 performance and memory");
        {
            with level;
            if (demo == Demo.Scene) {
                scene.DoFrame();
            } else if (demo == Demo.Physics) {
                physics.DoFrame();
            } else if (demo == Demo.Navigation) {
                navigation.DoFrame();
            } else if (demo == Demo.Audio) {
                audio.DoFrame();
            } else if (demo == Demo.Lighting) {
                lighting.DoFrame();
            } else if (demo == Demo.Ui) {
                ui.DoFrame();
            } else if (demo == Demo.Effects) {
                effects.DoFrame();
            } else if (demo == Demo.Legs) {
                legs.DoFrame();
            } else {
                start.DoFrame();
            }
        }
        // Another scene picked in the scene demo: the demo made again with it
        if (scene != null && scene.requestedScene.len > 0) {
            SetSceneDemoName(scene.requestedScene);
            SwitchTo(Demo.Scene);
        }
        if (ui != null && ui.wantsToPlay) {
            SwitchTo(Demo.Start);                 // (after the demo's frame: it is wiped)
        }
    }
}


////////////////////////////////////////////////////////////////////////////////////////////////////
// hope_playground (formerly DungeonTracks, ported from the C# version), for trying out hope's
// features: F9 the scene demo (a scene as a game shows it; F1 in any demo: the scene editor), F3 the
// start demo (Sorcy runs in circles, Susi, a 3D sprite on tracks, drives with the "move" action),
// F2 the physics debug demo, F4 the navigation demo, F6 the audio demo, F7 lighting, F8 the UI.
//
// The game is a module (hope/game): a platform layer hosts it (the targets of hope.pgproj).


get Playground* playground() { return Runtime.State[Playground](); }

// (the first demo once the state is there: the demos reach it through 'playground')
void CreateGame() {
    playground.SwitchTo(Demo.Scene);
}

// (the internal mode) the scene editor closed: the scene demo's scene changed, it is made again
void OnSceneEdited(string scene) {
    if (playground.demo == Demo.Scene && scene == playground.sceneDemoName) {
        playground.SwitchTo(Demo.Scene);
    }
}
void DoFrame() { playground.DoFrame(); }
Game GameMain() {
    return Game(info: AppInfo("hope playground", "hope_playground", "0.01", 320, 180), state: TypeOf[Playground](), Create: CreateGame, DoFrame: DoFrame, RegisterEntities: RegisterEntityTypes, SceneEdited: OnSceneEdited, Tests: RegisterTests);
}
