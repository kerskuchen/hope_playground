// The playground's tests (hope's testing.pg), run headless by hope/tools/test_game.pgs:
//
//     ../hope/tools/test_game.pgs .                   (all of them)
//     ../hope/tools/test_game.pgs . --target=windows  (the Windows build under Wine)

void RegisterTests() {
    Test.Add("every demo starts", TestDemos);
    Test.Add("the editor over every demo", TestEditorInDemos, maxFrames: 2400);
    Test.Add("F5 in every demo", TestRestartInDemos);
    Test.Add("the phases stay as they are in every demo", TestSteadyMemory, maxFrames: 10800);
    Test.Add("E rams, and the ram ends", TestRam);
    Test.Add("Susi walks on six legs", TestLegs, maxFrames: 900);
    Test.Add("Susi stumbles and falls and gets up and dies", TestRagdoll, maxFrames: 900);
    Test.Add("Susi loses her legs", TestLooseLegs, maxFrames: 900);
    Test.Add("Susi leans", TestLean, maxFrames: 900);
}

// The legs demo's lean (tilted and stretched): running right, stopping, running down, running
// up (screenshots); the tilt's and the stretch's signs
void TestLean(TestRun* run) {
    let f = run.frame;
    if (f == 1) {
        run.Hold(Scancode.LShift);
        run.Press(Scancode.F10);
    }
    if (f == 2) {
        run.Release(Scancode.LShift);
    }
    if (f < 5) {
        return;
    }
    let demo = playground.legs;
    let rig = &demo.rig;
    if (f == 10) { run.Hold(Scancode.D); }
    if (f == 40) {
        run.Screenshot("running right");
        run.Check(rig.tilt > 2, "running right tilts her right ({rig.tilt:F1}°)");
        run.Release(Scancode.D);
        run.Hold(Scancode.A);
    }
    if (f == 70) { run.Release(Scancode.A); }
    if (f == 78) { run.Screenshot("stopping"); }
    if (f == 110) { run.Hold(Scancode.S); }
    if (f == 140) {
        run.Screenshot("running down");
        run.Check(rig.stretch > 1.03, "running down makes her taller ({rig.stretch:F3})");
        run.Release(Scancode.S);
    }
    if (f == 180) { run.Hold(Scancode.W); }
    if (f == 210) {
        run.Screenshot("running up");
        run.Check(rig.stretch < 0.97, "running up makes her shorter ({rig.stretch:F3})");
        run.Release(Scancode.W);
    }
    if (f == 240) {
        run.Pass();
    }
}

// The legs demo's loose legs: one torn off (she walks on five), all of them (she falls), they
// settle into the decal map, they grow back (she gets up); the looks, a leg off in each; every
// frame: the loose legs keep their lengths, above the ground
void TestLooseLegs(TestRun* run) {
    let f = run.frame;
    if (f == 1) {
        run.Hold(Scancode.LShift);
        run.Press(Scancode.F10);
    }
    if (f == 2) {
        run.Release(Scancode.LShift);
    }
    if (f < 5) {
        return;
    }
    let demo = playground.legs;
    let rig = &demo.rig;
    demo.loose.decayTime = 1;                     // (sooner into the decal map)
    for (let index, leg in demo.loose.legs) {
        let thigh = (leg.knee - leg.hip).Length();
        let shin = (leg.foot - leg.knee).Length();
        run.Check(Abs(thigh - leg.thigh) < 0.6 && Abs(shin - leg.shin) < 0.6, "loose leg {index}: segments {thigh:F2}, {shin:F2} at frame {f}");
        run.Check(leg.hip.z >= 0 && leg.knee.z >= 0 && leg.foot.z >= 0, "loose leg {index} below the ground at frame {f}");
    }
    let her = demo.xform.pos * 2;
    if (f == 10) { run.MoveMouse(her + Vec2(30, -30)); }
    if (f == 11) { run.Press(Scancode.X); }
    if (f == 13) {
        run.Check(rig.attachedCount == 5 && demo.loose.count == 1, "X tears one leg off ({rig.attachedCount} on, {demo.loose.count} loose)");
    }
    if (f == 30) { run.Screenshot("torn off"); }
    if (f == 40) { run.Hold(Scancode.D); }
    if (f == 100) { run.Screenshot("five legs walking"); run.Release(Scancode.D); }
    if (120 <= f && f < 150 && f % 5 == 0) { run.Press(Scancode.X); }
    if (f == 152) { run.Check(rig.attachedCount == 0 && rig.isLimp, "no legs left: she falls ({*rig})"); }
    if (f == 165) { run.Screenshot("no legs"); }
    if (f == 330) {
        run.Check(demo.loose.count == 0, "the loose legs went into the decal map ({demo.loose.count} left)");
        run.Screenshot("decals");
        run.Press(Scancode.R);
    }
    if (f == 400) { run.Check(rig.isStanding && rig.attachedCount == 6, "the legs grew back, she stands ({*rig})"); }
    for (let look in 1..4) {
        let at = 400 + look * 40;
        if (f == at) { run.Press(Scancode.Alpha3); run.MoveMouse(her + Vec2(0, 30)); }
        if (f == at + 2) { run.Press(Scancode.X); }
        if (f == at + 20) { run.Screenshot("look {look}"); }
    }
    if (f == 600) {
        run.Check(demo.look == 3 && rig.attachedCount == 3, "three looks, a leg off in each ({rig.attachedCount} on)");
        run.Pass();
    }
}

// The legs demo's ragdoll: a blast while she stands (a foot stumbles), knocked out (lying), a
// blast while limp, getting up, dead (asleep after a while), shoved dead, alive again;
// every frame: the limp segments keep their lengths, nothing below the ground, no NaN
void TestRagdoll(TestRun* run) {
    let f = run.frame;
    if (f == 1) {
        run.Hold(Scancode.LShift);
        run.Press(Scancode.F10);
    }
    if (f == 2) {
        run.Release(Scancode.LShift);
    }
    if (f < 5) {
        return;
    }
    let demo = playground.legs;
    let rig = &demo.rig;
    for (let index, leg in rig.legs[0..rig.legCount]) {
        if (leg.isDetached) {
            continue;                      // (a blast near her tears legs off: they are LooseLegs')
        }
        run.Check(leg.foot.x == leg.foot.x && leg.knee.x == leg.knee.x, "leg {index}: NaN at frame {f}");
        run.Check(leg.foot.z >= 0 && leg.knee.z >= 0, "leg {index} below the ground at frame {f}: knee {leg.knee}, foot {leg.foot}");
        if (rig.isLimp) {
            let thigh = (leg.knee - leg.hip).Length();
            let shin = (leg.foot - leg.knee).Length();
            run.Check(Abs(thigh - rig.setup.thigh) < 0.5 && Abs(shin - rig.setup.shin) < 1.0, "leg {index}'s limp segments {thigh:F2}, {shin:F2} at frame {f}");
        }
    }
    let her = demo.xform.pos * 2;                 // (the window: the canvas at 2x, the camera on it)
    if (f == 20) { run.MoveMouse(her + Vec2(-40, 10)); }
    if (f == 21) { run.Click(MouseButton.Left); }
    if (24 <= f && f <= 40 && !demo.ragdollStumbled) {
        for (let leg in rig.legs[0..rig.legCount]) {
            demo.ragdollStumbled = demo.ragdollStumbled || leg.isStumbling;
        }
    }
    if (f == 27) { run.Screenshot("stumble"); }
    if (f == 60) { run.Check(demo.ragdollStumbled, "a blast near her makes a foot stumble"); }
    if (f == 80) { run.Press(Scancode.U); }
    if (f == 120) {
        run.Check(rig.isLimp && rig.z < 0.5, "knocked out, she lies on the ground (z {rig.z:F2})");
        run.Screenshot("knocked out");
        run.MoveMouse(her + Vec2(30, -20));
    }
    if (f == 121) { run.Click(MouseButton.Left); }
    if (f == 130) { run.Screenshot("blasted limp"); }
    if (f == 236) { run.Screenshot("getting up"); }
    if (f == 300) { run.Check(rig.isStanding, "she got up ({*rig})"); run.Press(Scancode.K); }
    if (f == 420) { run.Screenshot("dead"); run.MoveMouse(her + Vec2(-16, 0)); }
    if (f == 421) { run.Click(MouseButton.Right); }
    if (f == 440) { run.Screenshot("dead shoved"); }
    if (f == 590) { run.Check(rig.sleepTime > 0.4, "dead and still, she sleeps ({*rig})"); run.Press(Scancode.K); }
    if (f == 605) { run.Screenshot("revived"); }
    if (f == 670) {
        run.Check(rig.isStanding, "alive again, she stands ({*rig})");
        run.Pass();
    }
}

// The legs demo: walking, turning, against a pillar, a shove, standing; every frame: no leg
// longer than its segments for long, planted feet where they were and not in a wall (the last
// feet: Playground.legsLastFeet)

void TestLegs(TestRun* run) {
    let f = run.frame;
    if (f == 1) {
        run.Hold(Scancode.LShift);
        run.Press(Scancode.F10);
    }
    if (f == 2) {
        run.Release(Scancode.LShift);
    }
    if (f < 5) {
        return;
    }
    let demo = playground.legs;
    run.Check(demo != null, "Shift+F10 shows the legs demo");
    if (demo == null) {
        return;
    }
    let rig = &demo.rig;
    for (let index, leg in rig.legs[0..rig.legCount]) {
        let length = (leg.foot - leg.hip).Length();
        playground.legsStretched[index] = length > rig.setup.thigh + rig.setup.shin + 0.5 ? playground.legsStretched[index] + 1 : 0;
        run.Check(playground.legsStretched[index] <= 4, "leg {index} stretched to {length:F1} for {playground.legsStretched[index]} frames (frame {f})");
        let isStretched = length >= rig.setup.thigh + rig.setup.shin - 0.1;
        if (f > 6 && leg.clock.state == FootState.Planted && !leg.hasLanded && !isStretched) {
            run.Check((leg.foot - playground.legsLastFeet[index]).Length() < 0.01, "planted foot {index} slid at frame {f}");
        }
        for (let box in demo.wallBoxes) {
            if (leg.clock.state != FootState.Planted) {
                break;                     // (in the air it may pass over a wall's end)
            }
            let p = leg.foot.xy;
            run.Check(!(box.min.x < p.x && p.x < box.max.x && box.min.y < p.y && p.y < box.max.y), "foot {index} ({leg.clock}) in a wall at frame {f}: {p}, from {leg.stepFrom} to {leg.stepTo}, body {demo.xform.pos}");
        }
        playground.legsLastFeet[index] = leg.foot;
    }
    // to the right (walking: Shift), then running, up into the wall, left into the pillar, a shove
    if (f == 10) { run.Hold(Scancode.LShift); run.Hold(Scancode.D); }
    if (f == 60) { run.Screenshot("walk"); }
    if (f == 100) { run.Release(Scancode.LShift); }
    if (f == 130) { run.Screenshot("run"); }
    if (f == 150) { run.Release(Scancode.D); run.Hold(Scancode.W); }
    if (f == 165) { run.Screenshot("turning"); }
    if (f == 185) { run.Release(Scancode.W); run.Hold(Scancode.A); }
    if (f == 330) { run.Screenshot("at the pillar"); }
    if (f == 345) { run.Release(Scancode.A); run.Press(Scancode.G); }
    if (f == 420) { run.Screenshot("stood still"); run.Press(Scancode.Alpha1); }
    if (f == 440) { run.Hold(Scancode.S); }
    if (f == 480) { run.Screenshot("dog knees"); run.Release(Scancode.S); }
    // every landing where its foot is (it may have lifted again in the same frame, running: still
    // there; the footprints: ForEachLanding)
    rig.ForEachLanding((FootLanding landing) => {
        let leg = &rig.legs[landing.leg];
        run.Check((leg.foot.xy - landing.pos).Length() < 0.01, "landing {landing.leg} where its foot is ({leg.foot.xy}, {landing.pos})");
    });
    if (f == 560) {
        run.Check(demo.footprints > 40, "the steps left footprints ({demo.footprints})");
        run.Check(rig.stillTime > 0.3, "she stands still at the end");
        run.Pass();
    }
}

// (the physics demo's StateClock: Driving, Ramming for PHYSICS_RAM_TIME or to what stops it)
void TestRam(TestRun* run) {
    if (run.frame == 1) {
        run.Press(Scancode.F2);
    }
    if (run.frame == 10) {
        run.Check(playground.physics != null && playground.physics.move.state == PlayerMove.Driving, "the physics demo drives");
        run.Press(Scancode.E);
    }
    if (run.frame == 11) {
        let move = &playground.physics.move;
        run.Check(move.state == PlayerMove.Ramming || move.previous == PlayerMove.Ramming, "E rams ({*move})");
    }
    if (run.frame == 40) {
        let move = &playground.physics.move;
        run.Check(move.state == PlayerMove.Driving && move.previous == PlayerMove.Ramming, "the ram ended ({*move})");
        run.Pass();
    }
}

// The demos and their keys, in an order that goes from each one to each other kind
const [Demo, 9] testDemos = [Demo.Scene, Demo.Physics, Demo.Start, Demo.Navigation, Demo.Audio, Demo.Lighting, Demo.Ui, Demo.Effects, Demo.Legs];
const [Scancode, 9] testDemoKeys = [Scancode.F9, Scancode.F2, Scancode.F3, Scancode.F4, Scancode.F6, Scancode.F7, Scancode.F8, Scancode.F10, Scancode.F10];    // (the legs: with Shift, PressDemo)

// The key of demo 'index' (the legs demo's with Shift)
void PressDemo(TestRun* run, int index) {
    run.Press(testDemoKeys[index]);
    if (testDemos[index] == Demo.Legs) {
        run.Press(Scancode.LShift);
    }
}

// (every 'period' frames the next demo: its key pressed at the period's start; the demo at 'at')
int DemoAt(TestRun* run, int period) { return (run.frame / period) % testDemos.len; }

void TestDemos(TestRun* run) {
    let period = 30;
    let index = run.frame / period;
    if (index >= testDemos.len) {
        run.Pass();
        return;
    }
    if (run.frame % period == 1) {
        PressDemo(run, index);
    }
    if (run.frame % period == period - 1) {
        run.Check(playground.demo == testDemos[index], "{testDemoKeys[index]} shows the demo {testDemos[index]} ({playground.demo})");
    }
}

void TestEditorInDemos(TestRun* run) {
    if (!INTERNAL) {
        run.Pass();
        return;
    }
    let period = 60;
    let index = run.frame / period;
    if (index >= testDemos.len * 2) {
        run.Pass();
        return;
    }
    let demo = index % testDemos.len;
    let step = run.frame % period;
    if (step == 1) {
        PressDemo(run, demo);
    }
    if (step == 20) {
        run.Press(Scancode.F1);
    }
    if (step == 30) {
        run.Check(Editor.isOpen, "F1 opens the editor over {testDemos[demo]}");
        run.Press(Scancode.F1);
    }
    if (step == 40) {
        run.Check(!Editor.isOpen, "F1 closes it again");
        run.Check(playground.demo == testDemos[demo], "the demo is still {testDemos[demo]}");
    }
}

void TestRestartInDemos(TestRun* run) {
    if (!INTERNAL) {
        run.Pass();
        return;
    }
    let period = 40;
    let index = run.frame / period;
    if (index >= testDemos.len) {
        run.Pass();
        return;
    }
    let step = run.frame % period;
    if (step == 1) {
        PressDemo(run, index);
    }
    if (step == 15) {
        run.Press(Scancode.F5);
    }
    if (step == 30) {
        run.Check(playground != null, "the game started again in {testDemos[index]}");
    }
}

// Each demo for 18 s: after 12 s of warming up (the scene demo's spawner fills up to its ghosts'
// cap meanwhile), its phases do not keep growing: measured in two windows of 3 s, growth in both
// is a leak (the ones found 2026-11-14 and 11-16 grew a few KiB every frame); in one only is the
// demo doing something once
// (measured: Playground.testLevelUsed, testPersistentUsed)

void TestSteadyMemory(TestRun* run) {
    let period = 1080;
    let index = run.frame / period;
    if (index >= testDemos.len) {
        run.Pass();
        return;
    }
    let step = run.frame % period;
    if (step == 1) {
        PressDemo(run, index);
    }
    for (let point in 0..3) {
        if (step == 720 + point * 179) {
            playground.testLevelUsed[point] = (long)Memory.level.used;
            playground.testPersistentUsed[point] = (long)Memory.persistent.used;
        }
    }
    if (step == 720 + 2 * 179) {
        let growth = Min(playground.testLevelUsed[1] - playground.testLevelUsed[0], playground.testLevelUsed[2] - playground.testLevelUsed[1]);
        let persistent = Min(playground.testPersistentUsed[1] - playground.testPersistentUsed[0], playground.testPersistentUsed[2] - playground.testPersistentUsed[1]);
        run.Check(growth <= 0, "the level phase kept growing in {testDemos[index]}: {(playground.testLevelUsed[2] - playground.testLevelUsed[0]) / 1024} KiB in 6 s");
        run.Check(persistent <= 0, "the persistent phase kept growing in {testDemos[index]}: {(playground.testPersistentUsed[2] - playground.testPersistentUsed[0]) / 1024} KiB in 6 s");
    }
}
