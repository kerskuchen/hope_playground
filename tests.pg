// The playground's tests (hope's testing.pg), run headless by hope/tools/test_game.pgs:
//
//     ../hope/tools/test_game.pgs .                   (all of them)
//     ../hope/tools/test_game.pgs . --target=windows  (the Windows build under Wine)

void RegisterTests() {
    Test.Add("every scene starts", TestScenes);
    Test.Add("the editor over every scene", TestEditorInScenes, maxFrames: 2400);
    Test.Add("F5 in every scene", TestRestartInScenes);
    Test.Add("the phases stay as they are in every scene", TestSteadyMemory, maxFrames: 10800);
    Test.Add("E rams, and the ram ends", TestRam);
    Test.Add("Susi walks on six legs", TestLegs, maxFrames: 900);
}

// The legs scene: walking, turning, against a pillar, a shove, standing; every frame: no leg
// longer than its segments for long, planted feet where they were and not in a wall
[Vec3, 8] legsLastFeet;
[int, 8] legsStretched;          // (frames in a row: held back by a wall, it steps soon)

void TestLegs(TestRun* run) {
    let f = run.frame;
    if (f == 1) {
        run.Hold(Scancode.LShift);
        run.Press(Scancode.F10);
    }
    if (f == 2) {
        run.Release(Scancode.LShift);
    }
    if (f < 5) {
        return;
    }
    let scene = playground.legs;
    run.Check(scene != null, "Shift+F10 shows the legs scene");
    if (scene == null) {
        return;
    }
    let rig = &scene.rig;
    for (let index, leg in rig.legs[0..rig.legCount]) {
        let length = (leg.foot - leg.hip).Length();
        legsStretched[index] = length > rig.setup.thigh + rig.setup.shin + 0.5 ? legsStretched[index] + 1 : 0;
        run.Check(legsStretched[index] <= 4, "leg {index} stretched to {length:F1} for {legsStretched[index]} frames (frame {f})");
        let isStretched = length >= rig.setup.thigh + rig.setup.shin - 0.1;
        if (f > 6 && leg.clock.state == FootState.Planted && !leg.hasLanded && !isStretched) {
            run.Check((leg.foot - legsLastFeet[index]).Length() < 0.01, "planted foot {index} slid at frame {f}");
        }
        for (let box in scene.wallBoxes) {
            if (leg.clock.state != FootState.Planted) {
                break;                     // (in the air it may pass over a wall's end)
            }
            let p = leg.foot.xy;
            run.Check(!(box.min.x < p.x && p.x < box.max.x && box.min.y < p.y && p.y < box.max.y), "foot {index} ({leg.clock}) in a wall at frame {f}: {p}, from {leg.stepFrom} to {leg.stepTo}, body {scene.xform.pos}");
        }
        legsLastFeet[index] = leg.foot;
    }
    // to the right (walking: Shift), then running, up into the wall, left into the pillar, a shove
    if (f == 10) { run.Hold(Scancode.LShift); run.Hold(Scancode.D); }
    if (f == 60) { run.Screenshot("walk"); }
    if (f == 100) { run.Release(Scancode.LShift); }
    if (f == 130) { run.Screenshot("run"); }
    if (f == 150) { run.Release(Scancode.D); run.Hold(Scancode.W); }
    if (f == 165) { run.Screenshot("turning"); }
    if (f == 185) { run.Release(Scancode.W); run.Hold(Scancode.A); }
    if (f == 330) { run.Screenshot("at the pillar"); }
    if (f == 345) { run.Release(Scancode.A); run.Press(Scancode.G); }
    if (f == 420) { run.Screenshot("stood still"); run.Press(Scancode.Alpha1); }
    if (f == 440) { run.Hold(Scancode.S); }
    if (f == 480) { run.Screenshot("dog knees"); run.Release(Scancode.S); }
    if (f == 560) {
        run.Check(rig.stillTime > 0.3, "she stands still at the end");
        run.Pass();
    }
}

// (the physics scene's StateClock: Driving, Ramming for PHYSICS_RAM_TIME or to what stops it)
void TestRam(TestRun* run) {
    if (run.frame == 1) {
        run.Press(Scancode.F2);
    }
    if (run.frame == 10) {
        run.Check(playground.physics != null && playground.physics.move.state == PlayerMove.Driving, "the physics scene drives");
        run.Press(Scancode.E);
    }
    if (run.frame == 11) {
        let move = &playground.physics.move;
        run.Check(move.state == PlayerMove.Ramming || move.previous == PlayerMove.Ramming, "E rams ({*move})");
    }
    if (run.frame == 40) {
        let move = &playground.physics.move;
        run.Check(move.state == PlayerMove.Driving && move.previous == PlayerMove.Ramming, "the ram ended ({*move})");
        run.Pass();
    }
}

// The scenes and their keys, in an order that goes from each one to each other kind
[Scene, 9] testScenes = [Scene.Level, Scene.Physics, Scene.Start, Scene.Navigation, Scene.Audio, Scene.Lighting, Scene.Ui, Scene.Effects, Scene.Legs];
[Scancode, 9] testSceneKeys = [Scancode.F9, Scancode.F2, Scancode.F3, Scancode.F4, Scancode.F6, Scancode.F7, Scancode.F8, Scancode.F10, Scancode.F10];    // (the legs: with Shift, PressScene)

// The key of scene 'index' (the legs scene's with Shift)
void PressScene(TestRun* run, int index) {
    run.Press(testSceneKeys[index]);
    if (testScenes[index] == Scene.Legs) {
        run.Press(Scancode.LShift);
    }
}

// (every 'period' frames the next scene: its key pressed at the period's start; the scene at 'at')
int SceneAt(TestRun* run, int period) { return (run.frame / period) % testScenes.len; }

void TestScenes(TestRun* run) {
    let period = 30;
    let index = run.frame / period;
    if (index >= testScenes.len) {
        run.Pass();
        return;
    }
    if (run.frame % period == 1) {
        PressScene(run, index);
    }
    if (run.frame % period == period - 1) {
        run.Check(playground.scene == testScenes[index], "{testSceneKeys[index]} shows the scene {testScenes[index]} ({playground.scene})");
    }
}

void TestEditorInScenes(TestRun* run) {
    if (!INTERNAL) {
        run.Pass();
        return;
    }
    let period = 60;
    let index = run.frame / period;
    if (index >= testScenes.len * 2) {
        run.Pass();
        return;
    }
    let scene = index % testScenes.len;
    let step = run.frame % period;
    if (step == 1) {
        PressScene(run, scene);
    }
    if (step == 20) {
        run.Press(Scancode.F1);
    }
    if (step == 30) {
        run.Check(Editor.isOpen, "F1 opens the editor over {testScenes[scene]}");
        run.Press(Scancode.F1);
    }
    if (step == 40) {
        run.Check(!Editor.isOpen, "F1 closes it again");
        run.Check(playground.scene == testScenes[scene], "the scene is still {testScenes[scene]}");
    }
}

void TestRestartInScenes(TestRun* run) {
    if (!INTERNAL) {
        run.Pass();
        return;
    }
    let period = 40;
    let index = run.frame / period;
    if (index >= testScenes.len) {
        run.Pass();
        return;
    }
    let step = run.frame % period;
    if (step == 1) {
        PressScene(run, index);
    }
    if (step == 15) {
        run.Press(Scancode.F5);
    }
    if (step == 30) {
        run.Check(playground != null, "the game started again in {testScenes[index]}");
    }
}

// Each scene for 18 s: after 12 s of warming up (the level scene's spawner fills up to its ghosts'
// cap meanwhile), its phases do not keep growing: measured in two windows of 3 s, growth in both
// is a leak (the ones found 2026-11-14 and 11-16 grew a few KiB every frame); in one only is the
// scene doing something once
[long, 3] testLevelUsed;
[long, 3] testPersistentUsed;

void TestSteadyMemory(TestRun* run) {
    let period = 1080;
    let index = run.frame / period;
    if (index >= testScenes.len) {
        run.Pass();
        return;
    }
    let step = run.frame % period;
    if (step == 1) {
        PressScene(run, index);
    }
    for (let point in 0..3) {
        if (step == 720 + point * 179) {
            testLevelUsed[point] = (long)Memory.level.used;
            testPersistentUsed[point] = (long)Memory.persistent.used;
        }
    }
    if (step == 720 + 2 * 179) {
        let level = Min(testLevelUsed[1] - testLevelUsed[0], testLevelUsed[2] - testLevelUsed[1]);
        let persistent = Min(testPersistentUsed[1] - testPersistentUsed[0], testPersistentUsed[2] - testPersistentUsed[1]);
        run.Check(level <= 0, "the level phase kept growing in {testScenes[index]}: {(testLevelUsed[2] - testLevelUsed[0]) / 1024} KiB in 6 s");
        run.Check(persistent <= 0, "the persistent phase kept growing in {testScenes[index]}: {(testPersistentUsed[2] - testPersistentUsed[0]) / 1024} KiB in 6 s");
    }
}
