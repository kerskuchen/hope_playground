// The tilemap editor (F3, in the editor phase): ground layers (TilemapLayer: random ground tiles,
// random details on top from a trimmed tileset) and walls (AutotileMap: left mouse button
// sets their cells, right removes them; the drawn tiles follow). Between them a Decalmap: space
// paints a scorch mark at the cursor (decal_scorch.qoi), T drags tire tracks (decal_tiretrack.qoi),
// F scatters 500 scorches, C clears.

struct GameEditor {
    TilemapLayer ground;           // random ground tiles (R: again)
    TilemapLayer details;          // on top: random details on some cells (a trimmed tileset)
    AutotileMap walls;
    Decalmap decals;               // above the ground, below the walls (chunks of 128 px: 2 x 2, their seams show it works)
    Sprite* scorch;                // 24 x 24
    Sprite* tireTrack;             // a step of both wheels: 3 x 11, along x
    Vec2 lastTrack;                // T: where the last tire track was painted
    bool showsCells;               // D: the walls' solid cells
    Random random;
}

extend GameEditor {
    init() {
        random = Random(1);
        ground = TilemapLayer(Tileset(Draw.GetSprite("tiles_ground"), Vec2i(16, 16)), 16, 16, depth: 1);
        details = TilemapLayer(Tileset(Draw.GetSprite("tiles_ground_details"), Vec2i(16, 16)), 16, 16, depth: 2);
        RandomizeGround();
        walls = AutotileMap(AutotileTileset(Draw.GetSprite("tileset_test")), 16, 16, depth: 10);
        // A room (with a Grid helper, then Refresh) and a few single cells (Set refreshes)
        walls.DrawRect(Recti(2, 2, 9, 7), false, true);
        walls.Set(6, 2, false);                    // a door
        walls.Refresh();
        walls.Set(13, 4, true);
        walls.Set(13, 5, true);
        walls.Set(14, 5, true);
        walls.Set(12, 11, true);
        walls.Set(13, 12, true);                   // only touching diagonally
        decals = Decalmap(16 * 16, 16 * 16, depth: 3, chunkSize: 128);
        scorch = Draw.GetSprite("decal_scorch");
        tireTrack = Draw.GetSprite("decal_tiretrack");
    }

    void PaintScorch(Vec2 at) {
        let scale = random.Range(0.7, 1.4);
        // (the sprite's pivot is its left top: turned and scaled around the middle)
        let angle = random.Range(0.0, 360.0);
        let radians = angle * DegToRad;
        let half = 12 * scale;
        let middle = Vec2(Cos(radians) * half - Sin(radians) * half, Sin(radians) * half + Cos(radians) * half);
        decals.Add(scorch, Transform(at - middle, angle, Vec2(scale, scale)), DrawParams(color: Color(1, 1, 1, random.Range(0.6, 1.0))));
    }

    // Leaving the editor (its phase is wiped): the decal map's atlas regions back
    void Leave() { decals.Free(); }

    void RandomizeGround() {
        for (let y in 0..ground.h) {
            for (let x in 0..ground.w) {
                ground.Set(x, y, (byte)random.Range(0, ground.tileset.count));
                details.Set(x, y, random.Chance(0.4) ? (byte)random.Range(0, details.tileset.count) : TILE_EMPTY);
            }
        }
    }

    void DoFrame() {
        Camera.isCentered = false;
        Camera.rotation = 0;
        Camera.allowPanning = true;                // middle mouse button
        Camera.allowZooming = true;                // wheel
        Draw.LogLine("tilemap editor (F3): left/right mouse set/remove walls, R new ground, D show cells (", showsCells, "), middle mouse pan, wheel zoom (", Camera.zoom, ")");
        Draw.LogLine("decals: space scorch, T drag tire tracks, F 500 scorches, C clear (waiting ", decals.pendingCount, ")");
        if (Input.KeyPressed(Scancode.R))
            RandomizeGround();
        if (Input.KeyPressed(Scancode.D))
            showsCells = !showsCells;
        let cursor = Input.cursors.world;
        if (Input.KeyPressed(Scancode.Space))
            PaintScorch(cursor);
        if (Input.KeyPressed(Scancode.F)) {
            for (let i in 0..500) {
                PaintScorch(Vec2(random.Range(0.0, 256.0), random.Range(0.0, 256.0)));
            }
        }
        // Tire tracks: a step of both wheels every 3 px, turned along the way the cursor moves
        if (Input.KeyPressed(Scancode.T))
            lastTrack = cursor;
        if (Input.KeyDown(Scancode.T) && (cursor - lastTrack).Length() >= 3) {
            let along = (cursor - lastTrack).Normalized();
            let side = Vec2(-along.y, along.x);
            let angle = Atan2(along.y, along.x) / DegToRad;
            decals.Add(tireTrack, Transform(cursor - side * 5, angle));
            lastTrack = cursor;
        }
        if (Input.KeyPressed(Scancode.C)) {
            decals.Free();
            decals = Decalmap(16 * 16, 16 * 16, depth: 3, chunkSize: 128);   // (takes the freed chunks again)
        }
        let cell = walls.WorldToCell(Input.cursors.world, walls.tileSize, walls.origin);
        if (Input.MouseDown(MouseButton.Left))
            walls.Set(cell, true);
        if (Input.MouseDown(MouseButton.Right))
            walls.Set(cell, false);
        ground.Draw(Camera.viewportRect);
        details.Draw(Camera.viewportRect);
        decals.Draw(Camera.viewportRect);
        walls.Draw(Camera.viewportRect);
        if (showsCells) {
            for (let y in 0..walls.h) {
                for (let x in 0..walls.w) {
                    if (walls.Get(x, y))
                        Draw.Rect(walls.CellToWorldRect(Vec2i(x, y), walls.tileSize, walls.origin), 11, Color(1, 0, 0, 0.35));
                }
            }
        }
    }
}
