////////////////////////////////////////////////////////////////////////////////////////////////////
// The legs demo (Shift+F10): Susi on six legs (hope's legs.pg). WASD (or the stick) walks her:
// she turns towards where she goes while she walks, and in place first if it is behind her; Q and
// E turn her in place; Shift walks slowly (faster runs: the groups step together); the right
// mouse button shoves her away from the cursor, the left one sets off a blast there (she stumbles;
// limp, her legs fly). K: dead or alive again (she gets up), U: knocked out for
// 2.5 s. X tears off the leg nearest to the cursor (a blast tears off those whose knees are near
// it); the loose legs tumble, settle and go into the decal map after a while; R: all legs back.
// 1: the knees out (a spider) or back (a dog), 2: two, three or four pairs, 3: the look (lines,
// recoloured, sprites, the demo's own function), 5: footstep sounds on or off (every landing
// also leaves a footprint in the decal map), G: the rest positions, the steps' targets and
// the hips.
//
// The setup is made again every frame (LegsSetup): change a number, save, and she walks on with it.

LegSetup LegsSetup(KneeBend bend, int pairs, int look) {
    return LegSetup(pairs: pairs, bend: bend, look: LegsLook(look));
}

// The looks (3): the default lines, recoloured (rust), sprites (the untextured pixel stretched:
// a stand-in for art), bone white with red claws
LegLook LegsLook(int index) {
    if (index == 1) {
        return LegLook(thighColor: Color(0.55, 0.3, 0.18, 1), shinColor: Color(0.4, 0.2, 0.12, 1), jointColor: Color(0.8, 0.55, 0.3, 1), footColor: Color(0.2, 0.1, 0.05, 1));
    }
    if (index == 2) {
        let pixel = Draw.GetSprite("untextured");
        return LegLook(thighSprite: pixel, shinSprite: pixel, spriteTint: Color(0.5, 0.75, 0.6, 1));
    }
    if (index == 3) {
        let bone = Color(0.85, 0.82, 0.75, 1);
        return LegLook(thighColor: bone, shinColor: bone, jointColor: bone, footColor: Color(0.8, 0.15, 0.15, 1), clawLength: 2);
    }
    return LegLook();
}

enum SusiLife { Alive, KnockedOut, Dead }

struct LegsDemo {
    AnimationPlayer bodyAnim;          // (Susi's first frame: no tracks running)
    Transform xform = Transform(Vec2(160, 110), 0);
    Vec2 velocity;                     // her own (walking)
    Vec2 push;                         // from outside (a shove), dying down
    LegRig rig;
    KneeBend bend;
    int pairs = 3;
    int look;
    bool showsDebug;
    CollisionWorld* walls;             // the arena's border and two pillars
    [Box, 6] wallBoxes;
    StateClock[SusiLife] life;
    float spin;                        // degrees a second (limp: blasts turn her)
    Shockwaves waves;
    ParticleSystem blast;
    Decalmap decals;
    LooseLegs loose;
    bool footsteps = true;             // (5: a sound for every footstep)
    Random rng = Random(7);            // (the footsteps' pitch)
    int footprints;                    // (the tests': landings so far)
    bool ragdollStumbled;              // (the test's: a foot stumbled)
}

extend LegsDemo {
    init() {
        bodyAnim = AnimationPlayer(Draw.GetAnim("susi.run"));
        Camera.pos = Vec2(160, 90);
        Camera.isCentered = true;
        wallBoxes[0] = Box(Vec2(0, 30), Vec2(320, 34));
        wallBoxes[1] = Box(Vec2(0, 176), Vec2(320, 180));
        wallBoxes[2] = Box(Vec2(0, 30), Vec2(4, 180));
        wallBoxes[3] = Box(Vec2(316, 30), Vec2(320, 180));
        wallBoxes[4] = Box(Vec2(80, 70), Vec2(100, 120));
        wallBoxes[5] = Box(Vec2(220, 60), Vec2(260, 72));
        walls = New[CollisionWorld](Box(Vec2(0, 0), Vec2(320, 180)), 32);
        for (let box in wallBoxes) {
            walls.Add(Collider(ColliderShape.Box(box: *box), 1, 0));
        }
        rig = LegRig(LegsSetup(bend, pairs, look), BodyDim(), walls, 1, &waves);
        decals = Decalmap(320, 180, depth: 2);
        loose = LooseLegs(walls: walls, wallMask: 1, waves: &waves, decals: &decals);
        let glow = Draw.GetSprite("light_torch");
        blast = ParticleSystem(ParticleProps(sprite: glow, lifetime: Between(0.3, 0.6), spread: 180, elevation: Between(0, 50), startSpeed: Between(60, 130), endSpeed: 0,
            speedCurve: Curve.EaseOut(3), startSize: Between(0.06, 0.1), endSize: 0.02, startOpacity: 1, endOpacity: 0, opacityCurve: Curve.EaseIn(),
            startColor: ColorBetween(Color(1, 0.9, 0.5, 1), Color(1, 0.6, 0.2, 1)), endColor: Color(0.95, 0.35, 0.05, 1), startAdditivity: 1, endAdditivity: 1,
            gravity: 60, waveResponse: 0, glow: 1), capacity: 200);
    }

    // Susi's footprint: her sprite's trimmed size (x: along her forward)
    Vec2 BodyDim() {
        let stack = bodyAnim.CurSprite3D();
        let layer = stack.layers[stack.layers.len / 2];
        return Vec2(layer.trimmedRect.w, layer.trimmedRect.h);
    }

    void DoFrame() {
        let dt = Input.deltaTime;
        if (Input.KeyPressed(Scancode.Alpha1)) {
            bend = bend == KneeBend.Out ? KneeBend.Back : KneeBend.Out;
        }
        if (Input.KeyPressed(Scancode.Alpha2)) {
            pairs = pairs == 3 ? 4 : pairs == 4 ? 2 : 3;
        }
        if (Input.KeyPressed(Scancode.Alpha3)) {
            look = (look + 1) % 4;
        }
        if (Input.KeyPressed(Scancode.Alpha5)) {
            footsteps = !footsteps;
        }
        if (Input.KeyPressed(Scancode.G)) {
            showsDebug = !showsDebug;
        }
        rig.setup = LegsSetup(bend, pairs, look);
        waves.Update();

        // Alive, knocked out (up again after 2.5 s), dead
        life.Step();
        if (Input.KeyPressed(Scancode.K)) {
            if (life.state == SusiLife.Dead) {
                life.Go(SusiLife.Alive);
                rig.GetUp();
            } else {
                life.Go(SusiLife.Dead);
                rig.GoLimp();
            }
        }
        if (Input.KeyPressed(Scancode.U) && life.state == SusiLife.Alive) {
            life.Go(SusiLife.KnockedOut);
            rig.GoLimp();
        }
        if (life.state == SusiLife.KnockedOut && life.time > 2.5) {
            life.Go(SusiLife.Alive);
            rig.GetUp();
        }
        if (life.state == SusiLife.Alive && rig.isLimp && rig.attachedCount > 0) {
            rig.GetUp();                   // (she fell with no legs left; they grew back)
        }
        // A blast at the cursor (the left button): its fire, the wave (her legs feel it themselves)
        if (Input.MousePressed(MouseButton.Left)) {
            let center = Input.cursors.world;
            blast.Emit(Vec3(center, 3), 40);
            waves.Add(Shockwave(center: center, kick: 150));
            for (let index, leg in rig.legs[0..rig.legCount]) {
                if (!leg.isDetached && (leg.knee.xy - center).Length() < 14) {
                    let away = (leg.knee.xy - center).NormalizedOr(Vec2(1, 0));
                    rig.Detach(index, &loose, Vec3(away * 140, 90));
                }
            }
        }
        // X: the leg nearest to the cursor torn off (away from the body); R: all back
        if (Input.KeyPressed(Scancode.X)) {
            let index = rig.NearestLeg(Input.cursors.world);
            if (index >= 0) {
                let away = (rig.legs[index].foot.xy - xform.pos).NormalizedOr(Vec2(1, 0));
                rig.Detach(index, &loose, Vec3(away * 100, 70));
            }
        }
        if (Input.KeyPressed(Scancode.R)) {
            rig.RegrowLegs();
        }

        // Walking: towards the stick, turning that way at 240°/s; what is behind her she turns to
        // (nearly) in place first; Q/E turn in place
        let move = Input.ActionValue2D("move");
        let maxSpeed = Input.isShiftDown ? 25.0 : 75.0;
        let wanted = Vec2(0, 0);
        let canWalk = rig.isStanding;
        if (move.Length() > 0.1 && canWalk) {
            let turn = NormalizeAngle(move.Angle() - xform.angle);
            xform.angle += Clamp(turn, -240 * dt, 240 * dt);
            let facing = Clamp(Cos(turn * DegToRad), 0.15, 1.0);
            wanted = move * maxSpeed * facing;
        }
        if (Input.KeyDown(Scancode.Q) && canWalk) {
            xform.angle -= 120 * dt;
        }
        if (Input.KeyDown(Scancode.E) && canWalk) {
            xform.angle += 120 * dt;
        }
        // (the blasts push her body; limp, they turn it too, and it slides on: less grip)
        let blastPush = waves.Kick(xform.pos);
        push += blastPush;
        if (rig.isLimp) {
            spin += Vec2.Cross(Vec2.FromAngle(xform.angle), blastPush) * 1.5;
        }
        xform.angle += spin * dt;
        spin *= Max(0.0, 1 - 3 * dt);
        xform.angle = NormalizeAngle(xform.angle);
        let change = wanted - velocity;
        let maxChange = 220 * dt;
        velocity += change.Length() > maxChange ? change.Normalized() * maxChange : change;
        // A shove (the right mouse button): away from the cursor
        if (Input.MousePressed(MouseButton.Right)) {
            push += (xform.pos - Input.cursors.world).NormalizedOr(Vec2(1, 0)) * 160;
        }
        push = push * Max(0.0, 1 - (rig.isLimp ? 2.5 : 4.0) * dt);
        if (push.Length() < 2) {
            push = Vec2(0, 0);             // (it stops: the ground holds it)
        }
        MoveBody((velocity + push) * dt);

        rig.Update(xform);
        // Footsteps: a footprint where each foot landed (darker for a stumble), a sound (5: its
        // pitch varied a little; louder running, and for a stumble)
        let pixel = Draw.GetSprite("untextured");
        rig.ForEachLanding((FootLanding landing) => {
            let print = landing.wasStumble ? Color(0.02, 0.02, 0.03, 1) : Color(0.06, 0.06, 0.08, 0.85);
            decals.Add(pixel, Transform(landing.pos.PixelSnapped(), 0, Vec2(1, 1) / pixel.dim), DrawParams(color: print));
            footprints++;
            if (footsteps && footprints % 3 == 0) {
                let volume = landing.wasStumble ? 0.02 : landing.isRunning ? 0.01 : 0.005;
                Audio.Play("sfx_sounds_impact4", AudioTrack.Sound, volume: volume, playbackSpeed: rng.Range(0.95, 1.05));
            }
        });
        loose.Update();

        // Drawing: the floor, the walls, her shadow, the far legs, her body (raised, leaning),
        // the near legs
        DrawGround();
        decals.Draw(Camera.viewportRect);
        loose.Draw((float y) => DepthAt(y));
        for (let box in wallBoxes) {
            Draw.Rect(Rect(box.min, box.max - box.min), DepthAt(box.max.y), DrawParams(color: Color(0.3, 0.28, 0.34, 1)));
        }
        let depth = DepthAt(xform.pos.y);
        rig.DrawShadow(depth - 0.05);
        rig.DrawLegs(depth, false);
        let bodyXform = Transform(xform.pos + rig.bodyOffset, xform.angle);
        Draw.Sprite3D(bodyAnim.CurSprite3D(), bodyXform, depth, tilt: rig.tilt, stretch: rig.stretch);
        rig.DrawLegs(depth, true);
        if (showsDebug) {
            rig.DrawDebug(Depth.Nearest - 1);
        }
        blast.Update();
        blast.Draw(Depth.Nearest - 2);
        if (playground.settings.showsHints) {
            Draw.LogLine("legs demo (Shift+F10): WASD walks (Shift slowly), Q/E turn, right click shoves, left click blasts; K dead/alive, U knocked out; X tears a leg off, R regrows");
            Draw.LogLine("1 knees {bend}, 2 pairs {pairs}, 3 look {look}, 5 footsteps {footsteps}, G debug; {loose.count} loose legs, decals waiting {decals.pendingCount}");
            Draw.LogLine("{rig}");
        }
    }

    // The demo goes: the decal map's atlas regions back
    void Leave() {
        decals.ReleaseSprites();
    }

    // Her body (a circle) through the walls: slides along what it hits
    void MoveBody(Vec2 motion) {
        let radius = rig.bodyDim.y * 0.5 + 1;
        for (let attempt in 0..2) {
            if (motion.isEffectivelyZero) {
                return;
            }
            let hit = walls.CircleCast(Circle(xform.pos, radius), motion, 1);
            if (!hit.hasIntersection) {
                xform.pos += motion;
                return;
            }
            let t = Max(hit.tEnter, 0.0);
            xform.pos += motion * t + hit.normalEnter * 0.05;
            let rest = motion * (1 - t);
            motion = rest - hit.normalEnter * Vec2.Dot(rest, hit.normalEnter);    // (along the wall)
            velocity -= hit.normalEnter * Min(Vec2.Dot(velocity, hit.normalEnter), 0.0);
            push -= hit.normalEnter * Min(Vec2.Dot(push, hit.normalEnter), 0.0);
        }
    }

    // (y on the ground as the depth: nearer the bottom, nearer the viewer)
    static float DepthAt(float y) { return 10 + y * 0.1; }

    void DrawGround() {
        let dots = DrawParams(color: Color(0.22, 0.22, 0.26, 1));
        for (let y = 42; y < 180; y += 12) {
            for (let x = 8; x < 320; x += 12) {
                Draw.Pixel(Vec2(x, y), 1, dots);
            }
        }
    }
}
