// The physics debug scene (F2, in the level phase): hope's CollisionWorld to play with. A free canvas
// (the screen's resolution, world units are pixels), so the lines show the shapes as they are;
// the cells are as big as the map can be on the screen.
//
// Everything is a collider on its layer: obstacles (circles and boxes, blue) block the circle and
// shots, vehicles (a navigation circle, blue, and an oriented hitbox, purple: light, medium and
// heavy) are pushed and turned by what hits them (external velocities, hope/physics.pg), crates
// (orange) break when the circle runs into them, when a shot hits them and in an explosion's
// blast. A blast also
// breaks the wall tiles in it (not the border); F1 then F2 builds the scene again.
//
//     WASD              move the circle (it slides along the walls and the obstacles)
//     mouse             aim: the ray to the first hit, its normal
//     space             shoot (a projectile: bounces when grazing and fast enough, loses speed
//                       with every bounce, explodes when too slow or hitting head on)
//     Q                 wide shots on/off (a circle: it does not fit through narrow gaps)
//     E                 ram towards the mouse: a dash in a straight line through crates, to a
//                       wall, an obstacle or a vehicle; both bounce off by their masses
//     left/right mouse  add/remove tiles
//     1, 2              smaller/bigger circle

const int PHYSICS_COLUMNS = 64;
const int PHYSICS_ROWS = 40;
const int PHYSICS_CRATES = 150;
// Speeds per second for cells of 24 (they scale with the cells)
const float PHYSICS_MOVE_SPEED = 300;
const float PHYSICS_SHOT_SPEED = 1500;
const float PHYSICS_SHOT_MIN_SPEED = 250;          // slower explodes
const float PHYSICS_SHOT_BOUNCE_ANGLE = 35;        // grazing (degrees) below this bounces
const float PHYSICS_SHOT_SPEED_KEPT = 0.75;        // per bounce
const float PHYSICS_BLAST_RADIUS = 1.5;            // in cells: crates and wall tiles in it break
const float PHYSICS_WIDE_SHOT_RADIUS = 0.4;        // in cells
// Impulses (mass * pixels / s for cells of 24; they scale with the cells)
const float PHYSICS_SHOT_IMPULSE = 120;            // a shot's hit, along its flight
const float PHYSICS_BLAST_IMPULSE = 250;           // an explosion's, away from it
const float PHYSICS_PLAYER_MASS = 3;
const float PHYSICS_RAM_SPEED = 1100;
const float PHYSICS_RAM_TIME = 0.3;                // seconds (or to what stops it)
const float PHYSICS_RAM_RESTITUTION_VEHICLE = 0.2; // how much a ram bounces back from a vehicle
const float PHYSICS_RAM_RESTITUTION_WALL = 0.5;    // from a wall or an obstacle (more)
const float PHYSICS_SLIDE_RESTITUTION = 0.3;       // something drifting into a wall

// The scene's layers
const uint LAYER_WALLS = 1;
const uint LAYER_OBSTACLE = 2;
const uint LAYER_HITBOX = 4;
const uint LAYER_NAVIGATION = 8;
const uint LAYER_CRATE = 16;
const uint SHOT_MASK = LAYER_WALLS | LAYER_OBSTACLE | LAYER_HITBOX | LAYER_CRATE;

// The owners of the colliders: what a hit was
const int OWNER_PLAYER = 1;
const int OWNER_OBSTACLE = 100;                    // + index
const int OWNER_HITBOX = 200;                      // + index
const int OWNER_CRATE = 1000;                      // + index

// A projectile of the scene, with what is drawn of it
struct DebugShot : Projectile {
    List[Vec2] trail;              // where it was (and bounced), for drawing
    int bounces;
}

// A vehicle of the scene: its hitbox (an oriented box) and its navigation circle; it only moves
// by what hits it (it has no steering of its own)
struct DebugVehicle {
    Vec2 center;                   // in cells (the level is kept in cells: Layout)
    Vec2 halfDim;                  // in cells
    float angle;
    float mass;
    ExternalVelocity external;     // pixels / s, degrees / s
}

// Where a projectile exploded, drawn for a while
struct DebugExplosion {
    Vec2 point;
    Vec2 normal;
    float age;
}

struct PhysicsScene {
    Grid[bool] solid;
    TileCollision tiles;
    float cell;                    // the cell size: the map fits the screen (Layout)
    // The level in cells (the world gets them in pixels)
    List[Circle] circleCells;
    List[Box] boxCells;
    List[DebugVehicle] vehicles;
    List[Vec2] crateCells;         // crate centers
    List[bool] crateBroken;
    // The world and the colliders the scene changes
    CollisionWorld world;
    bool hasWorld;
    ColliderId player;
    List[ColliderId] hitboxes;     // per vehicle
    List[ColliderId] vehicleBodies;  // per vehicle: its navigation circle
    ExternalVelocity playerExternal;
    float ramTime;                 // > 0: ramming
    Vec2 ramDirection;
    List[ColliderId] crates;       // per crate (None: broken)
    // The player's last slide, the shots
    List[Vec2] playerPath;
    Vec2 playerNormal;
    List[WorldHit] touched;
    List[DebugShot] shots;
    List[DebugExplosion] explosions;
    bool wideShots;                // Q
    float pixel = 1;               // the lines' width
}

extend PhysicsScene {
    init() {
        // A border, some walls and blocks
        solid = Grid[bool](PHYSICS_COLUMNS, PHYSICS_ROWS);
        for (let x in 0..PHYSICS_COLUMNS) {
            solid.Set(x, 0, true);
            solid.Set(x, PHYSICS_ROWS - 1, true);
        }
        for (let y in 0..PHYSICS_ROWS) {
            solid.Set(0, y, true);
            solid.Set(PHYSICS_COLUMNS - 1, y, true);
        }
        for (let y in 6..30) {
            solid.Set(20, y, true);
        }
        for (let x in 30..50) {
            solid.Set(x, 12, true);
        }
        for (let y in 22..28) {
            for (let x in 34..42) {
                solid.Set(x, y, true);
            }
        }
        for (let i in 0..8) {
            solid.Set(46 + i, 30 - i, true);   // a diagonal staircase
        }
        cell = 24;
        tiles = TileCollision(&solid, cell);
        circleCells.Add(Circle(Vec2(12.5, 29), 1.7));
        circleCells.Add(Circle(Vec2(50, 25), 1));
        boxCells.Add(Box(Vec2(29, 31), Vec2(34, 33)));
        vehicles.Add(DebugVehicle(center: Vec2(10, 6), halfDim: Vec2(1.2, 0.7), angle: 30, mass: 1));
        vehicles.Add(DebugVehicle(center: Vec2(44, 5), halfDim: Vec2(1.8, 1), angle: 0, mass: 3));
        vehicles.Add(DebugVehicle(center: Vec2(56, 33), halfDim: Vec2(2.6, 1.5), angle: 10, mass: 10));
        // Crates on open cells (deterministic, away from the player's start)
        let random = 12345 as uint;
        while (crateCells.len < PHYSICS_CRATES) {
            random = random * 1103515245 + 12345;
            let x = 1 + ((random >> 8) % ((PHYSICS_COLUMNS - 2) as uint)) as int;
            random = random * 1103515245 + 12345;
            let y = 1 + ((random >> 8) % ((PHYSICS_ROWS - 2) as uint)) as int;
            if (solid.Get(x, y) || (Vec2(x, y) - Vec2(8, 12)).Length() < 4)
                continue;
            crateCells.Add(Vec2(x + 0.5, y + 0.5));
            crateBroken.Add(false);
        }
    }


    // The cell size and the map's position from the screen (the map below the log lines); on a
    // change the world is built again (the player goes along)
    void Layout() {
        let canvas = Vec2(Draw.canvasDim);
        let newCell = Max(Floor(Min((canvas.x - 40) / PHYSICS_COLUMNS, (canvas.y - 170) / PHYSICS_ROWS)), 4.0);
        let newOrigin = Vec2(Floor((canvas.x - newCell * PHYSICS_COLUMNS) * 0.5), 150);
        if (hasWorld && newCell == cell && newOrigin == tiles.origin)
            return;
        // Where the player was, in cells
        let playerCell = Vec2(8, 12);
        let playerRadius = 2.0 / 3;
        if (hasWorld) {
            let circle = world.Get(player).shape.circle;
            playerCell = (circle.center - tiles.origin) / cell;
            playerRadius = circle.radius / cell;
            world.Free();
        }
        cell = newCell;
        tiles = TileCollision(&solid, cell, newOrigin);
        for (let shot in shots) {
            shot.trail.Free();
        }
        shots.Clear();
        explosions.Clear();
        BuildWorld(playerCell, playerRadius);
    }

    Vec2 ToWorld(Vec2 cells) { return tiles.origin + cells * cell; }

    void BuildWorld(Vec2 playerCell, float playerRadius) {
        world = CollisionWorld(tiles.bounds, cell * 3, &tiles, LAYER_WALLS);
        hasWorld = true;
        player = world.Add(Collider(ColliderShape.Circle(circle: Circle(ToWorld(playerCell), playerRadius * cell)),
            LAYER_NAVIGATION, LAYER_WALLS | LAYER_OBSTACLE | LAYER_CRATE | LAYER_NAVIGATION, OWNER_PLAYER));
        for (let i, c in circleCells) {
            world.Add(Collider(ColliderShape.Circle(circle: Circle(ToWorld(c.center), c.radius * cell)), LAYER_OBSTACLE, 0, OWNER_OBSTACLE + i));
        }
        for (let i, b in boxCells) {
            world.Add(Collider(ColliderShape.Box(box: Box(ToWorld(b.min), ToWorld(b.max))), LAYER_OBSTACLE, 0, OWNER_OBSTACLE + circleCells.len + i));
        }
        hitboxes.Clear();
        vehicleBodies.Clear();
        for (let i, v in vehicles) {
            hitboxes.Add(world.Add(Collider(ColliderShape.OrientedBox(orientedBox: OrientedBox(ToWorld(v.center), v.halfDim * cell, v.angle)), LAYER_HITBOX, 0, OWNER_HITBOX + i)));
            vehicleBodies.Add(world.Add(Collider(ColliderShape.Circle(circle: Circle(ToWorld(v.center), Min(v.halfDim.x, v.halfDim.y) * cell)),
                LAYER_NAVIGATION, LAYER_WALLS | LAYER_OBSTACLE | LAYER_CRATE | LAYER_NAVIGATION, OWNER_HITBOX + i)));
        }
        crates.Clear();
        for (let i, center in crateCells) {
            if (crateBroken[i]) {
                crates.Add(ColliderId.None);
                continue;
            }
            let half = Vec2(cell * 0.3);
            crates.Add(world.Add(Collider(ColliderShape.Box(box: Box(ToWorld(*center) - half, ToWorld(*center) + half)), LAYER_CRATE, 0, OWNER_CRATE + i)));
        }
    }

    // A crate breaks (its collider goes away)
    void BreakCrate(int owner) {
        let index = owner - OWNER_CRATE;
        if (index < 0 || crates.len <= index || crateBroken[index])
            return;
        world.Remove(crates[index]);
        crates[index] = ColliderId.None;
        crateBroken[index] = true;
    }

    // What an owner is, for the log
    string OwnerName(int owner) {
        return owner >= OWNER_CRATE ? "crate" : owner >= OWNER_HITBOX ? "vehicle" : owner >= OWNER_OBSTACLE ? "obstacle" : "player";
    }

    // The vehicle an owner is (null: none)
    DebugVehicle* VehicleOf(int owner) {
        let index = owner - OWNER_HITBOX;
        return 0 <= index && index < vehicles.len ? &vehicles[index] : null;
    }

    // An impulse on a vehicle at 'point' (its hitbox: pushed and turned)
    void PushVehicle(DebugVehicle* vehicle, Vec2 impulse, Vec2 point) {
        let halfDim = vehicle.halfDim * cell;
        vehicle.external.ApplyImpulse(impulse, point, ToWorld(vehicle.center), vehicle.mass, Inertia.Box(vehicle.mass, halfDim));
    }

    // The vehicles drift and turn by their external velocities until drag stops them; a wall or
    // another body they drift into stops that part (bouncing a little)
    void MoveVehicles(float dt) {
        for (let i, v in vehicles) {
            if (!v.external.isResting) {
                let slide = world.Slide(vehicleBodies[i], v.external.linear * dt);
                if (slide.hasHit)
                    v.external.HitSurface(slide.lastNormal, PHYSICS_SLIDE_RESTITUTION);
                v.center = (slide.center - tiles.origin) / cell;
                v.angle += v.external.angular * dt;
                v.external.Damp(dt);
            }
            world.SetShape(hitboxes[i], ColliderShape.OrientedBox(orientedBox: OrientedBox(ToWorld(v.center), v.halfDim * cell, v.angle)));
        }
    }

    // A ram's step: the player's circle along a straight line (a cast through the world, not a
    // slide): through crates (they break), to a wall, an obstacle or a vehicle. There both bounce
    // off: an impulse along the hit's normal from how fast they close in, the restitution and
    // their masses (a wall: infinitely heavy). After it the ram's velocity is the player's
    // external velocity (it drifts on, or back).
    void RamStep(float dt) {
        let body = world.Get(player).shape.circle;
        let ramVelocity = ramDirection * PHYSICS_RAM_SPEED * (cell / 24);
        let motion = ramVelocity * dt;
        let stop = world.CircleCastThrough(body, motion, LAYER_WALLS | LAYER_OBSTACLE | LAYER_HITBOX | LAYER_CRATE,
            (WorldHit* hit) => {
                if (!hit.isTile && hit.owner >= OWNER_CRATE) {
                    BreakCrate(hit.owner);
                    return true;                   // on through it
                }
                return false;
            },
            [player]                               // (not its own circle)
        );
        ramTime -= dt;
        if (!stop.hasIntersection) {
            world.MoveTo(player, body.center + motion);
            if (ramTime <= 0)
                playerExternal.linear = ramVelocity * 0.3;   // the dash ends: coasting out
            return;
        }
        world.MoveTo(player, stop.enter + stop.normalEnter * SLIDE_SKIN);
        ramTime = 0;
        let normal = stop.normalEnter;             // out of what it hit, towards the player
        let vehicle = stop.isTile ? null : VehicleOf(stop.owner);
        let otherVelocity = vehicle != null ? vehicle.external.linear : Vec2(0, 0);
        let closing = Max(Vec2.Dot(ramVelocity - otherVelocity, -normal), 0.0);
        let restitution = vehicle != null ? PHYSICS_RAM_RESTITUTION_VEHICLE : PHYSICS_RAM_RESTITUTION_WALL;
        let inverseMasses = 1 / PHYSICS_PLAYER_MASS + (vehicle != null ? 1 / vehicle.mass : 0);
        let impulse = (1 + restitution) * closing / inverseMasses;
        if (vehicle != null)
            PushVehicle(vehicle, -normal * impulse, stop.enter - normal * body.radius);
        playerExternal.linear = ramVelocity;
        playerExternal.ApplyLinearImpulse(normal * impulse, PHYSICS_PLAYER_MASS);
    }

    void DoFrame() {
        // World units are screen pixels
        Camera.isCentered = false;
        Camera.pos = Vec2(0, 0);
        Camera.rotation = 0;
        Camera.zoom = 1;
        Camera.allowPanning = false;
        Camera.allowZooming = false;
        let dt = Input.deltaTime;
        Layout();
        MoveVehicles(dt);
        let cursor = Input.cursors.world;

        // Tiles
        let cursorCell = tiles.CellAt(cursor);
        if (solid.rect.Contains(cursorCell)) {
            if (Input.MouseDown(MouseButton.Left))
                solid.Set(cursorCell, true);
            if (Input.MouseDown(MouseButton.Right))
                solid.Set(cursorCell, false);
        }
        let body = world.Get(player).shape.circle;
        if (Input.KeyPressed(Scancode.Alpha1))
            body.radius = Max(body.radius - cell / 6, cell / 6);
        if (Input.KeyPressed(Scancode.Alpha2))
            body.radius = Min(body.radius + cell / 6, cell * 3);
        world.SetShape(player, ColliderShape.Circle(circle: body));

        // Moving: slides along walls and obstacles, crates it runs into break
        let direction = Vec2(0, 0);
        if (Input.KeyDown(Scancode.A))
            direction.x -= 1;
        if (Input.KeyDown(Scancode.D))
            direction.x += 1;
        if (Input.KeyDown(Scancode.W))
            direction.y -= 1;
        if (Input.KeyDown(Scancode.S))
            direction.y += 1;
        // E rams towards the mouse; while ramming there is no steering
        if (Input.KeyPressed(Scancode.E) && ramTime <= 0) {
            ramTime = PHYSICS_RAM_TIME;
            ramDirection = (cursor - body.center).NormalizedOr(Vec2(1, 0));
        }
        playerPath.Clear();
        touched.Clear();
        if (ramTime > 0) {
            RamStep(dt);
        } else {
            let motion = (direction.NormalizedOr(Vec2(0, 0)) * PHYSICS_MOVE_SPEED * (cell / 24) + playerExternal.linear) * dt;
            let slide = world.Slide(player, motion, &touched, &playerPath);
            playerNormal = slide.lastNormal;
            if (slide.hasHit)
                playerExternal.HitSurface(slide.lastNormal, PHYSICS_SLIDE_RESTITUTION);
            playerExternal.Damp(dt);
        }
        for (let hit in touched) {
            if (!hit.isTile && hit.owner >= OWNER_CRATE)
                BreakCrate(hit.owner);
        }
        body = world.Get(player).shape.circle;

        // Aiming: a ray to the cursor and on
        if (Input.KeyPressed(Scancode.Q))
            wideShots = !wideShots;
        let shotRadius = wideShots ? PHYSICS_WIDE_SHOT_RADIUS * cell : 0.0;
        let aim = (cursor - body.center).NormalizedOr(Vec2(1, 0));
        let muzzle = body.center + aim * (body.radius + shotRadius + 4);
        let aimRay = Line(muzzle, muzzle + aim * 3000);
        ProjectileHit aimHit;
        aimHit.WorldHit = wideShots ? world.CircleCast(Circle(muzzle, shotRadius), aimRay.end - aimRay.start, SHOT_MASK) : world.Raycast(aimRay, SHOT_MASK);
        aimHit.direction = aim;
        aimHit.radius = shotRadius;

        // Shooting: every hit costs speed; grazing and still fast it bounces, else it explodes
        // (also when it starts inside something: the scene's choice). Crates it hits break, so
        // does every crate in the blast.
        if (Input.KeyPressed(Scancode.Space)) {
            let shot = DebugShot(position: muzzle, velocity: aim * PHYSICS_SHOT_SPEED * (cell / 24), radius: shotRadius);
            shot.trail.Add(muzzle);
            shots.Add(shot);
        }
        for (let i = shots.len - 1; i >= 0; i--) {
            let shot = &shots[i];
            let step = shot.Step(dt, &world, SHOT_MASK,
                (ProjectileHit* hit) => {
                    shot.trail.Add(hit.point);
                    if (!hit.isTile && hit.owner >= OWNER_CRATE)
                        BreakCrate(hit.owner);
                    let vehicle = hit.isTile ? null : VehicleOf(hit.owner);
                    if (vehicle != null)
                        PushVehicle(vehicle, hit.direction * PHYSICS_SHOT_IMPULSE * (cell / 24), hit.contact);
                    shot.velocity = shot.velocity * PHYSICS_SHOT_SPEED_KEPT;
                    if (!hit.startsInside && hit.impactAngle < PHYSICS_SHOT_BOUNCE_ANGLE && shot.velocity.Length() >= PHYSICS_SHOT_MIN_SPEED * (cell / 24)) {
                        shot.bounces++;
                        return true;
                    }
                    Explode(hit.point, hit.normal);
                    return false;
                }
            );
            if (shot.trail.len > 64)
                shot.trail.RemoveAt(0);
            if (step != ProjectileStep.Flying) {                 // exploded, or out of the world
                shot.trail.Free();
                shots.RemoveAt(i);
            }
        }
        for (let i = explosions.len - 1; i >= 0; i--) {
            explosions[i].age += dt;
            if (explosions[i].age > 1)
                explosions.RemoveAt(i);
        }

        Render(cursor, aimRay, &aimHit);
        let broken = crateBroken.Count((bool* isBroken) => *isBroken);
        Draw.LogLine("physics scene (F2): WASD move, mouse aim, space shoot, Q wide shots (", wideShots, "), E ram, left/right mouse add/remove tiles, 1/2 circle size");
        for (let i, v in vehicles) {
            Draw.LogLine("vehicle ", i, " (mass ", v.mass, "): speed ", v.external.linear.Length() as int, " px/s, turning ", v.external.angular as int, " deg/s");
        }
        Draw.LogLine("circle radius ", body.radius, ", slide steps ", playerPath.len - 1, ", shots ", shots.len, ", colliders ", world.count,
            ", crates broken ", broken, "/", crateCells.len);
        if (aimHit.hasIntersection)
            Draw.LogLine("aim: ", aimHit.isTile ? TFormat("tile ", aimHit.cell) : OwnerName(aimHit.owner), " at ", aimHit.point, " normal ", aimHit.normal,
                " impact angle ", FormatFloat(aimHit.impactAngle, 1), aimHit.startsInside ? " (starts inside)" : "");
    }

    // An explosion: drawn for a while, the crates and the wall tiles in its blast break (right
    // in the query: the world lets it change what it finds)
    void Explode(Vec2 point, Vec2 normal) {
        explosions.Add(DebugExplosion(point, normal, 0));
        world.ForEachOverlap(ColliderShape.Circle(circle: Circle(point, PHYSICS_BLAST_RADIUS * cell)), LAYER_WALLS | LAYER_CRATE | LAYER_HITBOX, (WorldOverlap* found) => {
            let vehicle = found.isTile ? null : VehicleOf(found.owner);
            if (vehicle != null) {
                // Away from the blast, through its center (it only moves)
                let away = (ToWorld(vehicle.center) - point).NormalizedOr(Vec2(0, -1));
                vehicle.external.ApplyLinearImpulse(away * PHYSICS_BLAST_IMPULSE * (cell / 24), vehicle.mass);
                return;
            }
            if (!found.isTile) {
                BreakCrate(found.owner);
                return;
            }
            let border = found.cell.x == 0 || found.cell.y == 0 || found.cell.x == solid.w - 1 || found.cell.y == solid.h - 1;
            if (!border)
                solid.Set(found.cell.x, found.cell.y, false);
        });
    }

    void Render(Vec2 cursor, Line aimRay, ProjectileHit* aimHit) {
        let wallColor = Color(0.9, 0.9, 0.95, 1);
        let thin = pixel;
        // Tiles, and their walls (all of them: the merged exposed faces)
        for (let y in 0..solid.h) {
            for (let x in 0..solid.w) {
                if (solid.Get(x, y))
                    Draw.Rect(tiles.CellBox(x, y).ToRect(), 1, Color(0.25, 0.27, 0.35, 1));
            }
        }
        let allWalls = Obstacles();
        tiles.AddWalls(tiles.bounds, &allWalls);
        for (let wall in allWalls.walls) {
            Draw.Line(wall.start, wall.end, thin, 2, wallColor);
            // The open side
            let middle = (wall.start + wall.end) * 0.5;
            let direction = wall.direction;
            let front = Vec2(-direction.y, direction.x).NormalizedOr(Vec2(0, -1));
            Draw.Line(middle, middle + front * 5, thin, 2, Color(0.6, 0.6, 0.7, 1));
        }
        allWalls.Free();
        // The cell under the cursor
        let cursorCell = tiles.CellAt(cursor);
        DrawBoxOutline(tiles.CellBox(cursorCell.x, cursorCell.y), Color(1, 1, 0, 0.5));

        // The colliders, by layer
        for (let slot in world.slots) {
            if (!slot.isUsed || slot.collider.owner == OWNER_PLAYER)
                continue;
            let layer = slot.collider.layer;
            let color = layer == LAYER_CRATE ? Color(1, 0.6, 0.2, 1) : layer == LAYER_HITBOX ? Color(0.85, 0.45, 1, 1) : Color(0.4, 0.8, 1, 1);
            if (layer == LAYER_CRATE)
                Draw.Rect(slot.collider.shape.box.ToRect(), 3, Color(0.55, 0.33, 0.12, 1));
            DrawShape(slot.collider.shape, color);
        }

        // The walls the player considered this frame (highlighted)
        for (let wall in world.obstacles.walls) {
            Draw.Line(wall.start, wall.end, 2 * pixel, 4, Color(1, 0.6, 0.2, 0.8));
        }

        // The player, its slide steps and its last hit's normal
        let body = world.Get(player).shape.circle;
        Draw.CircleOutline(body, 1.5 * pixel, 5, ramTime > 0 ? Color(1, 0.3, 0.3, 1) : Color(0.3, 1, 0.4, 1));
        // The external velocities (where they drift)
        if (!playerExternal.isResting)
            Draw.Line(body.center, body.center + playerExternal.linear * 0.1, thin, 6, Color(0.3, 1, 1, 1));
        for (let v in vehicles) {
            if (!v.external.isResting)
                Draw.Line(ToWorld(v.center), ToWorld(v.center) + v.external.linear * 0.1, thin, 6, Color(0.3, 1, 1, 1));
        }
        for (let step in 1..playerPath.len) {
            Draw.Line(playerPath[step - 1], playerPath[step], thin, 6, Color(1, 1, 1, 1));
        }
        if (playerNormal != Vec2(0, 0))
            Draw.Line(body.center, body.center + playerNormal * (body.radius + 12), thin, 6, Color(1, 0.3, 0.3, 1));

        // The aim: the ray to the hit, the hit's normal
        let aimEnd = aimHit.hasIntersection ? aimHit.point : aimRay.end;
        Draw.Line(aimRay.start, aimEnd, thin, 7, Color(1, 0.2, 0.8, 0.8));
        if (aimHit.hasIntersection) {
            Draw.CircleOutline(Circle(aimHit.point, Max(aimHit.radius, 3.0)), thin, 7, Color(1, 0.2, 0.8, 1));
            Draw.Line(aimHit.contact, aimHit.contact + aimHit.normal * 20, thin, 7, Color(1, 1, 0.2, 1));
        }

        // Shots with their trails, explosions (with their blast)
        for (let shot in shots) {
            for (let i in 1..shot.trail.len) {
                Draw.Line(shot.trail[i - 1], shot.trail[i], thin, 8, Color(1, 0.8, 0.3, 0.6));
            }
            if (shot.trail.len > 0)
                Draw.Line(*shot.trail.last, shot.position, thin, 8, Color(1, 0.8, 0.3, 0.6));
            if (shot.radius > 0)
                Draw.CircleOutline(Circle(shot.position, shot.radius), thin, 9, Color(1, 0.9, 0.4, 1));
            Draw.Circle(shot.position, 2.5, 9, Color(1, 0.9, 0.4, 1));
        }
        for (let explosion in explosions) {
            let fade = 1 - explosion.age;
            Draw.CircleOutline(Circle(explosion.point, 4 + explosion.age * 30), thin, 9, Color(1, 0.5, 0.1, fade));
            Draw.CircleOutline(Circle(explosion.point, PHYSICS_BLAST_RADIUS * cell), thin, 9, Color(1, 0.5, 0.1, fade * 0.3));
            Draw.Line(explosion.point, explosion.point + explosion.normal * 15, thin, 9, Color(1, 1, 0.2, fade));
        }
    }

    void DrawShape(ColliderShape shape, Color color) {
        switch (shape.case) {
        case ColliderShape.Circle: Draw.CircleOutline(shape.circle, pixel, 3, color);
        case ColliderShape.Box: DrawBoxOutline(shape.box, color);
        case ColliderShape.OrientedBox:
            for (let corner in 0..4) {
                Draw.Line(shape.orientedBox.Corner(corner), shape.orientedBox.Corner((corner + 1) % 4), pixel, 3, color);
            }
        }
    }

    void DrawBoxOutline(Box box, Color color) {
        Draw.Line(box.leftTop, box.rightTop, pixel, 3, color);
        Draw.Line(box.rightTop, box.rightBottom, pixel, 3, color);
        Draw.Line(box.rightBottom, box.leftBottom, pixel, 3, color);
        Draw.Line(box.leftBottom, box.leftTop, pixel, 3, color);
    }
}
