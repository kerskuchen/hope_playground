////////////////////////////////////////////////////////////////////////////////////////////////////
// The level scene (F1): a level of assets/levels/ in two modes, F1 switches:
//
//     preview   as a game would show it: the fixed canvas, the playground's own presentation made
//               from the level's data (every layer in the editor's order); the arrow keys move the
//               view; a list of the levels (a click: another one). Trigger areas as a game uses
//               them: every area of the Areas layers a trigger of a CollisionWorld (hope's
//               collision.pg), a probe circle at the mouse; what it enters and leaves is logged,
//               the areas it is in are outlined
//     editing   hope's level editor (hope/level_editor.pg; F1 opens it in the internal mode only)
//               on that level
//
// The editor exists as long as the scene (the editor phase: its data, its undo steps), open or
// not; the preview is made from its data (it shows the unsaved changes too). Another level (the
// list, the editor's Open and New): main.pg makes the scene again (SwitchTo: the editor phase
// wiped) with it.

// The level the scene shows (kept when the scene is made again for another level; persistent
// memory) and how the scene starts with it
string levelSceneName = "";
LevelSceneStart levelSceneStart = LevelSceneStart.Session;

enum LevelSceneStart {
    Session,                           // as the editor's session was (open or not)
    Preview,                           // picked in the preview's list
    Editor,                            // opened, made or saved as in the editor
}

const uint LAYER_PROBE = 1;           // the preview's probe (the triggers' mask)

void SetLevelSceneName(string name) {
    ScopeAllocPersistent();
    levelSceneName = name.Copy();
}

struct LevelScene {
    LevelEditor* editor;               // (the editor phase, like the scene)
    bool isEditing;
    LevelDrawings* preview;            // what the preview draws (the level phase)
    CollisionWorld* triggers;          // the areas as triggers, the probe (the level phase)
    ColliderId probe;
    Vec2 previewPos = Vec2(160, 90);   // its camera
    String requestedLevel;             // (main.pg makes the scene again with it after this frame)
    LevelSceneStart requestedStart;
}

extend LevelScene {
    init() {
        // The level: the one opened (levelSceneName), else the one open last, else the first
        {
            ScopeAllocTemp();
            let names = LevelEditor.LevelNames();
            let last = LevelEditor.LastLevel();
            let chosen = levelSceneName.len > 0 ? levelSceneName : names.Find((string* candidate) => *candidate == last) != null ? last : names.len > 0 ? names[0] : "test";
            SetLevelSceneName(chosen);
        }
        editor = New[LevelEditor](levelSceneName);
        editor.gameKeys = "F1: the preview";
        isEditing = levelSceneStart == LevelSceneStart.Session ? editor.wasOpen : levelSceneStart == LevelSceneStart.Editor;
        levelSceneStart = LevelSceneStart.Session;
        Show();
    }

    get bool hasDialog() { return editor.hasDialog; }
    bool AskAboutChanges(string doing) { return editor.AskAboutChanges(doing); }
    void WriteSession() { editor.WriteSession(); }

    // The mode's canvas and camera: the editor opened, or the preview made from its data (the
    // level phase wiped first)
    void Show() {
        Memory.WipeLevel();
        if (isEditing) {
            editor.Enter();
            return;
        }
        preview = LevelDrawings.Make(&editor.data);
        MakeTriggers();
        Draw.isCanvasFree = false;
        Camera.rotation = 0;
        Camera.isCentered = true;
        Camera.allowPanning = false;
        Camera.allowZooming = false;
        Camera.pos = previewPos;
        Camera.zoom = 1;
        Draw.clearColor = Color.Black;
    }

    // Every area of the Areas layers a trigger (its owner: layer * 1000 + its index), the probe a
    // circle at the mouse
    void MakeTriggers() {
        ScopeAllocLevel();
        let data = &editor.data;
        triggers = New[CollisionWorld](Box(Vec2(0, 0), Vec2(data.pixelSize)), 64);
        for (let layerIndex, layer in data.layers) {
            if (layer.case != LevelLayer.Areas)
                continue;
            for (let index, area in layer.areas) {
                triggers.AddTrigger(area.shape, LAYER_PROBE, owner: layerIndex * 1000 + index);
            }
        }
        probe = triggers.Add(Collider(ColliderShape.Circle(circle: Circle(previewPos, 6)), LAYER_PROBE, 0, 0));
    }

    // The mode closed (its drawing freed; its memory stays in the level phase)
    void Hide() {
        if (isEditing) {
            editor.Leave();
        } else if (preview != null) {
            previewPos = Camera.pos;
            preview.Free();
            preview = null;
        }
    }

    // The scene goes (main.pg)
    void Leave() {
        Hide();
        editor.WriteSession();
        Memory.WipeLevel();
        Draw.isCanvasFree = false;
        Camera.allowPanning = false;
        Camera.allowZooming = false;
        Camera.zoom = 1;
    }

    void DoFrame() {
        editor.showsHints = playground.settings.showsHints;
        editor.GuardUnsaved();
        if (Input.KeyPressed(Scancode.F1) && !Ui.isTyping && INTERNAL) {
            Hide();
            isEditing = !isEditing;
            Show();
        }
        if (!isEditing) {
            PreviewFrame();
            return;
        }
        editor.DoFrame();
        if (editor.requestedLevel.len > 0)
            Request(editor.requestedLevel.view, LevelSceneStart.Editor);
        if (editor.levelName != levelSceneName)
            SetLevelSceneName(editor.levelName);       // (saved as another)
    }

    void Request(string level, LevelSceneStart start) {
        requestedLevel.Clear();
        requestedLevel.Append(level);
        requestedStart = start;
    }

    //----------------------------------------------------------------------------------------------
    // Preview: what a game makes of the level (its own presentation: here every layer, ground first)

    void PreviewFrame() {
        if (playground.settings.showsHints)
            Draw.LogLine("Level scene (F1: the editor): the level '", editor.levelName, "' as a game shows it (the list: another one), arrow keys move the view, the mouse is a probe for the trigger areas");
        let move = Vec2(0, 0);
        if (Input.KeyDown(Scancode.Left)) move.x -= 1;
        if (Input.KeyDown(Scancode.Right)) move.x += 1;
        if (Input.KeyDown(Scancode.Up)) move.y -= 1;
        if (Input.KeyDown(Scancode.Down)) move.y += 1;
        let half = Camera.viewportDim * 0.5;
        let bounds = editor.data.cameraRect;
        let pos = Camera.pos + move * 160 * Input.deltaTime;
        Camera.pos = Vec2(Clamp(pos.x, bounds.left + half.x, Max(bounds.left + half.x, bounds.right - half.x)),
            Clamp(pos.y, bounds.top + half.y, Max(bounds.top + half.y, bounds.bottom - half.y)));
        let view = Camera.viewportRect;
        for (let drawing in preview.layers) {
            drawing.Draw(view);
        }
        // The probe and what it enters and leaves
        let mouse = Input.cursors.world;
        triggers.MoveTo(probe, mouse);
        triggers.UpdateTriggers();
        for (let event in triggers.triggerEvents) {
            let area = &editor.data.layers[event.triggerOwner / 1000].areas[event.triggerOwner % 1000];
            Draw.LogSticky(150, event.isEnter ? Color.Green : Color.Orange, event.isEnter ? "Entered '" : "Left '", area.name, "' (", area.kind, ")");
        }
        Draw.CircleOutline(Circle(mouse, 6), 1, Depth.Nearest, DrawParams(color: Color(1, 1, 1, 0.9)));
        for (let layer in editor.data.layers) {
            if (layer.case != LevelLayer.Areas)
                continue;
            for (let area in layer.areas) {
                if (!Overlap.BoxCircle(area.box, Circle(mouse, 6)))
                    continue;
                let box = area.box;
                [Vec2, 4] corners = [box.min, Vec2(box.max.x, box.min.y), box.max, Vec2(box.min.x, box.max.y)];
                for (let corner in 0..4) {
                    Draw.Line(corners[corner], corners[(corner + 1) % 4], 1, Depth.Nearest, DrawParams(color: LevelEditor.AreaColor(area.kind)));
                }
            }
        }
        // The levels there are: a click previews another one (a panel of the window's pixels, as
        // the editor's: the fixed canvas would make it big; the arrow keys are the view's)
        Ui.BlockKeys();
        Ui.InScreen();
        Ui.WithFont(Ui.style.fontName, 2);
        Ui.Panel(UiAnchor.RightTop, 220, 0, Vec2i(-8, 150));       // (below the log's lines)
        Ui.Label("Levels", UiAlign.Left, Ui.style.textFocused);
        let names = LevelEditor.LevelNames();
        {
            Ui.Scroll(Min(Max(1, names.len), 8) * (Ui.ButtonHeight() + Ui.style.spacing));
            for (let index, level in names) {
                if (Ui.Button(*level, id: index, align: UiAlign.Left, isToggled: *level == editor.levelName) && *level != editor.levelName
                        && editor.AskAboutChanges("previewing another level"))
                    Request(*level, LevelSceneStart.Preview);
            }
        }
    }
}
