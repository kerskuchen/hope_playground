////////////////////////////////////////////////////////////////////////////////////////////////////
// The level scene (F9): a level of assets/levels/ as a game would show it: the fixed canvas, the
// playground's own presentation made from the level's data (every layer in the editor's order);
// the arrow keys move the view; a list of the levels (a click: another one). Trigger areas as a
// game uses them: every area of the Areas layers a trigger of a CollisionWorld (hope's
// collision.pg), a probe circle at the mouse; what it enters and leaves is logged, the areas it is
// in are outlined; an area entered sends its signal, the ghosts near it are woken
// (Signals.SendNear). The entities of its Entities layers (entities.pg: hope's
// Entities.SpawnLevel), run and drawn in the scene's order, the signals delivered after their
// frames.
//
// The level editor is hope's (F1 in every scene, the internal mode): the scene is made again when
// the editor closes and its level changed (main.pg: LevelEdited); LevelData.Load gives it the
// editor's data, unsaved changes too.

// The level the scene shows (kept when the scene is made again for another level; persistent
// memory)
string levelSceneName = "";

const uint LAYER_PROBE = 1;           // the preview's probe (the triggers' mask)

void SetLevelSceneName(string name) {
    if (name == levelSceneName) {
        return;
    }
    with persist;
    levelSceneName = name.Copy();
}

// (the level phase, as everything of the scene)
struct LevelScene {
    LevelData data;
    LevelDrawings* preview;            // what is drawn of the layers
    CollisionWorld* triggers;          // the areas as triggers, the probe
    ColliderId probe;
    String requestedLevel;             // (main.pg makes the scene again with it after this frame)
}

extend LevelScene {
    init() {
        // The level: the one shown before (levelSceneName), else the one edited last, else the first
        with temp {
            let names = LevelEditor.LevelNames();
            let last = LevelEditor.LastLevel();
            let chosen = levelSceneName.len > 0 ? levelSceneName : names.Find((string* candidate) => *candidate == last) != null ? last : names.len > 0 ? names[0] : "test";
            SetLevelSceneName(chosen);
        }
        data = LevelData.Load(levelSceneName);
        preview = LevelDrawings.Make(&data);
        MakeTriggers();
        // The entities (in the level phase, like the drawing: wiped with it)
        entityWorld = triggers;
        for (let layer in data.layers) {
            if (layer.case == LevelLayer.Entities) {
                Entities.SpawnLevel(layer);
            }
        }
        Draw.isCanvasFree = false;
        Camera.rotation = 0;
        Camera.isCentered = true;
        Camera.allowPanning = false;
        Camera.allowZooming = false;
        Camera.pos = Vec2(160, 90);
        Camera.zoom = 1;
        Draw.clearColor = Color.Black;
    }

    // Every area of the Areas layers a trigger (its owner: layer * 1000 + its index), the probe a
    // circle at the mouse
    void MakeTriggers() {
        triggers = New[CollisionWorld](Box(Vec2(0, 0), Vec2(data.pixelSize)), 64);
        for (let layerIndex, layer in data.layers) {
            if (layer.case != LevelLayer.Areas) {
                continue;
            }
            for (let index, area in layer.areas) {
                triggers.AddTrigger(area.shape, LAYER_PROBE, owner: layerIndex * 1000 + index);
            }
        }
        probe = triggers.Add(Collider(ColliderShape.Circle(circle: Circle(Camera.pos, 6)), LAYER_PROBE, 0, 0));
    }

    // The scene goes (main.pg; its memory goes with the level phase)
    void Leave() {
        preview.ReleaseSprites();
        entityWorld = null;
    }

    void Request(string level) {
        requestedLevel.Clear();
        requestedLevel.Append(level);
    }

    //----------------------------------------------------------------------------------------------
    // Preview: what a game makes of the level (its own presentation: here every layer, ground first)

    void DoFrame() {
        if (playground.settings.showsHints) {
            Draw.LogLine("Level scene (F1: the editor): the level '{levelSceneName}' as a game shows it (the list: another one), arrow keys move the view, the mouse is a probe for the trigger areas");
        }
        let move = Vec2(0, 0);
        if (Input.KeyDown(Scancode.Left)) {
            move.x -= 1;
        }
        if (Input.KeyDown(Scancode.Right)) {
            move.x += 1;
        }
        if (Input.KeyDown(Scancode.Up)) {
            move.y -= 1;
        }
        if (Input.KeyDown(Scancode.Down)) {
            move.y += 1;
        }
        let half = Camera.viewportDim * 0.5;
        let bounds = data.cameraRect;
        let pos = Camera.pos + move * 160 * Input.deltaTime;
        Camera.pos = Vec2(Clamp(pos.x, bounds.left + half.x, Max(bounds.left + half.x, bounds.right - half.x)),
            Clamp(pos.y, bounds.top + half.y, Max(bounds.top + half.y, bounds.bottom - half.y)));
        let view = Camera.viewportRect;
        for (let drawing in preview.layers) {
            drawing.Draw(view);
        }
        // The entities: their frames in the game's order, the destroyed ones gone, then drawn
        for (let brazier in Entities.All[Brazier]()) {
            brazier.DoFrame();
        }
        for (let spawner in Entities.All[Spawner]()) {
            spawner.DoFrame();
        }
        for (let ghost in Entities.All[Ghost]()) {
            ghost.DoFrame();
        }
        for (let turret in Entities.All[Turret]()) {
            turret.DoFrame();
        }
        for (let door in Entities.All[Door]()) {
            door.DoFrame();
        }
        for (let lever in Entities.All[Lever]()) {
            lever.DoFrame();
        }
        // The probe and what it enters and leaves: an area entered sends its signal (the probe
        // stands in for the player); the ghosts near it are woken
        let mouse = Input.cursors.world;
        triggers.MoveTo(probe, mouse);
        triggers.UpdateTriggers();
        for (let event in triggers.triggerEvents) {
            let area = &data.layers[event.triggerOwner / 1000].areas[event.triggerOwner % 1000];
            Draw.LogSticky(150, event.isEnter ? Color.Green : Color.Orange, "{event.isEnter ? "Entered '" : "Left '"}{area.name}' ({area.kind})");
            if (event.isEnter) {
                area.SendSignal();
            }
        }
        Signals.SendNear(mouse, 40, "wake");
        // The signals of this frame, then the destroyed ones gone
        Signals.Deliver();
        Entities.Flush();
        if (playground.settings.showsHints) {
            Draw.LogLine("entities: {Entities.count} (ghosts {Entities.All[Ghost]().len}, gone {ghostsGone}), signals waiting {Signals.pending}");
        }
        for (let brazier in Entities.All[Brazier]()) {
            brazier.Draw();
        }
        for (let spawner in Entities.All[Spawner]()) {
            spawner.Draw();
        }
        for (let ghost in Entities.All[Ghost]()) {
            ghost.Draw();
        }
        for (let turret in Entities.All[Turret]()) {
            turret.Draw();
        }
        for (let door in Entities.All[Door]()) {
            door.Draw();
        }
        for (let lever in Entities.All[Lever]()) {
            lever.Draw();
        }
        Draw.CircleOutline(Circle(mouse, 6), 1, Depth.Nearest, DrawParams(color: Color(1, 1, 1, 0.9)));
        for (let layer in data.layers) {
            if (layer.case != LevelLayer.Areas) {
                continue;
            }
            for (let area in layer.areas) {
                if (!Overlap.BoxCircle(area.box, Circle(mouse, 6))) {
                    continue;
                }
                Draw.RectOutline(LevelEditor.RectOf(area.rect), 1, Depth.Nearest, DrawParams(color: LevelEditor.AreaColor(area.kind)));
            }
        }
        // The levels there are: a click previews another one (a panel of the window's pixels, as
        // the editor's: the fixed canvas would make it big; the arrow keys are the view's)
        Ui.BlockKeys();
        with Ui.InScreen();
        with Ui.Font(Ui.style.fontName, 2);
        with Ui.Panel(UiAnchor.RightTop, 220, 0, Vec2i(-8, 150));       // (below the log's lines)
        Ui.Label("Levels", UiAlign.Left, Ui.style.textFocused);
        let names = LevelEditor.LevelNames();
        with Ui.Scroll(Min(Max(1, names.len), 8) * (Ui.ButtonHeight() + Ui.style.spacing)) {
            for (let index, level in names) {
                if (Ui.Button(*level, align: UiAlign.Left, isToggled: *level == levelSceneName) && *level != levelSceneName) {
                    Request(*level);
                }
            }
        }
    }
}
