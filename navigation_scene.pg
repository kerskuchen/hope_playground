// The navigation scene (F4, in the level phase): hope's NavGrid with agents of the three sizes
// and four movement profiles following their paths to the target, planned by a NavScheduler (the
// agents ask every frame, it plans what is needed within its budget). The map has floor, walls,
// water, low walls and breakable walls; the ram breaks the breakable walls it drives into, and
// every agent plans again when the grid changed.
//
//     left mouse        the target
//     right mouse       paint the terrain chosen with 1 .. 5 (floor, wall, water, low wall, breakable)
//     Tab               the next agent (its nodes and path are highlighted)
//     N                 its nodes on/off
//     S                 separation on/off (agents steer away from the others near them; the
//                       white lines: each one's push)
//     middle mouse      pan, wheel zoom

const byte NAV_FLOOR = 0;
const byte NAV_WALL = 1;
const byte NAV_WATER = 2;
const byte NAV_LOW_WALL = 3;
const byte NAV_BREAKABLE = 4;
const float NAV_TILE = 16;
const float NAV_SPEED = 70;               // px/s

// '.' floor, '#' wall, '~' water, 'l' low wall, 'b' breakable wall
[string, 28] NAV_MAP = [
    "################################################",
    "#..............#...............#...............#",
    "#..............#...............#...............#",
    "#...~~~~~~.....#.......#.......#.....lllll.....#",
    "#...~~~~~~.....#.......#.......#.....l...l.....#",
    "#...~~~~~~.....b.......#.......b.....l...l.....#",
    "#...~~~~~~.....b.......#.......b.....lllll.....#",
    "#..............b.......#.......b...............#",
    "#..............#.......#.......#...............#",
    "#..............#.......#.......#...............#",
    "######...#######...######...####.....####...####",
    "#..............................................#",
    "#..............................................#",
    "#..............................................#",
    "#.......###########.........~~~~~~~~...........#",
    "#.......#.........#.........~~~~~~~~...........#",
    "#.......#....#....#.........~~~~~~~~...........#",
    "#.......#....#....#.........~~~~~~~~...........#",
    "#.......#.........#............................#",
    "#.......####.######............................#",
    "#..............................#bbbbbbbbbbb#...#",
    "#..............................#...........#...#",
    "#.....~~~~~~~~~~~~.............#...........#...#",
    "#.....~~~~~~~~~~~~.............#...........#...#",
    "#.....~~~~~~~~~~~~.............#...........#...#",
    "#..............................#############...#",
    "#..............................................#",
    "################################################",
];

struct NavAgent {
    string name;
    int profile;
    int size;                      // 1 .. 3 tiles
    Vec2 pos;
    Color color;
    bool breaksWalls;              // the ram: breakable walls it touches break
    int nav;                       // its agent in the scheduler
    Vec2 push;                     // its separation this frame (drawn)
}

struct NavScene {
    NavGrid nav;
    NavScheduler planner;
    int ground;
    int boat;
    int flyer;
    int ram;
    List[NavAgent] agents;
    Vec2 target;
    byte brush;
    int selected;
    bool showsNodes = true;
    bool separates = true;         // S
}

extend NavScene {
    init() {
        nav = NavGrid(NAV_MAP[0].len, NAV_MAP.len, NAV_TILE);
        for (let y in 0..NAV_MAP.len) {
            for (let x in 0..NAV_MAP[y].len) {
                let c = NAV_MAP[y][x];
                nav.Set(x, y, c == '#' ? NAV_WALL : c == '~' ? NAV_WATER : c == 'l' ? NAV_LOW_WALL : c == 'b' ? NAV_BREAKABLE : NAV_FLOOR);
            }
        }
        ground = nav.AddProfile(NavProfile().With(NAV_FLOOR, 1));
        boat = nav.AddProfile(NavProfile().With(NAV_FLOOR, 1).With(NAV_WATER, 1.2));
        flyer = nav.AddProfile(NavProfile().With(NAV_FLOOR, 1).With(NAV_WATER, 1).With(NAV_LOW_WALL, 1));
        ram = nav.AddProfile(NavProfile().With(NAV_FLOOR, 1).With(NAV_BREAKABLE, 5));
        agents.Add(NavAgent("tiny, ground", ground, 1, Vec2(3, 2) * NAV_TILE, Color(0.4, 1, 0.4, 1)));
        agents.Add(NavAgent("medium, ground", ground, 2, Vec2(4, 9) * NAV_TILE, Color(0.3, 0.8, 1, 1)));
        agents.Add(NavAgent("big, ground", ground, 3, Vec2(10.5, 6.5) * NAV_TILE, Color(1, 0.9, 0.3, 1)));
        agents.Add(NavAgent("medium, boat", boat, 2, Vec2(3, 13) * NAV_TILE, Color(0.4, 0.5, 1, 1)));
        agents.Add(NavAgent("tiny, flying", flyer, 1, Vec2(3.5, 25.5) * NAV_TILE, Color(1, 0.5, 1, 1)));
        agents.Add(NavAgent("big, ram", ram, 3, Vec2(12.5, 2.5) * NAV_TILE, Color(1, 0.4, 0.3, 1), breaksWalls: true));
        planner = NavScheduler(&nav);
        for (let agent in agents) {
            agent.nav = planner.AddAgent(agent.profile, agent.size);
        }
        target = Vec2(40.5, 23.5) * NAV_TILE;
        brush = NAV_WALL;
    }

    void DoFrame() {
        Camera.isCentered = false;
        Camera.rotation = 0;
        Camera.allowPanning = true;
        Camera.allowZooming = true;
        let cursor = Input.cursors.world;
        if (Input.MousePressed(MouseButton.Left))
            target = cursor;
        for (let i in 0..5) {
            if (Input.KeyPressed((Scancode)((int)Scancode.Alpha1 + i)))
                brush = (byte)i;
        }
        if (Input.MouseDown(MouseButton.Right))
            nav.Set(nav.terrain.WorldToCell(cursor, NAV_TILE), brush);
        if (Input.KeyPressed(Scancode.Tab))
            selected = (selected + 1) % agents.len;
        if (Input.KeyPressed(Scancode.N))
            showsNodes = !showsNodes;
        if (Input.KeyPressed(Scancode.S))
            separates = !separates;

        // Every agent asks every frame; the scheduler plans what is needed
        let dt = Input.deltaTime;
        for (let agent in agents) {
            planner.Request(agent.nav, agent.pos, target);
        }
        planner.Update(dt);
        // Where the others are (separation: agents on the same path keep apart)
        let positions = temp List[Vec2]();
        for (let agent in agents) {
            positions.Add(agent.pos);
        }
        for (let agent in agents) {
            let heading = planner.NextWaypoint(agent.nav, agent.pos, 1);
            let toward = heading - agent.pos;
            let distance = toward.Length();
            if (distance < 0.01)
                continue;
            let direction = toward / distance;
            // Away from every other agent within its size + 1 tiles (its own position is skipped)
            agent.push = separates ? NavSeparation(agent.pos, (agent.size + 1) * NAV_TILE, positions) : Vec2(0, 0);
            let steer = (direction + agent.push * 0.8).NormalizedOr(direction);
            let step = Min(NAV_SPEED * dt, distance);
            // Only where it still fits (this scene has no collision world): else along its path
            let moved = agent.pos + steer * step;
            if (!nav.IsWalkable(agent.profile, agent.size, nav.NodeAt(agent.size, moved)))
                moved = agent.pos + direction * step;
            agent.pos = moved;
            if (agent.breaksWalls)
                BreakWalls(agent);
        }
        if (planner.stuckReplans > 0)
            Draw.LogLine("stuck and planned again: {planner.stuckReplans}");

        Render(cursor);
        Draw.LogLine("navigation scene (F4): left mouse target, right mouse paint {BrushName(brush)} (1 floor, 2 wall, 3 water, 4 low wall, 5 breakable), Tab agent, N nodes, S separation ({separates}), middle mouse pan, wheel zoom");
        if (planner.plansLastFrame > 0)
            Draw.LogSticky(60, Color.White, "planned {planner.plansLastFrame} path(s) in {planner.timeLastFrame * 1000:F3} ms ({planner.waiting} waiting)");
        for (let i, agent in agents) {
            let path = planner.PathOf(agent.nav);
            if (path == null)
                continue;
            Draw.LogLineColored(agent.color, "{i == selected ? "> " : "  "}{agent.name}: {path.reachesTarget ? "reaches the target" : "to the nearest point"}",
                ", {path.waypoints.len} waypoints, cost {path.cost:F1}");
        }
    }

    // The ram's block breaks the breakable walls it overlaps
    void BreakWalls(NavAgent* agent) {
        let half = agent.size * 0.5 * NAV_TILE + 1;
        let cells = nav.terrain.WorldRectToCells(Rect(agent.pos - Vec2(half), Vec2(2 * half)), NAV_TILE);
        for (let y in cells.y..cells.y + cells.h) {
            for (let x in cells.x..cells.x + cells.w) {
                if (nav.terrain.TryGet(x, y, NAV_FLOOR) == NAV_BREAKABLE)
                    nav.Set(x, y, NAV_FLOOR);
            }
        }
    }

    string BrushName(byte kind) {
        return kind == NAV_FLOOR ? "floor" : kind == NAV_WALL ? "wall" : kind == NAV_WATER ? "water" : kind == NAV_LOW_WALL ? "low wall" : "breakable";
    }

    Color TerrainColor(byte kind) {
        return kind == NAV_FLOOR ? Color(0.16, 0.16, 0.18, 1) : kind == NAV_WALL ? Color(0.45, 0.45, 0.5, 1) : kind == NAV_WATER ? Color(0.15, 0.25, 0.55, 1)
            : kind == NAV_LOW_WALL ? Color(0.4, 0.33, 0.22, 1) : Color(0.6, 0.35, 0.15, 1);
    }

    void Render(Vec2 cursor) {
        let region = Camera.viewportRect;
        let cells = nav.terrain.WorldRectToCells(region, NAV_TILE);
        for (let y in Max(cells.y, 0)..Min(cells.y + cells.h + 1, nav.h)) {
            for (let x in Max(cells.x, 0)..Min(cells.x + cells.w + 1, nav.w)) {
                Draw.Rect(nav.terrain.CellToWorldRect(Vec2i(x, y), NAV_TILE), 1, TerrainColor(nav.terrain.Get(x, y)));
            }
        }
        let chosen = &agents[selected];
        if (showsNodes)
            nav.DrawNodes(chosen.profile, chosen.size, region, 2);
        for (let i, agent in agents) {
            let half = agent.size * 0.5 * NAV_TILE;
            Draw.Rect(Rect(agent.pos - Vec2(half), Vec2(2 * half)), 4, Color(agent.color.r * 0.6, agent.color.g * 0.6, agent.color.b * 0.6, 0.8));
            let pathColor = i == selected ? agent.color : Color(agent.color.r, agent.color.g, agent.color.b, 0.35);
            if (let path = planner.PathOf(agent.nav))
                path.Draw(agent.pos, i == selected ? 6 : 5, pathColor);
            if (separates && agent.push != Vec2(0, 0))
                Draw.Line(agent.pos, agent.pos + agent.push * 2 * NAV_TILE, 1.5, 7, Color.White);
        }
        // The target and the cursor's cell
        Draw.Line(target - Vec2(5, 5), target + Vec2(5, 5), 1.5, 7, Color.White);
        Draw.Line(target - Vec2(5, -5), target + Vec2(5, -5), 1.5, 7, Color.White);
        let cell = nav.terrain.WorldToCell(cursor, NAV_TILE);
        let box = nav.terrain.CellToWorldRect(cell, NAV_TILE);
        Draw.Rect(box, 3, Color(1, 1, 1, 0.15));
    }
}
