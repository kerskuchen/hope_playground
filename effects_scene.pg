// The effects scene (F10): hope's visual effects (effects.pg) on the fixed canvas. The
// antennas: one on the mouse cursor (shake it), one on Susi's turret (WASD drives her, the turret
// follows the mouse; the antenna on the turret's attachment point 3), and a row on a platform
// that drives stop and go, each with another feel (left to right: a slow loose spring, the
// default, a stiffer one, one that does not overshoot). 1: a gusty wind from the left.
// Debris: a click throws chips of rock and wood all around (Burst); the right button metal chips
// from Susi's turret the way it aims (BurstProps: a narrow cone, low and fast, bouncy); they
// bounce off the ground, the walls around and the two pillars, roll out, rest and turn into decals.
// Particles: a campfire (orange and additive, turning late into dark grey smoke that fades),
// embers rising from it, Susi's exhaust while she drives (puffs fading in and out), sparks with
// the right button's shot (falling, skipping off the ground). 2: a blast at the cursor, its wave
// moving the smoke, flicking the antennas, throwing the debris again; 3: a rocket from the turret
// to the mouse, its smoke trail lingering (each puff at its own depth: behind a pillar where it
// is behind it), a blast where it lands. The campfire is burning already (Prewarm). 4: the stress
// test (2000, 4000, 8000 particles at once, timed; 5: y-sorted);
// curves shape how each value goes from its start to its end.

Vec2 effectsPlatform = Vec2(80, 140);              // where the row's platform drives around
Vec2 effectsCampfire = Vec2(50, 80);

struct EffectsScene {
    AnimationPlayer tracksAnim;
    Sprite3D* turret;
    Vec2 tankPos = Vec2(200, 100);
    float tankAngle;
    float turretAngle;
    Antenna turretAntenna;
    Antenna cursorAntenna;
    [Antenna, 4] row;
    float time;
    bool isWindy;
    CollisionWorld* walls;             // the arena's border and two pillars
    [Box, 6] wallBoxes;
    Decalmap decals;
    DebrisField debris;
    Sprite* chip;                      // (a plain rectangle: the untextured sprite, scaled)
    ParticleSystem fire;
    ParticleSystem exhaust;
    ParticleSystem sparks;
    ParticleSystem embers;
    ParticleSystem blast;              // a blast's fireball: hot bits all around
    ParticleSystem trail;              // a rocket's smoke, lingering (each puff at its own depth)
    ParticleSystem crowd;              // the stress test (4): thousands at once, every feature on
    int crowdCount;
    bool isCrowdSorted;
    double crowdUpdateMs;              // (smoothed over frames)
    double crowdDrawMs;
    ParticleEmitter rocketExhaust;
    bool isRocketFlying;
    Vec3 rocketPos;
    Vec2 rocketTarget;
    Shockwaves waves;
    ParticleEmitter campfire;
    ParticleEmitter emberSource;
    ParticleEmitter exhaustPipe;
}

extend EffectsScene {
    init() {
        tracksAnim = AnimationPlayer(Draw.GetAnim("susi.run"));
        turret = Draw.GetSprite3D("susi_turret");
        turretAntenna = Antenna(length: 5);
        cursorAntenna = Antenna(length: 18, tipColor: Color(0.4, 0.9, 1, 1));
        // (frequency, damping)
        row[0] = Antenna(frequency: 2, damping: 0.1);
        row[1] = Antenna();
        row[2] = Antenna(frequency: 5, damping: 0.4);
        row[3] = Antenna(frequency: 3, damping: 1);
        Camera.pos = Vec2(160, 90);
        Camera.isCentered = true;
        // The walls: the border (below the log's lines) and two pillars
        wallBoxes[0] = Box(Vec2(0, 30), Vec2(320, 34));
        wallBoxes[1] = Box(Vec2(0, 176), Vec2(320, 180));
        wallBoxes[2] = Box(Vec2(0, 30), Vec2(4, 180));
        wallBoxes[3] = Box(Vec2(316, 30), Vec2(320, 180));
        wallBoxes[4] = Box(Vec2(110, 60), Vec2(126, 84));
        wallBoxes[5] = Box(Vec2(240, 50), Vec2(264, 62));
        walls = New[CollisionWorld](Box(Vec2(0, 0), Vec2(320, 180)), 32);
        for (let box in wallBoxes) {
            walls.Add(Collider(ColliderShape.Box(box: *box), 1, 0));
        }
        decals = Decalmap(320, 180, depth: 2);
        debris = DebrisField(world: walls, mask: 1, decals: &decals);
        chip = Draw.GetSprite("untextured");
        // Particles: a soft round glow (128 px) shrunk
        let glow = Draw.GetSprite("light_torch");
        // The fire: orange and additive, late (then quickly) dark grey smoke, normal; it grows
        // fast at first, slows down rising, fades early (the smoke thin); the drag slows a
        // blast's push
        let late = Curve.Keys([Vec2(0, 0), Vec2(0.3, 0.05), Vec2(0.55, 1)]);
        fire = ParticleSystem(ParticleProps(sprite: glow, lifetime: Between(1.2, 1.8), spread: 180, elevation: Between(75, 90), radius: Between(0, 3),
            startSpeed: Between(26, 34), endSpeed: Between(6, 10), speedCurve: Curve.EaseOut(),
            startSize: Between(0.05, 0.07), endSize: Between(0.15, 0.21), sizeCurve: Curve.EaseOut(),
            startOpacity: 1, endOpacity: 0, opacityCurve: Curve.EaseOut(1.5),
            startColor: ColorBetween(Color(1, 0.45, 0.1, 1), Color(1, 0.8, 0.25, 1)), endColor: ColorBetween(Color(0.3, 0.29, 0.29, 1), Color(0.4, 0.39, 0.39, 1)), colorCurve: late,
            startAdditivity: 1, endAdditivity: 0, additivityCurve: late, drag: 2, light: LightMode.Unlit));
        // The exhaust: puffs that pop up (fast to their size), fade in and out
        exhaust = ParticleSystem(ParticleProps(sprite: glow, lifetime: Between(0.6, 0.9), elevation: Between(50, 80), startSpeed: Between(10, 16), endSpeed: 4,
            startSize: 0.02, endSize: Between(0.07, 0.1), sizeCurve: Curve.EaseOut(3), startOpacity: 0, endOpacity: 0.7,
            opacityCurve: Curve.Keys([Vec2(0, 0), Vec2(0.15, 1), Vec2(1, 0)]), startColor: Color(0.45, 0.45, 0.48, 1), endColor: Color(0.3, 0.3, 0.32, 1), drag: 2));
        // Sparks: fast and slowing, falling (gravity), skipping off the ground
        sparks = ParticleSystem(ParticleProps(sprite: glow, lifetime: Between(0.4, 0.8), spread: 25, elevation: Between(5, 35), startSpeed: Between(120, 200), endSpeed: Between(10, 30),
            speedCurve: Curve.EaseOut(), startSize: Between(0.03, 0.04), endSize: 0.015, startOpacity: 1, endOpacity: 0.3,
            startColor: ColorBetween(Color(1, 0.95, 0.6, 1), Color(1, 0.7, 0.3, 1)), endColor: Color(1, 0.35, 0.1, 1), startAdditivity: 1, endAdditivity: 1,
            gravity: 400, drag: 1, groundBounce: 0.4, light: LightMode.Unlit), capacity: 200);
        // Embers: single pixels, rising from the fire (negative gravity; the drag keeps them at 15 .. 25
        // px/s), swirling wider as they rise (a corkscrew each, turning either way), glowing out
        embers = ParticleSystem(ParticleProps(sprite: chip, lifetime: Between(1.5, 2.5), radius: Between(0, 4), elevation: Between(20, 60), startSpeed: Between(5, 15), endSpeed: 0,
            startSize: 1 / chip.dim.x, endSize: 1 / chip.dim.x, rotation: 0, startOpacity: 1, endOpacity: 0, opacityCurve: Curve.EaseIn(),
            startColor: ColorBetween(Color(1, 0.85, 0.4, 1), Color(1, 0.55, 0.15, 1)), endColor: Color(0.9, 0.25, 0.05, 1), startAdditivity: 1, endAdditivity: 1,
            gravity: Between(-50, -30), drag: 2, startWobble: 0, endWobble: Between(2, 5), wobbleCurve: Curve.EaseOut(), wobbleSpeed: Between(0.4, 1.2), light: LightMode.Unlit), capacity: 100);
        // A blast: hot bits all around, fast and slowing hard, orange to dark red
        blast = ParticleSystem(ParticleProps(sprite: glow, lifetime: Between(0.3, 0.6), spread: 180, elevation: Between(0, 50), startSpeed: Between(60, 130), endSpeed: 0,
            speedCurve: Curve.EaseOut(3), startSize: Between(0.06, 0.1), endSize: 0.02, startOpacity: 1, endOpacity: 0, opacityCurve: Curve.EaseIn(),
            startColor: ColorBetween(Color(1, 0.9, 0.5, 1), Color(1, 0.6, 0.2, 1)), endColor: Color(0.95, 0.35, 0.05, 1), startAdditivity: 1, endAdditivity: 1,
            gravity: 60, waveResponse: 0, light: LightMode.Unlit), capacity: 200);
        // A rocket's trail: puffs that grow, linger and fade slowly, drifting a little (a sway)
        trail = ParticleSystem(ParticleProps(sprite: glow, lifetime: Between(2.5, 3.5), spread: 180, elevation: Between(-20, 60), startSpeed: Between(3, 8), endSpeed: 1,
            startSize: 0.03, endSize: Between(0.09, 0.13), sizeCurve: Curve.EaseOut(2), startOpacity: Between(0.4, 0.6), endOpacity: 0, opacityCurve: Curve.EaseIn(),
            startColor: Color(0.75, 0.73, 0.7, 1), endColor: Color(0.4, 0.4, 0.42, 1), gravity: -3, drag: 1.5, endWobble: Between(0, 2), wobbleSpeed: Between(0.1, 0.3)), capacity: 400);
        rocketExhaust = ParticleEmitter(rate: 70);
        // The stress test: smoke all over the arena, fading in and out, rising, swirling
        crowd = ParticleSystem(ParticleProps(sprite: glow, lifetime: Between(2, 4), radius: Between(0, 150), elevation: Between(20, 90), startSpeed: Between(1, 4), endSpeed: 0,
            startSize: 0.03, endSize: 0.07, sizeCurve: Curve.EaseOut(), startOpacity: 0, endOpacity: 0.5, opacityCurve: Curve.Keys([Vec2(0, 0), Vec2(0.2, 1), Vec2(1, 0)]),
            startColor: Color(0.5, 0.5, 0.55, 1), endColor: Color(0.3, 0.3, 0.35, 1), gravity: Between(-12, -4), drag: 1, endWobble: Between(1, 3), wobbleSpeed: Between(0.2, 0.6)), capacity: 8000);
        // Everything reacts to the blasts' waves
        crowd.waves = &waves;
        trail.waves = &waves;
        fire.waves = &waves;
        exhaust.waves = &waves;
        embers.waves = &waves;
        sparks.waves = &waves;
        debris.waves = &waves;
        turretAntenna.waves = &waves;
        cursorAntenna.waves = &waves;
        for (let antenna in row) {
            antenna.waves = &waves;
        }
        campfire = ParticleEmitter(rate: 45);
        emberSource = ParticleEmitter(rate: 12);
        // (burning already when the scene shows)
        campfire.Prewarm(&fire, Vec3(effectsCampfire.x, effectsCampfire.y, 1), 2);
        emberSource.Prewarm(&embers, Vec3(effectsCampfire.x, effectsCampfire.y, 3), 2);
        exhaustPipe = ParticleEmitter(rate: 30);
    }

    void DoFrame() {
        let dt = Input.deltaTime;
        time += dt;
        waves.Update();                // (before everything that reacts to them)
        if (playground.settings.showsHints)
            Draw.LogLine("effects scene (F10): antennas: on the mouse, on Susi's turret (WASD drives, the turret aims at the mouse), a row stop and go (loose, default, stiff, no overshoot); 1 wind ({isWindy}), 2 a blast at the mouse, 3 a rocket to it");
        let cursor = Input.cursors.world;
        if (Input.KeyPressed(Scancode.Alpha1))
            isWindy = !isWindy;
        // (gusts: two slow waves over a steady breeze from the left)
        let wind = isWindy ? Vec2(70 + Sin(time * 1.3) * 40 + Sin(time * 3.7) * 20, Sin(time * 0.7) * 15) : Vec2.Zero;
        turretAntenna.wind = wind;
        cursorAntenna.wind = wind;
        for (let antenna in row) {
            antenna.wind = wind;
        }

        // Susi: drives, the turret aims at the mouse; the antenna's base on the turret's
        // attachment point 3 (else behind its middle), on top of the turret: raised 4 px, then
        // its layers
        let move = Input.ActionValue2D("move");
        tankPos = Vec2(Clamp(tankPos.x + move.x * 70 * dt, 10.0, 310.0), Clamp(tankPos.y + move.y * 70 * dt, 20.0, 175.0));
        if (move.Length() > 0.1) {
            tankAngle = move.Angle();
            tracksAnim.Update();
        }
        turretAngle = (cursor - tankPos).Angle();
        let turretXform = Transform(tankPos - Vec2(0, 4), turretAngle);
        let onGround = Transform(tankPos, turretAngle);
        let mount = turret.layers.len > 0 && turret.layers[0].attachmentPoints.len > 3
            ? turret.layers[0].GetAttachmentPos(3, onGround)
            : tankPos + Vec2.FromAngle(turretAngle) * -3;
        turretAntenna.Update(Vec3(mount.x, mount.y, 4 + turret.layers.len));
        cursorAntenna.Update(Vec3(cursor.x, cursor.y, 0));
        // Debris: a click throws rock chips and wood splinters from the cursor
        if (Input.MousePressed(MouseButton.Left)) {
            debris.Burst(Vec3(cursor.x, cursor.y, 6), 10, 130, chip, Color(0.55, 0.52, 0.5, 1), Vec2(3, 3) / chip.dim);
            debris.Burst(Vec3(cursor.x, cursor.y, 6), 6, 150, chip, Color(0.6, 0.4, 0.22, 1), Vec2(5, 2) / chip.dim);
        }
        if (Input.MousePressed(MouseButton.Right)) {
            let muzzle = tankPos + Vec2.FromAngle(turretAngle) * 8;
            sparks.props.direction = turretAngle;
            sparks.Emit(Vec3(muzzle.x, muzzle.y, 6), 16);
            debris.Burst(Vec3(muzzle.x, muzzle.y, 6), chip, BurstProps(count: 14, direction: turretAngle, spread: 20, elevation: Between(5, 35), speed: Between(150, 260),
                scale: Vec2(2, 2) / chip.dim, bounciness: Between(1.1, 1.5), color: ColorBetween(Color(0.55, 0.6, 0.7, 1), Color(0.9, 0.55, 0.25, 1))));
        }
        // A blast at the cursor (2): its fireball, chips, the wave through everything
        if (Input.KeyPressed(Scancode.Alpha2)) {
            blast.Emit(Vec3(cursor.x, cursor.y, 3), 40);
            debris.Burst(Vec3(cursor.x, cursor.y, 4), 8, 160, chip, Color(0.3, 0.28, 0.27, 1), Vec2(2, 2) / chip.dim);
            waves.Add(Shockwave(center: cursor));
        }
        // A rocket from the turret to the mouse (3): its trail, a blast where it lands
        if (Input.KeyPressed(Scancode.Alpha3) && !isRocketFlying) {
            let muzzle = tankPos + Vec2.FromAngle(turretAngle) * 8;
            rocketPos = Vec3(muzzle.x, muzzle.y, 6);
            rocketTarget = cursor;
            rocketExhaust = ParticleEmitter(rate: 70);
            isRocketFlying = true;
        }
        if (isRocketFlying) {
            let ground = Vec2(rocketPos.x, rocketPos.y);
            let toTarget = rocketTarget - ground;
            let step = 160 * dt;
            if (toTarget.Length() <= step) {
                isRocketFlying = false;
                blast.Emit(Vec3(rocketTarget.x, rocketTarget.y, 3), 40);
                debris.Burst(Vec3(rocketTarget.x, rocketTarget.y, 4), 8, 160, chip, Color(0.3, 0.28, 0.27, 1), Vec2(2, 2) / chip.dim);
                waves.Add(Shockwave(center: rocketTarget));
            } else {
                let next = ground + toTarget.Normalized() * step;
                rocketPos = Vec3(next.x, next.y, 6);
                rocketExhaust.Update(&trail, rocketPos);
            }
        }
        // The stress test (4: none, 2000, 4000, 8000 at once; 5: y-sorted or one depth): as many
        // born as went, timed
        if (Input.KeyPressed(Scancode.Alpha4)) {
            crowdCount = crowdCount == 0 ? 2000 : crowdCount == 2000 ? 4000 : crowdCount == 4000 ? 8000 : 0;
            crowd.Clear();
        }
        if (Input.KeyPressed(Scancode.Alpha5))
            isCrowdSorted = !isCrowdSorted;
        if (crowdCount > 0) {
            crowd.Emit(Vec3(160, 105, 0), crowdCount - crowd.count);
            let timer = PerformanceTimer();
            crowd.Update();
            crowdUpdateMs = crowdUpdateMs * 0.95 + timer.PeekTime() * 1000 * 0.05;
            if (playground.settings.showsHints)
                Draw.LogLine("stress: update {Round((float)crowdUpdateMs * 100) / 100} ms, draw {Round((float)crowdDrawMs * 100) / 100} ms, end frame {Round((float)Draw.stats.endFrameSeconds * 100000) / 100} ms; {crowd.count}{isCrowdSorted ? " y-sorted" : " one depth"} (4 more, 5 sort)");
        }
        blast.Update();
        trail.Update();
        debris.Update();
        // Particles: the campfire always, the exhaust while Susi drives (from behind her, low)
        campfire.Update(&fire, Vec3(effectsCampfire.x, effectsCampfire.y, 1));
        emberSource.Update(&embers, Vec3(effectsCampfire.x, effectsCampfire.y, 3));
        if (move.Length() > 0.1) {
            let pipe = tankPos - Vec2.FromAngle(tankAngle) * 8;
            exhaust.props.direction = tankAngle + 180;
            exhaustPipe.Update(&exhaust, Vec3(pipe.x, pipe.y, 3));
        } else {
            exhaustPipe.isStarted = false;
        }
        fire.Update();
        exhaust.Update();
        sparks.Update();
        embers.Update();
        if (playground.settings.showsHints)
            Draw.LogLine("particles (a campfire, Susi's exhaust while she drives, sparks with the right click): {fire.count} fire, {exhaust.count} exhaust, {sparks.count} sparks, {embers.count} embers");
        if (playground.settings.showsHints)
            Draw.LogLine("debris (click: around, right click: from the turret): flying {debris.CountOf(DebrisState.Flying)}, rolling {debris.CountOf(DebrisState.Rolling)}, resting {debris.CountOf(DebrisState.Resting)}, decals waiting {decals.pendingCount}");
        // The platform: drives right and back at a constant speed, starting and stopping at
        // once at each end (a jolt each time)
        let phase = (time % 4) / 4;
        let along = phase < 0.4 ? phase / 0.4 : phase < 0.5 ? 1 : phase < 0.9 ? 1 - (phase - 0.5) / 0.4 : 0;
        let platform = effectsPlatform + Vec2(along * 140, 0);
        for (let index, antenna in row) {
            antenna.Update(Vec3(platform.x + index * 12, platform.y, 2));
        }

        // Drawn by where they stand (y)
        DrawGround();
        decals.Draw(Camera.viewportRect);
        for (let box in wallBoxes) {
            Draw.Rect(box.ToRect(), DepthAt(box.max.y), DrawParams(color: Color(0.3, 0.3, 0.36, 1)));
        }
        debris.Draw((float y) => DepthAt(y));
        Draw.Rect(Rect(platform - Vec2(6, 2), Vec2(48, 5)), DepthAt(platform.y), DrawParams(color: Color(0.35, 0.33, 0.4, 1)));
        for (let antenna in row) {
            antenna.Draw(DepthAt(platform.y) + 0.5);
        }
        let depth = DepthAt(tankPos.y + 5);
        Draw.Sprite3D(tracksAnim.CurSprite3D(), Transform(tankPos, tankAngle), depth);
        Draw.Sprite3D(turret, turretXform, depth + 1);
        turretAntenna.Draw(depth + 2);
        // The campfire's logs, its fire above them; the exhaust just behind Susi, the sparks
        // above everything (each system one depth)
        Draw.Rect(Rect(effectsCampfire - Vec2(5, 1), Vec2(10, 3)), DepthAt(effectsCampfire.y), DrawParams(color: Color(0.4, 0.26, 0.15, 1)));
        fire.Draw(DepthAt(effectsCampfire.y) + 0.5);
        embers.Draw(DepthAt(effectsCampfire.y) + 0.6);
        exhaust.Draw((float y) => DepthAt(y));
        trail.Draw((float y) => DepthAt(y));
        if (crowdCount > 0) {
            let timer = PerformanceTimer();
            if (isCrowdSorted)
                crowd.Draw((float y) => DepthAt(y));
            else
                crowd.Draw(DepthAt(105));
            crowdDrawMs = crowdDrawMs * 0.95 + timer.PeekTime() * 1000 * 0.05;
        }
        if (isRocketFlying) {
            Draw.Rect(Rect(rocketPos.screen - Vec2(1, 1), Vec2(2, 2)), DepthAt(rocketPos.y), DrawParams(color: Color(0.85, 0.85, 0.9, 1)));
            Draw.Sprite(Draw.GetSprite("light_torch"), Transform(rocketPos.screen - Vec2(4, 4), 0, Vec2(0.06, 0.06)), DepthAt(rocketPos.y) + 0.01, DrawParams(color: Color(1, 0.6, 0.2, 1), additivity: Additivity.Max, light: LightMode.Unlit));
        }
        sparks.Draw(Depth.Nearest - 2);
        blast.Draw(Depth.Nearest - 2);
        cursorAntenna.Draw(Depth.Nearest - 1);
    }

    // The scene goes: the decal map's atlas regions back, the particles' memory (the rest is in
    // the level phase)
    void Leave() {
        decals.Free();
        fire.Free();
        exhaust.Free();
        sparks.Free();
        embers.Free();
        blast.Free();
        trail.Free();
        crowd.Free();
        waves.Free();
    }

    // (y on the ground as the depth: nearer the bottom, nearer the viewer)
    static float DepthAt(float y) { return 10 + y * 0.1; }

    // A dotted floor: the motion shows against it
    void DrawGround() {
        let dots = DrawParams(color: Color(0.22, 0.22, 0.26, 1));
        for (let y = 10; y < 180; y += 16) {
            for (let x = 8; x < 320; x += 16) {
                Draw.Pixel(Vec2(x, y), 1, dots);
            }
        }
    }
}
