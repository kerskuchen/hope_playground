////////////////////////////////////////////////////////////////////////////////////////////////////
// The playground's entities (hope's entities.pg): placed in a level's Entities layer with the
// level editor, run by the level scene's preview (level_scene.pg), each with its DrawPreview for
// the editor.
//
//     Brazier   a fire: its light's radius, color and flicker
//     Turret    turns to its target (an EntityRef, else the nearest ghost in range) and shoots;
//               its bullets find what they hit through the collision world (Collider.entity) and
//               damage its Health
//     Spawner   lets ghosts out (at most so many at once), slow or fast ones
//     Ghost     (spawned, not placed) sleeps until a "wake" signal (the preview's probe sends it to
//               the ones near it: Signals.SendNear), then wanders a while; fades; 3 hits and it is gone
//     Door      opens on "open" (an area's signal, a lever's), closes on "close": it sends itself
//               one, delayed (closeAfter)
//     Lever     a click in the preview pulls it: its SignalLink (wired in the editor) is sent

// The collision world the entities' colliders are in (the level scene's preview makes it)
CollisionWorld* entityWorld = null;

// A sprite centered on 'pos' (its pivot taken into account), scaled
void DrawCentered(Sprite* sprite, Vec2 pos, float scale, float depth, DrawParams drawParams = DrawParams()) {
    Draw.Sprite(sprite, Transform(pos - (sprite.dim * 0.5 - sprite.pivot) * scale, 0, Vec2(scale, scale)), depth, drawParams);
}

const uint LAYER_GHOST = 2;
int ghostsGone = 0;                    // (the preview's line)

struct Health {
    int hp = 3;
    int max = 3;
}

extend Health {
    get bool isDead() { return hp <= 0; }
    void Damage(int amount) { hp = Max(0, hp - amount); }
}

//--------------------------------------------------------------------------------------------------

struct Brazier : Entity {
    @Editable @Range(8, 96) float radius = 32;
    @Editable Color color = Color(1, 0.7, 0.35, 1);
    @Editable @Range(0, 4) float flicker = 1;
    @Editable bool isLit = true;
    float time;
}

extend Brazier {
    void DoFrame() { time += Input.deltaTime; }

    void Draw() {
        global.Draw.Rect(Rect(xform.pos - Vec2(3, 1), Vec2(6, 4)), 30, DrawParams(color: Color(0.25, 0.15, 0.1, 1)));
        if (!isLit)
            return;
        // (the glow: the light sprite, its size breathing with the flicker)
        let wobble = 1 + Sin(time * 9) * 0.06 * flicker + Sin(time * 23) * 0.03 * flicker;
        let glow = global.Draw.GetSprite("light_torch");
        let scale = radius * 2 / Max(1.0, glow.dim.x) * wobble;
        DrawCentered(glow, xform.pos, scale, 31, DrawParams(color: Color(color.r * 0.5, color.g * 0.5, color.b * 0.5, 0), additivity: Additivity.Max));
        global.Draw.Circle(xform.pos - Vec2(0, 2), 2 * wobble, 32, DrawParams(color: color));
    }

    // (the editor: the fire, its radius as a ring)
    void DrawPreview() {
        Draw();
        global.Draw.CircleOutline(Circle(xform.pos, radius), 1, 33, DrawParams(color: Color(color.r, color.g, color.b, 0.6)));
    }
}

//--------------------------------------------------------------------------------------------------

struct Turret : Entity {
    // (it aims its xform's angle: turned in the editor with Q/E, the way it looks at the start)
    @Editable @Range(16, 200) float range = 90;
    @Editable @Range(10, 360) float turnSpeed = 120;      // degrees a second
    @Editable @Range(0.1, 2) float fireInterval = 0.4;
    @Editable EntityRef target;                            // (none: the nearest ghost in range)
    List[Bullet] bullets;
    float cooldown;
}

struct Bullet {
    Vec2 pos;
    Vec2 velocity;
    float life;
}

extend Turret {
    void DoFrame() {
        let dt = Input.deltaTime;
        // What it aims at: its target, else the nearest ghost in range
        Entity* aim = target.Resolve();
        if (aim == null) {
            let nearest = range;
            for (let ghost in Entities.All[Ghost]()) {
                let distance = (ghost.xform.pos - xform.pos).Length();
                if (ghost.isAlive && distance < nearest) {
                    nearest = distance;
                    aim = &ghost.Entity;
                }
            }
        }
        cooldown -= dt;
        if (aim != null && (aim.xform.pos - xform.pos).Length() <= range) {
            let turn = NormalizeAngle((aim.xform.pos - xform.pos).Angle() - xform.angle);
            let step = turnSpeed * dt;
            xform.angle += Clamp(turn, -step, step);
            if (Abs(turn) < 5 && cooldown <= 0) {
                cooldown = fireInterval;
                let direction = Vec2.FromAngle(xform.angle);
                bullets.Add(Bullet(xform.pos + direction * 8, direction * 160, range / 160));
            }
        }
        // The bullets: what they touch (a ghost's collider) is found as an entity, its Health hit
        for (let index = bullets.len - 1; index >= 0; index--) {
            let bullet = &bullets[index];
            bullet.pos = bullet.pos + bullet.velocity * dt;
            bullet.life -= dt;
            let hasHit = false;
            if (entityWorld != null) {
                entityWorld.ForEachOverlap(ColliderShape.Circle(circle: Circle(bullet.pos, 2)), LAYER_GHOST, (WorldOverlap* found) => {
                    if (!hasHit && let entity = Entities.Get(found.entity) && entity.isAlive && let health = entity.Get[Health]()) {
                        health.Damage(1);
                        hasHit = true;
                    }
                });
            }
            if (hasHit || bullet.life <= 0)
                bullets.RemoveAt(index);
        }
    }

    void Draw() {
        global.Draw.Circle(xform.pos, 6, 30, DrawParams(color: Color(0.35, 0.35, 0.4, 1)));
        let direction = Vec2.FromAngle(xform.angle);
        global.Draw.Line(xform.pos, xform.pos + direction * 10, 3, 31, DrawParams(color: Color(0.75, 0.75, 0.8, 1)));
        for (let bullet in bullets) {
            global.Draw.Rect(Rect(bullet.pos - Vec2(1, 1), Vec2(2, 2)), 32, DrawParams(color: Color(1, 0.9, 0.5, 1)));
        }
    }

    // (the editor: the turret, its range, a line to its target)
    void DrawPreview() {
        Draw();
        global.Draw.CircleOutline(Circle(xform.pos, range), 1, 33, DrawParams(color: Color(0.9, 0.3, 0.3, 0.5)));
        // (in the editor Resolve finds the placed entity of that name)
        if (let aim = target.Resolve())
            global.Draw.Line(xform.pos, aim.xform.pos, 1, 33, DrawParams(color: Color(1, 0.94, 0.55, 0.7)));
    }
}

//--------------------------------------------------------------------------------------------------

enum GhostKind { Slow, Fast }

@Icon("ghosty_0")
struct Spawner : Entity {
    @Editable @Range(0.2, 5) float interval = 1.5;
    @Editable int maxCount = 4;
    @Editable @Range(0, 64) float radius = 16;
    @Editable GhostKind kind;
    float timer;
}

extend Spawner {
    void DoFrame() {
        timer -= Input.deltaTime;
        if (timer > 0)
            return;
        timer = interval;
        let count = 0;
        for (let ghost in Entities.All[Ghost]()) {
            if (ghost.isAlive && ghost.spawner == id)
                count++;
        }
        if (count >= maxCount)
            return;
        let ghost = Entities.Spawn[Ghost]();
        let angle = (float)(Random.Hash((ulong)(ghost.id.index * 7919 + Entities.count)) % 360);
        ghost.xform.pos = xform.pos + Vec2.FromAngle(angle) * radius;
        ghost.spawner = id;
        ghost.speed = kind == GhostKind.Fast ? 40 : 15;
        ghost.Prepare();
    }

    void Draw() {
        global.Draw.CircleOutline(Circle(xform.pos, 6), 2, 30, DrawParams(color: Color(0.6, 0.5, 0.9, 0.9)));
    }

    void DrawPreview() {
        Draw();
        global.Draw.CircleOutline(Circle(xform.pos, Max(1.0, radius)), 1, 33, DrawParams(color: Color(0.6, 0.5, 0.9, 0.5)));
        // (ghosty's animation at the time: a preview is made again every frame)
        let ghosty = AnimationPlayer(global.Draw.GetAnim("ghosty.default"));
        let duration = ghosty.current.duration;
        ghosty.curTime = (float)(platform.TimeSinceStartup() % (double)Max(0.001, duration));
        DrawCentered(ghosty.CurSprite(), xform.pos, 1, 31, DrawParams(color: Color(0.6, 0.6, 0.6, 0.6)));
    }
}

//--------------------------------------------------------------------------------------------------

// A ghost (spawned by a Spawner): asleep until woken ("wake"), then wanders toward a point near
// its spawner for a while; 3 hits and it is gone
@Receives("wake")
struct Ghost : Entity {
    EntityId spawner;
    float speed = 15;
    Health health;
    ColliderId body;
    Vec2 goal;
    float time;
    AnimationPlayer anim;              // ghosty.default
    float awake;                       // seconds it stays awake ("wake": again)
}

extend Ghost {
    void OnSignal(Signal* signal) {
        if (signal.name == "wake")
            awake = 3;
    }

    get bool isAwake() { return awake > 0; }

    void Prepare() {
        goal = xform.pos;
        anim = AnimationPlayer(global.Draw.GetAnim("ghosty.default"));
        anim.curTime = (float)(id.index % 7) * 0.1;      // (not all in step)
        if (entityWorld != null) {
            let collider = Collider(ColliderShape.Circle(circle: Circle(xform.pos, 5)), LAYER_GHOST, 0);
            collider.entity = id;
            body = entityWorld.Add(collider);
        }
    }

    void DoFrame() {
        let dt = Input.deltaTime;
        if (health.isDead) {
            Entities.Destroy(&self.Entity);
            return;
        }
        if (!isAwake)
            return;                    // (asleep: still)
        awake -= dt;
        time += dt;
        anim.Update();
        if ((goal - xform.pos).Length() < 2) {
            let home = Entities.Get(spawner);
            let center = home != null ? home.xform.pos : xform.pos;
            let angle = (float)(Random.Hash((ulong)(id.index * 104729 + (int)(time * 100))) % 360);
            goal = center + Vec2.FromAngle(angle) * 40;
        }
        let toGoal = goal - xform.pos;
        xform.pos = xform.pos + toGoal.Normalized() * Min(speed * dt, toGoal.Length());
        if (entityWorld != null)
            entityWorld.MoveTo(body, xform.pos);
    }

    void Draw() {
        let fade = 0.5 + 0.5 * health.hp / Max(1, health.max);
        // (asleep: bluish, dimmer)
        let tint = isAwake ? Color(fade, fade, fade, fade) : Color(0.35 * fade, 0.45 * fade, 0.8 * fade, fade);
        DrawCentered(anim.CurSprite(), xform.pos, 1, 30 + xform.pos.y * 0.01, DrawParams(color: tint));
    }

    // (its collider out of the world)
    void Destroyed() {
        if (entityWorld != null)
            entityWorld.Remove(body);
        ghostsGone++;
    }
}

//--------------------------------------------------------------------------------------------------

// A door across 'width' pixels (left to right through its position): "open" slides its halves apart, and it
// sends itself "close" after closeAfter seconds (0: it stays open); a "close" from someone else
// closes it at once
@Receives("open, close")
struct Door : Entity {
    @Editable @Range(8, 64) float width = 16;
    @Editable @Range(0, 10) float closeAfter = 2;
    bool isOpen;
    int opens;                         // (its own "close" carries the open it belongs to: an older one is ignored)
    float openness;                    // 0 closed .. 1 open
}

extend Door {
    void OnSignal(Signal* signal) {
        switch (signal.name) {
        case "open":
            isOpen = true;
            opens++;
            if (closeAfter > 0)
                Signals.Send(id, "close", from: id, value: opens, delay: closeAfter);
        case "close":
            if (signal.from != id || (int)signal.value == opens)
                isOpen = false;
        }
    }

    void DoFrame() {
        let target = isOpen ? 1.0 : 0.0;
        let step = Input.deltaTime * 3;
        openness = Clamp(openness + Clamp(target - openness, -step, step), 0, 1);
    }

    void Draw() {
        let half = width * 0.5;
        let slide = half * openness;
        let wood = DrawParams(color: Color(0.55, 0.36, 0.2, 1));
        let post = DrawParams(color: Color(0.3, 0.3, 0.35, 1));
        // (each half slides into its post)
        global.Draw.Rect(Rect(xform.pos.x - half - slide, xform.pos.y - 3, half, 6), 30, wood);
        global.Draw.Rect(Rect(xform.pos.x + slide, xform.pos.y - 3, half, 6), 30, wood);
        global.Draw.Rect(Rect(xform.pos.x - half - 3, xform.pos.y - 4, 3, 8), 31, post);
        global.Draw.Rect(Rect(xform.pos.x + half, xform.pos.y - 4, 3, 8), 31, post);
    }

    void DrawPreview() { Draw(); }
}

//--------------------------------------------------------------------------------------------------

// A lever: a click on it in the preview pulls it (back and forth), and its link is sent
struct Lever : Entity {
    @Editable SignalLink onPulled;
    bool isPulled;
}

extend Lever {
    void DoFrame() {
        if (Input.MousePressed(MouseButton.Left) && (Input.cursors.world - xform.pos).Length() <= 8) {
            isPulled = !isPulled;
            onPulled.Send(from: id);
        }
    }

    void Draw() {
        global.Draw.Rect(Rect(xform.pos - Vec2(5, 2), Vec2(10, 5)), 30, DrawParams(color: Color(0.3, 0.3, 0.35, 1)));
        let tip = xform.pos + (isPulled ? Vec2(5, -7) : Vec2(-5, -7));
        global.Draw.Line(xform.pos, tip, 2, 31, DrawParams(color: Color(0.75, 0.75, 0.8, 1)));
        global.Draw.Circle(tip, 2, 32, DrawParams(color: Color(0.9, 0.3, 0.25, 1)));
    }

    void DrawPreview() { Draw(); }
}
