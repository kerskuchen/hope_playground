////////////////////////////////////////////////////////////////////////////////////////////////////
// The level editor: a level of assets/levels/ (hope's level.pg: LevelData), edited on the free
// canvas (zoom out past 1x): every layer it shows (not the hidden ones), the tile grid; the middle
// mouse button pans, the wheel zooms; a panel lists the layers (click one to edit it), one has the
// tools and the tileset's palette, one the level (its files, its size, the camera bounds).
//
// A game (the playground's level scene) makes one for a level and lets it run its frames while it
// is open; the data is the editor's (a game makes its own presentation of it, a preview, a
// play-test), unsaved changes ask before they are lost (quitting, F5: GuardUnsaved every frame,
// AskAboutChanges before the game leaves it). Opening or making another level is a request
// (requestedLevel): the game makes a new editor for it, in a freshly wiped editor phase.
//
//     editor = New[LevelEditor]("castle");               // (the editor phase)
//     editor.Enter();                                    // the free canvas, its camera, its drawing
//     editor.DoFrame();                                  // every frame while it is open
//     editor.Leave();                                    // the fixed canvas again (its drawing freed)
//
// The keys:
//
//                   B brush, L line,          left mouse paints, right erases (an autotile layer:
//                   R rectangle               solid and open); the other button cancels a line or
//                                             a rectangle being dragged; Shift: a line snaps to
//                                             the 8 directions
//                   W, S                      the brush's size (the brush's and the line's cells
//                                             across, 1 to 32), square or round in the panel
//                   Shift + click             (the brush) a line from where the last stroke or
//                                             line on the layer ended (shown while Shift is held)
//                   N random                  (Tiles layers) each cell's tile from the tileset's
//                                             shuffle bag (each tile in it once per round, as often
//                                             as it was put in): in the palette a left click puts
//                                             a tile in, a right click takes one out (Shift: 5,
//                                             Ctrl: 10); the brush of
//                                             any size, the line and the rectangle paint from it,
//                                             the preview shows the tiles that come next;
//                                             (Decals layers) each placed decal's angle, scale and
//                                             opacity rolled within ranges, flipped by chance where
//                                             allowed: the ghost is the next one, a right click
//                                             rolls another
//                   I pick, or Alt + click    picks the tile under the mouse (eyedropper; KDE
//                                             moves windows with Alt + drag); dragged over a
//                                             region: that is the stamp (I: the brush then)
//                   1 .. 9, 0                 paint with a stamp slot's stamp (Tiles layers; see
//                                             below: 10 slots per tileset), Ctrl + the key: the stamp kept
//                                             in the slot; a click on the palette: its tile again.
//                                             A stamp's empty cells leave what is under them; the
//                                             brush puts it down (dragged: side by side), the line
//                                             puts a row of them, the rectangle fills with them
//                   C camera bounds           drag a rectangle of tiles (the camera's bounds; shown in
//                                             cyan), right click: the whole level again
//                   the level panel           extends the level on each side (- and +: a tile row or
//                                             column, with Shift 10, with Ctrl 50; every layer,
//                                             decals and bounds move along)
//                   Ctrl+S                    saves the level file ('*' in the panel: unsaved)
//                   Ctrl+O, Ctrl+N,           another level, a new one (empty, the layers of this
//                   Ctrl+Shift+S              one), this one saved as another (the names typed in
//                                             hope's Ui.TextField)
//                   Ctrl+Z, Ctrl+Y            undo, redo (also Ctrl+Shift+Z): a stroke, a rectangle,
//                                             showing or hiding a layer is a step (hope's
//                                             EditHistory: the level as JSON pieces, a step keeps
//                                             the ones it changed)
//
//
// Painting changes the data and what is drawn of it cell by cell. Locked and hidden layers are
// not painted.
//
// Stamps: pieces of a tile layer kept for painting them again, 10 slots per tileset (the keys 1 to
// 9 and 0), in assets/stamps/<tileset>.stamp.json (the editor's: a game does not use them, Bakie
// leaves them alone). A stamp is a grid of tiles; its empty cells (TILE_EMPTY) leave what is under
// them.
//
//     {
//       "version": 1, "tileset": "tiles_ground",
//       "slots": [
//         { "key": 1, "tiles": { "w": 3, "h": 2, "rows": ["000102", "..0304"] } },
//         { "key": 0, "tiles": { "w": 1, "h": 1, "rows": ["05"] } }
//       ]                                         (the slots that have a stamp, in the keys' order)
//     }
//
// Between runs: build/editor/editor.json (the tools, the same for every level, and the level open
// last), build/editor/<level>.editor.json (the view, the selected layer) and
// <level>.history.json (the undo steps), written when the level is saved, when the editor is left,
// on F5 and on quitting. The views come back in every run; the undo steps only in the run that
// wrote them (F5, the scene left and entered again, hot reloads: a new start of the program
// begins without them, so an undo too many cannot take back last week's work). They are read
// back at their saved state, which the level file must still be (else a new history); unsaved
// steps are then there to redo.

// This run of the program (made once, kept across F5 and hot reloads as a global; another start
// of the program: another value, from the time and an address that changes with every start)
long levelEditorRunId = 0;

long LevelEditorRunId() {
    if (levelEditorRunId == 0)
        levelEditorRunId = (long)(Hash((ulong)(platform.TimeSinceStartup() * 1000000000)) ^ Hash((ulong)(uptr)&levelEditorRunId)) & 0x7fffffffffffffff;
    return levelEditorRunId;
}
//
// The level's data is the editor's (the editor phase: it survives making the drawing again); what
// is drawn is made from it in the level phase (Enter). In the internal mode the data is the file
// (the editor writes it), elsewhere the game pack's (nothing is written then).

const int EditorTextScale = 3;         // the editor's UI on the free canvas (the window's pixels)

@Serializable
enum EditorTool { Brush, Line, Rect, Pick, Place, Select, Bounds }

const int BRUSH_SIZE_MAX = 32;         // (cells across)

// What the editor was doing with a level, kept between runs (build/editor/<level>.editor.json:
// this machine's, not the level's file): whether it was open, its view, the selected layer
@Serializable
struct LevelEditorSession {
    @Serialize long runId;             // the run that wrote it: its undo steps are only taken back in that run
    @Serialize bool isOpen;            // (a game may open it again then)
    @Serialize Vec2 editorPos;
    @Serialize float editorZoom;
    @Serialize int selected;
}

// The editor's tools as they were, the same for every level (build/editor/editor.json): the level
// open last, the tool, the tile, the brush, the random bags and ranges, the next decal
@Serializable
struct LevelEditorPrefs {
    @Serialize string level;
    @Serialize EditorTool tool;
    @Serialize int tile;
    @Serialize LevelDecal decal;       // what Place puts down next (its sprite, angle, scale, color, flips)
    @Serialize int brushSize = 1;
    @Serialize bool isBrushRound;
    @Serialize bool isRandom;
    @Serialize List[LevelEditorBag] bags;  // the tilesets' random bags
    @Serialize bool isDecalRandom;
    @Serialize DecalRandomRanges decalRandom;
}

// Random decal placement: each placed decal's angle, scale and opacity somewhere in these ranges
// (from, to), flipped or not by chance where flipping is allowed
@Serializable
struct DecalRandomRanges {
    @Serialize Vec2 angle = Vec2(-180, 180);       // degrees
    @Serialize Vec2 scale = Vec2(0.75, 1.25);
    @Serialize Vec2 opacity = Vec2(0.6, 1);
    @Serialize bool flipsHorizontal = true;
    @Serialize bool flipsVertical = true;
}

// A tileset's random bag (its tiles, one per time it is in the bag)
@Serializable
struct LevelEditorBag {
    @Serialize string tileset;
    @Serialize List[int] tiles;
}

// A tileset's random bag as the editor keeps it
struct TileBag {
    String tileset;
    ShuffleBag[byte] bag;
}

struct LevelEditor {
    String name;                       // the level's (assets/levels/<name>.level)
    LevelData data;
    bool isOpen;                       // between Enter and Leave
    bool wasOpen;                      // the session said it was open (a game may open it again)
    bool showsHints = true;            // the line of keys at the top ...
    string gameKeys = "";              // ... with the game's keys for it ("F1: the preview")
    LevelDrawings* drawings;           // what is drawn of the layers (the level phase: Enter)
    Vec2 editorPos;                    // its camera
    float editorZoom = 0;              // (0: fit the level into the window when the editor opens)
    // Editing
    int selected;                      // the layer being edited
    EditorTool tool;
    byte tile;                         // the palette's (Tiles layers)
    int brushSize = 1;                 // the brush's and the line's cells across (W, S)
    bool isBrushRound;                 // ... a disc, else a square
    EditHistory history;               // undo and redo (hope's history.pg): the header, then a piece per layer
    List[bool] dirtyPieces;            // the pieces changed since the last commit (only those are written again)
    bool isPainting;                   // a mouse button held over the level (from a press there)
    bool isErasing;                    // ... the right one
    Vec2i strokeStart;                 // the cell the press was on (the rectangle's corner)
    Vec2i strokeLast;                  // the brush's cell last frame (painted up to it)
    bool isStrokeLine;                 // the stroke began with a line from the last one (Shift + click)
    bool isPickingRegion;              // the eyedropper dragged from strokeStart (one cell: a tile, more: a stamp)
    bool hasLastPainted;               // where the last stroke or line ended (Shift + click: a line from there)
    Vec2i lastPainted;
    int lastPaintedLayer;
    bool waitsForRelease;              // a rectangle was cancelled: nothing starts until both buttons are up
    // Stamps (Tiles layers, see the top): a picked region or a slot's, painted instead of the tile
    List[StampSet] stampSets;          // the tilesets' slots (read when first needed)
    Grid[byte] stamp;                  // the stamp being painted (0 x 0: the palette's tile)
    String stampTileset;               // ... its tileset (a layer of another one: its tile again)
    int stampSlot = -1;                // ... the slot it is (-1: picked, in no slot)
    Vec2i stampAnchor;                 // the stroke's first stamp's left top (the stroke's stamps are on its grid)
    // Random painting (Tiles layers): each cell's tile from the tileset's shuffle bag (the palette:
    // a left click puts a tile in, a right click takes one out)
    bool isRandom;                     // N
    List[TileBag] tileBags;
    Grid[bool] strokePainted;          // the cells the random stroke painted (the brush moving over them: not again)
    // Random decal placement (N on a Decals layer): the next decal rolled within the ranges (the
    // ghost shows it, a click places it, then the next one is rolled)
    bool isDecalRandom;
    DecalRandomRanges decalRandom;
    Random decalRandomGenerator = Random((ulong)LevelEditorRunId());
    LevelDecal rolledDecal;
    bool needsRoll = true;
    // Levels: the dialogs (open, new, save as), what the game opens next (a new editor for it)
    LevelDialog dialog;
    String dialogName;                 // the name typed (new, save as)
    String dialogError;
    bool isChangeDropped;              // "Don't save" was chosen: leaving asks no more
    String requestedLevel;             // (the game makes an editor for it after this frame)
    // Decals
    LevelDecal decal = LevelDecal("decal_scorch", Vec2(0, 0), 0);    // what Place puts down next (pos: unused)
    int selectedDecal = -1;            // in the selected Decals layer (-1: none)
    bool isMovingDecal;                // dragged with the mouse (from a press on it)
    Vec2 moveGrab;                     // where it was grabbed (from its position)
    List[string] decalSprites;         // what the sprite list offers: decal_ ones first, then the others (no font glyphs)
    int decalSpritesAtlas = -1;        // the atlas version they are of
}

// Stamps (see the top): a tileset's slots, as the file has them and as the editor keeps them
const int STAMP_SLOTS = 10;
const int STAMP_FILE_VERSION = 1;

@Serializable
struct StampFile {
    @Serialize int version = STAMP_FILE_VERSION;
    @Serialize string tileset;
    @Serialize List[StampSlot] slots;          // the slots that have a stamp (the key 1 first, the key 0 last)
}

@Serializable
struct StampSlot {
    @Serialize int key;                        // the digit that picks it (the file lists them in the keys' order)
    @Serialize Grid[byte] tiles;
}

// A tileset's slots as the editor keeps them
struct StampSet {
    String tileset;
    [Grid[byte], 10] slots;                    // by slot: the key 1 first, the key 0 last (0 x 0: empty)
}

extend StampSet {
    // The key of slot 'slot' (1 to 9, then 0)
    static int KeyOf(int slot) { return (slot + 1) % STAMP_SLOTS; }
    // ... and the slot of a key
    static int SlotOf(int key) { return (key + STAMP_SLOTS - 1) % STAMP_SLOTS; }

    static string PathOf(string tileset) { return TFormat(BUILD_PROJECT_DIR, "/assets/stamps/", tileset, ".stamp.json"); }

    // The slots of 'tileset' from its file (all empty if there is none, outside the internal mode
    // too; made with context.allocator)
    static StampSet Load(string tileset) {
        StampSet stamps;
        stamps.tileset.Append(tileset);
        let path = PathOf(tileset);
        if (!INTERNAL || !File.Exists(path))
            return stamps;
        let allocator = context.allocator;
        ScopeAllocTemp();
        StampFile file;
        if (!FromJson(File.ReadText(path), &file)) {
            Log.Warn("[Stamps] '", path, "' is no JSON: its stamps are not used");
            return stamps;
        }
        if (file.version > STAMP_FILE_VERSION) {
            Log.Warn("[Stamps] '", path, "' has the format ", file.version, ", this editor reads up to ", STAMP_FILE_VERSION);
            return stamps;
        }
        ScopeAlloc(allocator);
        for (let slot in file.slots) {
            if (0 <= slot.key && slot.key < STAMP_SLOTS && slot.tiles.w > 0 && slot.tiles.h > 0)
                stamps.slots[SlotOf(slot.key)] = slot.tiles.Clone();
        }
        return stamps;
    }

    // The slots into the tileset's file; false if it could not be written (or outside the
    // internal mode: the stamps are this run's then)
    bool Save() {
        if (!INTERNAL)
            return false;
        ScopeAllocTemp();
        Directory.Create(TFormat(BUILD_PROJECT_DIR, "/assets/stamps"));
        StampFile file;
        file.tileset = tileset.view;
        for (let slot in 0..STAMP_SLOTS) {
            if (slots[slot].w > 0)
                file.slots.Add(StampSlot(KeyOf(slot), slots[slot]));
        }
        return File.WriteText(PathOf(tileset.view), Format(ToJson(file), "\n"));
    }
}

enum LevelDialog { None, Open, New, SaveAs }

// Cells a paint operation covers, each once: marks over a rectangle of the layer's cells (the
// brush stamped along a line, a rectangle), made in temp memory
struct CellMask {
    Vec2i origin;                      // the marks' (0, 0) in the layer's cells
    Grid[bool] marks;
    Grid[byte] tiles;                  // a stamp's: the tile of each marked cell (0 x 0: the palette's tile)
}

extend CellMask {
    static CellMask Make(Recti rect, bool hasTiles = false) {
        ScopeAllocTemp();
        let w = Max(0, rect.w);
        let h = Max(0, rect.h);
        return CellMask(rect.pos, Grid[bool](w, h, false), hasTiles ? Grid[byte](w, h, TILE_EMPTY) : Grid[byte](0, 0, TILE_EMPTY));
    }

    // The tile painted at (x, y) of the layer: the stamp's, else 'tile'
    byte TileAt(int x, int y, byte tile) { return tiles.w > 0 ? tiles.Get(Vec2i(x - origin.x, y - origin.y)) : tile; }

    // The stamp's tiles (not its empty cells) with its left top at 'corner' (in the marks)
    void PutStamp(Grid[byte]* stamp, Vec2i corner) {
        for (let y in 0..stamp.h) {
            for (let x in 0..stamp.w) {
                let value = stamp.Get(Vec2i(x, y));
                let at = Vec2i(corner.x + x, corner.y + y);
                if (value != TILE_EMPTY && marks.ContainsCoord(at.x, at.y)) {
                    marks.Set(at, true);
                    tiles.Set(at, value);
                }
            }
        }
    }

    get Recti rect() { return Recti(origin, marks.dim); }
    bool Has(int x, int y) { return marks.ContainsCoord(x - origin.x, y - origin.y) && marks.Get(Vec2i(x - origin.x, y - origin.y)); }

    // The brush ('size' cells across) with its left top at 'corner' (in the marks)
    void Stamp(Vec2i corner, int size, bool isRound) {
        for (let y in 0..size) {
            for (let x in 0..size) {
                if (IsInBrush(x, y, size, isRound) && marks.ContainsCoord(corner.x + x, corner.y + y))
                    marks.Set(Vec2i(corner.x + x, corner.y + y), true);
            }
        }
    }

    // Whether the cell (x, y) of a brush 'size' cells across is in it: a round one is the cells
    // whose middle is inside a circle a bit smaller than the square (3: a plus; up to 2: a square)
    static bool IsInBrush(int x, int y, int size, bool isRound) {
        if (!isRound || size <= 2)
            return true;
        let middle = (size - 1) * 0.5;
        let dx = x - middle;
        let dy = y - middle;
        let radius = size * 0.5;
        return dx * dx + dy * dy < radius * radius - 0.25;
    }
}

// What is drawn of each layer (made from the data)
union LayerDrawing {
case Tiles
    TilemapLayer tilemap;
case Autotiles
    AutotileMap autotiles;
case Decals
    Decalmap decals;
}

// What is drawn of a level's layers (the editor's, a game's preview)
struct LevelDrawings {
    List[LayerDrawing] layers;         // per layer of the data, in its order
}

extend LevelDrawings {
    // Every layer of 'data' as drawn (in the level phase)
    static LevelDrawings* Make(LevelData* data) {
        ScopeAllocLevel();
        let drawings = New[LevelDrawings]();
        for (let layer in data.layers) {
            drawings.layers.Add(LayerDrawing.Make(data, layer));
        }
        return drawings;
    }

    // (what holds more than memory: the decal maps' atlas regions; the memory stays in the level phase)
    void Free() {
        for (let drawing in layers) {
            drawing.Free();
        }
    }
}

extend LayerDrawing {
    // What a game would draw of the layer: a tile map, an autotile map, a decal map (in the level phase)
    static LayerDrawing Make(LevelData* data, LevelLayer* layer) {
        ScopeAllocLevel();
        switch (layer.case) {
        case LevelLayer.Tiles: return LayerDrawing.Tiles(tilemap: layer.MakeTilemap());
        case LevelLayer.Autotiles: return LayerDrawing.Autotiles(autotiles: layer.MakeAutotileMap(data.pixelSize));
        case LevelLayer.Decals: return LayerDrawing.Decals(decals: layer.MakeDecalmap(data.pixelSize));
        }
    }

    void Draw(Rect view) {
        switch (self.case) {
        case LayerDrawing.Tiles: tilemap.Draw(view);
        case LayerDrawing.Autotiles: autotiles.Draw(view);
        case LayerDrawing.Decals: decals.Draw(view);
        }
    }

    void Free() {
        ScopeAllocLevel();
        switch (self.case) {
        case LayerDrawing.Tiles: tilemap.Free();
        case LayerDrawing.Autotiles: autotiles.Free();
        case LayerDrawing.Decals: decals.Free();
        }
    }
}

extend LevelEditor {
    // The editor for the level 'level' (its file in the internal mode, else the game pack's; the
    // tools and the session as they were), not open yet (Enter)
    init(string level) {
        name.Append(level);
        ReadPrefs();
        string error;
        if (INTERNAL) {
            if (!LevelData.LoadFile(LevelPath(levelName), &data, &error))
                Panic("Level scene: ", error);
        } else {
            data = LevelData.Load(levelName);
        }
        editorPos = Vec2(data.pixelSize) * 0.5;
        {
            ScopeAllocTemp();
            List[string] pieces;
            for (let index in 0..data.layers.len + 1) {
                pieces.Add(PieceText(index));
            }
            history.Reset(pieces);
            ReadSession(pieces);
        }
        for (let index in 0..data.layers.len + 1) {
            dirtyPieces.Add(false);
        }
    }

    //----------------------------------------------------------------------------------------------
    // The session between runs (build/editor/)

    string SessionPath(string kind) { return TFormat(BUILD_PROJECT_DIR, "/build/editor/", levelName, ".", kind, ".json"); }
    static string PrefsPath() { return TFormat(BUILD_PROJECT_DIR, "/build/editor/editor.json"); }

    get string levelName() { return name.view; }
    static string LevelPath(string level) { return TFormat(BUILD_PROJECT_DIR, "/assets/levels/", level, ".level"); }

    // The levels there are (sorted; in temp memory): assets/levels/*.level in the internal mode,
    // else the game pack's
    static List[string] LevelNames() {
        ScopeAllocTemp();
        List[string] names;
        if (INTERNAL) {
            let dir = TFormat(BUILD_PROJECT_DIR, "/assets/levels");
            for (let path in Directory.FindFiles(dir, ".level")) {
                let level = Path.FileNameWithoutExtension(*path);
                if (*path == LevelPath(level))         // (not in folders below it)
                    names.Add(level);
            }
        } else {
            for (let level, levelData in gamePack.levels) {
                names.Add(level);
            }
            names.Sort((string* a, string* b) => string.Compare(*a, *b) < 0);
        }
        return names;
    }

    // The level the editor had open last ("" if none: no build/editor/editor.json)
    static string LastLevel() {
        if (!INTERNAL || !File.Exists(PrefsPath()))
            return "";
        LevelEditorPrefs prefs;
        if (!FromJson(File.ReadText(PrefsPath()), &prefs))
            return "";
        return prefs.level;
    }

    // The tools as they were (build/editor/editor.json; none yet: the ones the level's session
    // file had before there was one)
    void ReadPrefs() {
        if (!INTERNAL)
            return;
        ScopeAllocTemp();
        LevelEditorPrefs prefs;
        let path = File.Exists(PrefsPath()) ? PrefsPath() : "";
        if (path.len == 0 && File.Exists(SessionPath("editor")))
            path = SessionPath("editor");
        if (path.len == 0 && File.Exists(TFormat(BUILD_PROJECT_DIR, "/build/editor/test.editor.json")))
            path = TFormat(BUILD_PROJECT_DIR, "/build/editor/test.editor.json");
        if (path.len == 0 || !FromJson(File.ReadText(path), &prefs))
            return;
        tool = prefs.tool;
        tile = (byte)Clamp(prefs.tile, 0, 254);
        brushSize = Clamp(prefs.brushSize, 1, BRUSH_SIZE_MAX);
        isBrushRound = prefs.isBrushRound;
        isRandom = prefs.isRandom;
        isDecalRandom = prefs.isDecalRandom;
        decalRandom = prefs.decalRandom;
        for (let saved in prefs.bags) {
            let bag = TileBagOf(saved.tileset);
            bag.Clear();
            for (let value in saved.tiles) {
                if (0 <= *value && *value < TILE_EMPTY)
                    bag.Add((byte)*value);
            }
        }
        if (prefs.decal.sprite.len > 0) {
            decal = prefs.decal;
            decal.sprite = prefs.decal.sprite.Copy(history.allocator);
        }
    }

    void WritePrefs() {
        if (!INTERNAL)
            return;
        ScopeAllocTemp();
        LevelEditorPrefs prefs;
        prefs.level = levelName;
        prefs.tool = tool;
        prefs.tile = tile;
        prefs.decal = decal;
        prefs.brushSize = brushSize;
        prefs.isBrushRound = isBrushRound;
        prefs.isRandom = isRandom;
        prefs.isDecalRandom = isDecalRandom;
        prefs.decalRandom = decalRandom;
        for (let bag in tileBags) {
            let saved = LevelEditorBag(bag.tileset.view);
            for (let index in 0..bag.bag.items.len) {
                saved.tiles.Add(bag.bag.items[index]);
            }
            prefs.bags.Add(saved);
        }
        File.WriteText(PrefsPath(), Format(ToJson(prefs), "\n"));
    }

    // The views, the mode and the selection as they were; the undo steps, if the level file is
    // still what they were saved as ('pieces': the file's)
    void ReadSession([string] pieces) {
        if (!INTERNAL)
            return;
        LevelEditorSession session;
        let hasSession = File.Exists(SessionPath("editor")) && FromJson(File.ReadText(SessionPath("editor")), &session);
        if (hasSession) {
            wasOpen = session.isOpen;
            editorPos = session.editorPos;
            editorZoom = session.editorZoom;
            selected = session.selected;
        }
        // The undo steps only in the run that wrote them
        if (!hasSession || session.runId != LevelEditorRunId())
            return;
        // (made with the editor's allocator: this runs in a temp scope, and the history's lists keep
        // the allocator of when they were made)
        ScopeAlloc(history.allocator);
        EditHistory read;
        if (!read.ReadFile(SessionPath("history")))
            return;
        let isSame = read.MoveTo(read.savedId) && read.current.len == pieces.len;
        for (let index in 0..Min(read.current.len, pieces.len)) {
            isSame = isSame && read.current[index].view == pieces[index];
        }
        if (!isSame) {
            Log.Info("[Level editor] the undo steps of ", SessionPath("history"), " are for another state of the level file (it changed since): a new history");
            read.Clear();
            return;
        }
        history.Clear();
        history = read;
        Log.Info("[Level editor] ", history.undoSteps.len, " steps to undo, ", history.redoSteps.len, " to redo (from the last session)");
    }

    // The views, the mode, the selection and the undo steps into build/editor/
    void WriteSession() {
        if (!INTERNAL)
            return;
        ScopeAllocTemp();
        Directory.Create(TFormat(BUILD_PROJECT_DIR, "/build/editor"));
        let session = LevelEditorSession(LevelEditorRunId(), isOpen, isOpen ? Camera.pos : editorPos, isOpen ? Camera.zoom : editorZoom, selected);
        File.WriteText(SessionPath("editor"), Format(ToJson(session), "\n"));
        WritePrefs();
        if (!history.WriteFile(SessionPath("history")))
            Log.Warn("[Level editor] could not write ", SessionPath("history"));
    }

    get bool isModified() { return history.isModified; }

    //----------------------------------------------------------------------------------------------
    // Undo and redo: the level as pieces of JSON (0: the header, without the layers; 1..: the
    // layers), committed when an edit ends (only the dirty pieces written again)

    // The piece's JSON now (allocated with context.allocator)
    string PieceText(int piece) {
        if (piece > 0)
            return ToJson(data.layers[piece - 1]);
        let header = data;
        header.layers = List[LevelLayer]();
        return ToJson(header);
    }

    void MarkDirty(int piece) {
        while (dirtyPieces.len <= piece) {
            dirtyPieces.Add(true);
        }
        dirtyPieces[piece] = true;
    }

    // A step named 'name' with what changed since the last one (none: no step)
    void Commit(string name) {
        ScopeAllocTemp();
        List[string] pieces;
        for (let index in 0..data.layers.len + 1) {
            let isDirty = index < dirtyPieces.len && dirtyPieces[index];
            pieces.Add(isDirty || index >= history.current.len ? PieceText(index) : history.current[index].view);
        }
        history.Commit(name, pieces);
        for (let dirty in dirtyPieces) {
            *dirty = false;
        }
    }

    void Undo() {
        if (history.Undo())
            ReadBack(TFormat("Undone: ", history.redoName));
    }

    void Redo() {
        if (history.Redo())
            ReadBack(TFormat("Redone: ", history.undoName));
    }

    // The pieces Undo or Redo changed, read into the data, and what is drawn of them made again
    void ReadBack(string what) {
        if (history.lastChangedCount) {
            // (layers added or removed: all of them again)
            data.layers = List[LevelLayer]();
            for (let index in 1..history.current.len) {
                LevelLayer layer;
                FromJson(history.current[index].view, &layer);
                data.layers.Add(layer);
            }
            Enter();
        } else {
            for (let piece in history.lastChanged) {
                if (*piece == 0) {
                    LevelData header;
                    FromJson(history.current[0].view, &header);
                    data.tileSize = header.tileSize;
                    data.size = header.size;
                    data.cameraBounds = header.cameraBounds;
                    continue;
                }
                let index = *piece - 1;
                LevelLayer layer;
                FromJson(history.current[*piece].view, &layer);
                data.layers[index] = layer;
                RebuildDrawing(index);
            }
        }
        while (dirtyPieces.len < data.layers.len + 1) {
            dirtyPieces.Add(false);
        }
        Draw.LogSticky(90, Color.Cyan, what);
    }

    // What is drawn of one layer, made again (in the level phase; the old one's memory stays there
    // until the next Enter wipes it)
    void RebuildDrawing(int index) {
        ScopeAllocLevel();
        let drawing = &drawings.layers[index];
        drawing.Free();
        *drawing = LayerDrawing.Make(&data, &data.layers[index]);
    }

    // Open: the free canvas, its camera (where it was), what is drawn of the layers (made in the
    // level phase: a game wipes that phase before, as it likes)
    void Enter() {
        drawings = LevelDrawings.Make(&data);
        isOpen = true;
        Draw.isCanvasFree = true;
        Camera.rotation = 0;
        Camera.isCentered = true;
        Camera.allowPanning = true;
        Camera.allowZooming = true;
        if (editorZoom <= 0)
            editorZoom = FittingZoom();
        Camera.pos = editorPos;
        Camera.zoom = editorZoom;
        Draw.clearColor = Color.Grey(0.18);
    }

    // Closed: its camera kept, its drawing freed (its memory stays in the level phase), the fixed
    // canvas again; the session written
    void Leave() {
        if (isOpen) {
            editorPos = Camera.pos;
            editorZoom = Camera.zoom;
        }
        isOpen = false;
        WriteSession();
        if (drawings != null) {
            drawings.Free();
            drawings = null;
        }
        Draw.isCanvasFree = false;
        Camera.allowPanning = false;
        Camera.allowZooming = false;
        Camera.zoom = 1;
    }

    // The biggest power of two (the camera's zoom steps) at which the level fits the window
    float FittingZoom() {
        let window = Vec2(Input.windowDim);
        let level = Vec2(data.pixelSize);
        let fit = Min(window.x / Max(1.0, level.x), window.y / Max(1.0, level.y)) * 0.9;
        let zoom = 1.0;
        while (zoom * 2 <= fit && zoom < 16) {
            zoom *= 2;
        }
        while (zoom > fit && zoom > 0.125) {
            zoom *= 0.5;
        }
        return zoom;
    }

    // Every frame while the editor exists (open or not): a window closed or F5 with unsaved
    // changes asks first (the internal mode asks the game: the data would be gone)
    void GuardUnsaved() {
        if (Window.isQuitRequested) {
            if (isModified) {
                Window.CancelQuit();
                if (AskAboutChanges("quitting")) {
                    WriteSession();
                    Window.Quit();
                }
            } else {
                WriteSession();
            }
        }
        if (Runtime.isRestartRequested) {
            if (isModified) {
                Runtime.CancelRestart();
                if (AskAboutChanges("restarting the game")) {
                    WriteSession();
                    Runtime.Restart();
                }
            } else {
                WriteSession();
            }
        }
    }

    //----------------------------------------------------------------------------------------------
    // A frame of the open editor: what is drawn of the layers (every one that is not hidden), the
    // grid, the tools, the panels

    void DoFrame() {
        Ui.BlockKeys();                    // (the keys are the tools': W and S would move the panels' focus)
        if (showsHints)
            Draw.LogLine("Level editor", gameKeys.len > 0 ? TFormat(" (", gameKeys, ")") : "", ": B brush, L line, R rectangle, I pick (or Alt+click), W/S brush size, N random (tiles: the palette fills the bag; decals: rolled in ranges), Shift+click a line from the last, I+drag a stamp, 1..0 stamps (Ctrl: keep), left paints, right erases, Ctrl+S saves; middle mouse pans, the wheel zooms (",
                FormatFloat(Camera.zoom, 3), "x)");
        let view = Camera.viewportRect;
        for (let index, layer in data.layers) {
            if (layer.isHidden)
                continue;
            // (decals one by one from the data: moved and deleted ones show at once; the preview
            // has the game's decal map)
            if (layer.case == LevelLayer.Decals)
                DrawDecals(layer);
            else
                drawings.layers[index].Draw(view);
        }
        DrawGrid(view);
        // A dialog (open, new, save as) is all there is until it closes: no tools, no other panels
        if (dialog != LevelDialog.None) {
            DrawCameraBounds();
            LevelDialogPanel();
            return;
        }

        let ctrl = Input.KeyDown(Scancode.LCtrl) || Input.KeyDown(Scancode.RCtrl);
        let shift = Input.KeyDown(Scancode.LShift) || Input.KeyDown(Scancode.RShift);
        if (ctrl && !shift && Input.KeyPressed(Scancode.S))
            Save();
        if (ctrl && shift && Input.KeyPressed(Scancode.S) && !isPainting)
            OpenDialog(LevelDialog.SaveAs);
        if (ctrl && Input.KeyPressed(Scancode.O) && !isPainting)
            OpenDialog(LevelDialog.Open);
        if (ctrl && Input.KeyPressed(Scancode.N) && !isPainting)
            OpenDialog(LevelDialog.New);
        // (not in the middle of a stroke: it is committed when it ends)
        if (ctrl && !isPainting && ((Input.KeyPressed(Scancode.Z) && shift) || Input.KeyPressed(Scancode.Y)))
            Redo();
        else if (ctrl && !isPainting && Input.KeyPressed(Scancode.Z))
            Undo();
        if (Input.KeyPressed(Scancode.B))
            tool = EditorTool.Brush;
        if (Input.KeyPressed(Scancode.L))
            tool = EditorTool.Line;
        // (N: random tiles on a Tiles layer, random decals on a Decals layer)
        if (Input.KeyPressed(Scancode.N) && !ctrl && data.layers.len > 0) {
            if (data.layers[Clamp(selected, 0, data.layers.len - 1)].case == LevelLayer.Decals) {
                isDecalRandom = !isDecalRandom;
                needsRoll = true;
            } else {
                isRandom = !isRandom;
            }
        }
        if (Input.KeyPressed(Scancode.R))
            tool = EditorTool.Rect;
        if (Input.KeyPressed(Scancode.I))
            tool = EditorTool.Pick;
        // (V: Place and Select by turns, the left hand stays at Q W E A S D)
        if (Input.KeyPressed(Scancode.V))
            tool = tool == EditorTool.Place ? EditorTool.Select : EditorTool.Place;
        if (Input.KeyPressed(Scancode.C))
            tool = tool == EditorTool.Bounds ? EditorTool.Brush : EditorTool.Bounds;
        selected = Clamp(selected, 0, Max(0, data.layers.len - 1));
        DrawCameraBounds();
        if (tool == EditorTool.Bounds) {
            EditBounds();
        } else if (data.layers.len > 0) {
            let layer = &data.layers[selected];
            // (each kind its own tools: a painting tool on a Decals layer is Place, and back)
            let isDecalTool = tool == EditorTool.Place || tool == EditorTool.Select;
            if (layer.case == LevelLayer.Decals && !isDecalTool)
                tool = EditorTool.Place;
            if (layer.case != LevelLayer.Decals && isDecalTool)
                tool = EditorTool.Brush;
            if (layer.case == LevelLayer.Decals)
                EditDecals(layer);
            else
                Paint(layer, &drawings.layers[selected]);
        }

        LayerPanel();
        ToolPanel();
        LevelPanel();
    }

    //----------------------------------------------------------------------------------------------
    // The level: its camera bounds (C), extending it on its sides (the level panel)

    // The bounds in cyan when they are set (the whole level otherwise: the edge shows it)
    void DrawCameraBounds() {
        let bounds = data.cameraBounds;
        if (bounds.w <= 0 || bounds.h <= 0)
            return;
        let rect = Rect(Vec2(bounds.pos * data.tileSize), Vec2(bounds.dim * data.tileSize));
        OutlineRect(rect, Color(0.2, 0.7, 0.8, 0.9));
    }

    // Dragging a rectangle of the level's tiles sets the bounds (right click: the whole level)
    void EditBounds() {
        let world = Input.cursors.world;
        let cell = Vec2i((int)Floor(world.x / data.tileSize), (int)Floor(world.y / data.tileSize));
        cell = Vec2i(Clamp(cell.x, 0, data.size.x - 1), Clamp(cell.y, 0, data.size.y - 1));
        let isOverUi = Ui.isMouseOverPanel;
        if (!isOverUi && Input.MousePressed(MouseButton.Right) && !isPainting) {
            data.cameraBounds = Recti();
            MarkDirty(0);
            Commit("Reset the camera bounds");
            return;
        }
        if (!isOverUi && Input.MousePressed(MouseButton.Left) && !isPainting) {
            isPainting = true;
            strokeStart = cell;
        }
        let rect = Recti(Min(strokeStart.x, cell.x), Min(strokeStart.y, cell.y), Abs(cell.x - strokeStart.x) + 1, Abs(cell.y - strokeStart.y) + 1);
        if (isPainting) {
            OutlineRect(Rect(Vec2(rect.pos * data.tileSize), Vec2(rect.dim * data.tileSize)), Color(0.4, 0.9, 1, 1));
            if (!Input.MouseDown(MouseButton.Left)) {
                isPainting = false;
                data.cameraBounds = rect == Recti(data.size) ? Recti() : rect;      // (all of it: none set)
                MarkDirty(0);
                Commit("Set the camera bounds");
            }
        } else if (!isOverUi) {
            OutlineRect(Rect(Vec2(cell * data.tileSize), Vec2(data.tileSize, data.tileSize)), Color(0.4, 0.9, 1, 0.8));
        }
    }

    // The level's size and its sides: - and + take a tile row or column away or add one
    //----------------------------------------------------------------------------------------------
    // Levels: open another one, make a new one, save this one as another (assets/levels/; Ctrl+O,
    // Ctrl+N, Ctrl+Shift+S). Opening and making one are requests (requestedLevel: the game makes a
    // new editor for it after the frame); saving as goes on with this editor under the new name
    // (its undo steps stay).

    void OpenDialog(LevelDialog which) {
        if (which != LevelDialog.Open && !INTERNAL) {
            Draw.LogSticky(180, Color.Orange, "Levels are written in the internal mode");
            return;
        }
        dialog = which;
        dialogName.Clear();
        dialogError.Clear();
        if (which == LevelDialog.SaveAs)
            dialogName.Append(levelName);
    }

    get bool hasDialog() { return dialog != LevelDialog.None; }

    // The level 'level' next (the game makes an editor for it after this frame); false if the
    // unsaved changes stay (the user said so)
    bool RequestLevel(string level, string doing) {
        if (!AskAboutChanges(doing))
            return false;
        requestedLevel.Clear();
        requestedLevel.Append(level);
        return true;
    }

    void LevelDialogPanel() {
        Ui.WithFont(Ui.style.fontName, EditorTextScale);
        Ui.Panel(UiAnchor.Center, 200 * EditorTextScale);
        let escape = Input.KeyPressed(Scancode.Escape);
        if (dialog == LevelDialog.Open) {
            Ui.Label("Open a level (assets/levels/)", UiAlign.Left, Ui.style.textFocused);
            let names = LevelNames();
            {
                Ui.Scroll(Min(Max(1, names.len), 8) * (Ui.ButtonHeight() + Ui.style.spacing));
                for (let index, level in names) {
                    if (Ui.Button(*level, id: index, align: UiAlign.Left, isToggled: *level == levelName)) {
                        if (*level != levelName && RequestLevel(*level, "opening another level"))
                            dialog = LevelDialog.None;
                        else if (*level == levelName)
                            dialog = LevelDialog.None;
                    }
                }
            }
            if (Ui.Button("Cancel") || escape)
                dialog = LevelDialog.None;
            return;
        }
        let isNew = dialog == LevelDialog.New;
        Ui.Label(isNew ? TFormat("New level: empty, the layers of '", levelName, "'") : "Save the level as", UiAlign.Left, Ui.style.textFocused);
        Ui.FocusByDefault();
        let input = Ui.TextField("name", &dialogName, 40);
        if (input.isChanged)
            dialogError.Clear();
        Ui.Label(TFormat("assets/levels/", dialogName.view, ".level"), UiAlign.Left, Ui.style.textDisabled);
        if (dialogError.len > 0)
            Ui.Label(dialogError.view, UiAlign.Left, Color.Orange);
        Ui.Columns(2);
        let isOk = Ui.Button(isNew ? "Create" : "Save") || input.isAccepted;
        if (Ui.Button("Cancel") || input.isCancelled || (escape && !Ui.isTyping)) {
            dialog = LevelDialog.None;
            return;
        }
        if (isOk && dialogName.len == 0)
            dialogError.Append("Type a name first");
        else if (isOk && isNew)
            NewLevel(dialogName.view);
        else if (isOk)
            SaveLevelAs(dialogName.view);
    }

    // A new level 'level' (its file written: empty, the layers of this one, its size), opened
    void NewLevel(string level) {
        if (File.Exists(LevelPath(level))) {
            dialogError.Clear();
            dialogError.Append("There is a level '", level, "' (Open opens it)");
            return;
        }
        ScopeAllocTemp();
        let fresh = data.Copy();
        for (let layer in fresh.layers) {
            switch (layer.case) {
            case LevelLayer.Tiles: layer.tiles.Fill(TILE_EMPTY);
            case LevelLayer.Autotiles: layer.solid.Fill(false);
            case LevelLayer.Decals: layer.decals.Clear();
            }
        }
        fresh.cameraBounds = Recti();
        if (!fresh.SaveFile(LevelPath(level))) {
            dialogError.Clear();
            dialogError.Append("Could not write ", LevelPath(level));
            return;
        }
        Draw.LogSticky(240, Color.Green, "New level '", level, "' (", LevelPath(level), ")");
        if (RequestLevel(level, "opening the new level"))
            dialog = LevelDialog.None;
    }

    // The level saved into 'level''s file, the scene goes on with it (its undo steps too)
    void SaveLevelAs(string level) {
        if (level == levelName) {
            if (Save())
                dialog = LevelDialog.None;
            return;
        }
        let path = LevelPath(level);
        if (File.Exists(path) && Window.ShowMessageBox("Level exists", TFormat("There is a level '", level, "'. Overwrite it?"), ["Overwrite", "Cancel"]) != 0)
            return;
        WriteSession();                    // (the level it was: its views stay as they are)
        if (!data.SaveFile(path)) {
            dialogError.Clear();
            dialogError.Append("Could not write ", path);
            return;
        }
        let newName = TFormat(level);
        name.Clear();
        name.Append(newName);
        history.MarkSaved();
        isChangeDropped = false;
        WriteSession();
        Draw.LogSticky(240, Color.Green, "Saved as '", newName, "' (", path, ")");
        dialog = LevelDialog.None;
    }

    void LevelPanel() {
        Ui.WithFont(Ui.style.fontName, EditorTextScale);
        Ui.Panel(UiAnchor.RightTop, 170 * EditorTextScale, 0, Vec2i(-8, 150));          // (below the log's lines)
        {
            // (the files: the others need the internal mode, they write assets/levels/)
            Ui.Columns(3);
            if (Ui.Button("Open ^O"))
                OpenDialog(LevelDialog.Open);
            if (Ui.Button("New ^N", enabled: INTERNAL))
                OpenDialog(LevelDialog.New);
            if (Ui.Button("Save as", enabled: INTERNAL))
                OpenDialog(LevelDialog.SaveAs);
        }
        Ui.Label(TFormat("size ", data.size.x, " x ", data.size.y, " (", data.pixelSize.x, " x ", data.pixelSize.y, " px)"), UiAlign.Left, Ui.style.textFocused);
        [string, 4] sides = ["left", "top", "right", "bottom"];
        // (Shift: 10 at a time, Ctrl: 50; the buttons say so)
        let shift = Input.KeyDown(Scancode.LShift) || Input.KeyDown(Scancode.RShift);
        let ctrl = Input.KeyDown(Scancode.LCtrl) || Input.KeyDown(Scancode.RCtrl);
        let step = ctrl ? 50 : shift ? 10 : 1;
        for (let index in 0..4) {
            Ui.Columns(3, 0.5);
            Ui.Label(sides[index], UiAlign.Left);
            let delta = 0;
            if (Ui.Button(step == 1 ? "-" : TFormat("-", step), id: index))
                delta = -step;
            if (Ui.Button(step == 1 ? "+" : TFormat("+", step), id: index))
                delta = step;
            if (delta != 0)
                ExtendLevel(index == 0 ? delta : 0, index == 1 ? delta : 0, index == 2 ? delta : 0, index == 3 ? delta : 0, sides[index]);
        }
        let bounds = data.cameraBounds;
        Ui.Label(bounds.w > 0 ? TFormat("camera bounds ", bounds.x, " ", bounds.y, " ", bounds.w, " x ", bounds.h) : "camera bounds: the level", UiAlign.Left);
        if (Ui.Button("Camera bounds C", isToggled: tool == EditorTool.Bounds))
            tool = tool == EditorTool.Bounds ? EditorTool.Brush : EditorTool.Bounds;
    }

    // The level extended (or shrunk) on its sides: every layer made again; clicks on one side join
    // into one step
    void ExtendLevel(int left, int top, int right, int bottom, string side) {
        if (!data.Extend(left, top, right, bottom)) {
            Draw.LogSticky(120, Color.Orange, "The level cannot be smaller than 1 x 1 tile");
            return;
        }
        hasLastPainted = false;            // (its cell moved)
        // (the view stays on the same part of the level)
        Camera.pos = Camera.pos + Vec2(left * data.tileSize, top * data.tileSize);
        for (let index in 0..data.layers.len + 1) {
            MarkDirty(index);
        }
        ScopeAllocTemp();
        List[string] pieces;
        for (let index in 0..data.layers.len + 1) {
            pieces.Add(PieceText(index));
        }
        history.Commit(TFormat("Extend the level ", side), pieces, mergesWithLast: true);
        for (let dirty in dirtyPieces) {
            *dirty = false;
        }
        for (let index in 0..data.layers.len) {
            RebuildDrawing(index);
        }
    }

    // The layer's cells in pixels (a Decals layer: the level's tiles)
    Vec2i CellSizeOf(LevelLayer* layer) {
        switch (layer.case) {
        case LevelLayer.Tiles: return layer.tileDim;
        case LevelLayer.Autotiles: return Vec2i(data.pixelSize.x / Max(1, layer.solid.w), data.pixelSize.y / Max(1, layer.solid.h));
        case LevelLayer.Decals: return Vec2i(data.tileSize, data.tileSize);
        }
    }

    // Why the layer cannot be painted ("": it can)
    string WhyNotPaintable(LevelLayer* layer) {
        if (layer.isLocked)
            return "the layer is locked";
        if (layer.isHidden)
            return "the layer is hidden";
        return "";
    }

    // The mouse on the selected layer: the hovered cell (the brush, the stamp), the brush's
    // strokes, lines and rectangles, the eyedropper (a tile, a region: a stamp), the stamp keys
    void Paint(LevelLayer* layer, LayerDrawing* drawing) {
        let cellSize = CellSizeOf(layer);
        let world = Input.cursors.world;
        let cell = Vec2i((int)Floor(world.x / cellSize.x), (int)Floor(world.y / cellSize.y));
        let layerCells = layer.case == LevelLayer.Tiles ? layer.tiles.dim : layer.case == LevelLayer.Autotiles ? layer.solid.dim : data.size;
        let isInside = 0 <= cell.x && cell.x < layerCells.x && 0 <= cell.y && cell.y < layerCells.y;
        let isOverUi = Ui.isMouseOverPanel;
        let refusal = WhyNotPaintable(layer);
        let alt = Input.KeyDown(Scancode.LAlt) || Input.KeyDown(Scancode.RAlt);
        let shift = Input.KeyDown(Scancode.LShift) || Input.KeyDown(Scancode.RShift);
        let ctrl = Input.KeyDown(Scancode.LCtrl) || Input.KeyDown(Scancode.RCtrl);

        // The brush's size: W bigger, S smaller (held down: repeated; not with Ctrl: Ctrl+S saves)
        if (!ctrl) {
            if (Input.KeyRepeated(Scancode.W))
                brushSize = Min(BRUSH_SIZE_MAX, brushSize + 1);
            if (Input.KeyRepeated(Scancode.S))
                brushSize = Max(1, brushSize - 1);
        }
        // The stamps: 1 .. 9, 0 paint with a slot's, Ctrl + them keep the stamp in the slot
        if (layer.case == LevelLayer.Tiles && !isPainting)
            StampKeys(layer, ctrl);
        let stampTiles = ActiveStamp(layer);
        let randomBag = RandomBagOf(layer);
        let isBagEmpty = randomBag != null && randomBag.len == 0;
        let stampHalf = stampTiles != null ? Vec2i((stampTiles.w - 1) / 2, (stampTiles.h - 1) / 2) : Vec2i(0, 0);

        // A rectangle or a line being dragged is cancelled by the other button (left draws, right
        // cancels; right erases, left cancels); then nothing starts until both buttons are up
        let isDragTool = tool == EditorTool.Rect || tool == EditorTool.Line;
        let otherPressed = isErasing ? Input.MousePressed(MouseButton.Left) : Input.MousePressed(MouseButton.Right);
        if (isPainting && isDragTool && otherPressed) {
            isPainting = false;
            waitsForRelease = true;        // (a rectangle or a line paints nothing before its release: no step)
        }
        if (waitsForRelease && !Input.MouseDown(MouseButton.Left) && !Input.MouseDown(MouseButton.Right))
            waitsForRelease = false;

        // Shift with the brush: a line from where the last stroke on this layer ended
        let linesFromLast = tool == EditorTool.Brush && shift && hasLastPainted && lastPaintedLayer == selected && stampTiles == null;

        // A stroke starts with a press over the level (not over a panel) and ends with the release
        let pressed = Input.MousePressed(MouseButton.Left) || Input.MousePressed(MouseButton.Right);
        if (pressed && !isOverUi && isInside && !isPainting && !isPickingRegion && !waitsForRelease) {
            if (alt || tool == EditorTool.Pick) {
                if (layer.case == LevelLayer.Tiles) {
                    isPickingRegion = true;
                    strokeStart = cell;
                }
            } else if (refusal.len == 0 && isBagEmpty && Input.MousePressed(MouseButton.Left)) {
                Draw.LogSticky(180, Color.Orange, "Not painted: the random bag is empty (left click tiles in the palette, N: random off)");
            } else if (refusal.len == 0) {
                isPainting = true;
                isErasing = Input.MousePressed(MouseButton.Right);
                if (randomBag != null)
                    StartRandomStroke(layer);
                strokeStart = cell;
                strokeLast = cell;
                isStrokeLine = false;
                stampAnchor = cell - stampHalf;
                if (tool == EditorTool.Brush) {
                    isStrokeLine = linesFromLast;
                    if (stampTiles != null)
                        PaintMask(layer, drawing, StampCells(stampTiles, stampAnchor, Vec2i(0, 0), Vec2i(0, 0)));
                    else
                        PaintMask(layer, drawing, StrokeCells(linesFromLast ? lastPainted : cell, cell, brushSize));
                }
            }
        }
        let held = isErasing ? Input.MouseDown(MouseButton.Right) : Input.MouseDown(MouseButton.Left);
        if (isPainting && held && tool == EditorTool.Brush && cell != strokeLast) {
            // (along the way from last frame's cell: a fast mouse leaves no gaps; a stamp's
            // stroke puts it down side by side)
            if (stampTiles != null)
                PaintMask(layer, drawing, StampCells(stampTiles, stampAnchor, StampPlaceOf(stampTiles, strokeLast), StampPlaceOf(stampTiles, cell)));
            else
                PaintMask(layer, drawing, StrokeCells(strokeLast, cell, brushSize));
            strokeLast = cell;
        }
        // (Shift with the line: horizontal, vertical or diagonal)
        let lineEnd = shift ? SnappedLineEnd(strokeStart, cell) : cell;
        let rect = Recti(Min(strokeStart.x, cell.x), Min(strokeStart.y, cell.y), Abs(cell.x - strokeStart.x) + 1, Abs(cell.y - strokeStart.y) + 1);
        if (isPainting && !held) {
            if (tool == EditorTool.Rect)
                PaintMask(layer, drawing, stampTiles != null ? StampFill(stampTiles, rect, stampAnchor) : RectCells(rect));
            if (tool == EditorTool.Line)
                PaintMask(layer, drawing, LineCells(stampTiles, lineEnd));
            isPainting = false;
            if (tool != EditorTool.Rect) {
                hasLastPainted = true;
                lastPainted = tool == EditorTool.Line ? lineEnd : strokeLast;
                lastPaintedLayer = selected;
            }
            let what = tool == EditorTool.Rect ? "a rectangle on " : tool == EditorTool.Line || isStrokeLine ? "a line on " : "";
            Commit(TFormat(isErasing ? "Erase " : stampTiles != null ? "Stamp " : "Paint ", what, layer.name));
        }
        // The eyedropper's release: one cell picks its tile, a region becomes the stamp
        if (isPickingRegion && !Input.MouseDown(MouseButton.Left) && !Input.MouseDown(MouseButton.Right)) {
            isPickingRegion = false;
            PickRegion(layer, Recti.Intersect(rect, layer.tiles.rect), alt);
        }

        // What the mouse is on: the brush or the stamp (or the rectangle, the line being dragged),
        // red if it cannot be painted
        if (isOverUi && !isPainting && !isPickingRegion)
            return;
        let color = refusal.len > 0 ? Color(0.8, 0.2, 0.2, 0.8) : isErasing && isPainting ? Color(0.8, 0.4, 0.2, 0.8) : Color(0.9, 0.9, 0.9, 0.9);
        if (isPickingRegion) {
            let region = RectCells(rect);
            OutlineMask(&region, cellSize, Color(0.4, 0.9, 1, 1));
            return;
        }
        let isPicking = tool == EditorTool.Pick || alt;
        CellMask shown;
        if (isPicking)
            shown = StrokeCells(cell, cell, 1);
        else if (isPainting && tool == EditorTool.Rect)
            shown = stampTiles != null ? StampFill(stampTiles, rect, stampAnchor) : RectCells(rect);
        else if (isPainting && tool == EditorTool.Line)
            shown = LineCells(stampTiles, lineEnd);
        else if (stampTiles != null && isPainting)
            shown = StampCells(stampTiles, stampAnchor, StampPlaceOf(stampTiles, cell), StampPlaceOf(stampTiles, cell));
        else if (stampTiles != null)
            shown = StampCells(stampTiles, cell - stampHalf, Vec2i(0, 0), Vec2i(0, 0));
        else if (tool == EditorTool.Rect && !isPainting)
            shown = StrokeCells(cell, cell, 1);
        else if (!isPainting && linesFromLast)
            shown = StrokeCells(lastPainted, cell, brushSize);
        else
            shown = StrokeCells(cell, cell, brushSize);
        // ... and what painting there would do: the tile or the stamp (hovering, a rectangle or a
        // line being dragged), red where it erases, the solid or open cells of an autotile layer
        if (refusal.len == 0 && !isPicking)
            PreviewMask(layer, drawing, &shown, cellSize, isPainting && isErasing);
        OutlineMask(&shown, cellSize, color);
        if (refusal.len > 0 && isInside)
            Draw.LogLineColored(Color.Orange, "Not painted: ", refusal);
        else if (isBagEmpty && isInside)
            Draw.LogLineColored(Color.Orange, "Random: the bag is empty (left click tiles in the palette, N: random off)");
    }

    // The line being dragged from strokeStart to 'end': the brush along it, or the stamp side by
    // side (on the grid of the stroke's first one)
    CellMask LineCells(Grid[byte]* stampTiles, Vec2i end) {
        if (stampTiles != null)
            return StampCells(stampTiles, stampAnchor, Vec2i(0, 0), StampPlaceOf(stampTiles, end));
        return StrokeCells(strokeStart, end, brushSize);
    }

    //----------------------------------------------------------------------------------------------
    // Stamps

    // The stamp painted on 'layer' (null: the palette's tile)
    Grid[byte]* ActiveStamp(LevelLayer* layer) {
        if (layer.case != LevelLayer.Tiles || stamp.w == 0 || stampTileset.view != layer.tileset || isRandom)
            return null;
        return &stamp;
    }

    // The slots of 'tileset' (read from its file the first time)
    StampSet* StampSetOf(string tileset) {
        for (let index in 0..stampSets.len) {
            if (stampSets[index].tileset.view == tileset)
                return &stampSets[index];
        }
        ScopeAlloc(history.allocator);
        stampSets.Add(StampSet.Load(tileset));
        return &stampSets[stampSets.len - 1];
    }

    // Paint with a copy of 'tiles' (of 'tileset'; 'slot': the slot it is, -1: none)
    void UseStamp(Grid[byte] tiles, string tileset, int slot) {
        ScopeAlloc(history.allocator);
        stamp.Free();
        stamp = tiles.Clone();
        stampTileset.Clear();
        stampTileset.Append(tileset);
        stampSlot = slot;
    }

    // Paint with the palette's tile again
    void DropStamp() {
        ScopeAlloc(history.allocator);
        stamp.Free();
        stampSlot = -1;
    }

    // 1 .. 9, 0: paint with the slot's stamp; with Ctrl: the stamp (picked or a slot's) kept in the
    // slot, the tileset's file written
    void StampKeys(LevelLayer* layer, bool ctrl) {
        for (let slot in 0..STAMP_SLOTS) {
            let key = StampSet.KeyOf(slot);
            if (!Input.KeyPressed((Scancode)((int)Scancode.Alpha1 + slot)))
                continue;
            let stamps = StampSetOf(layer.tileset);
            if (ctrl) {
                let active = ActiveStamp(layer);
                if (active == null) {
                    Draw.LogSticky(180, Color.Orange, "No stamp to keep in slot ", key, ": pick a region first (I and drag)");
                    continue;
                }
                {
                    ScopeAlloc(history.allocator);
                    stamps.slots[slot].Free();
                    stamps.slots[slot] = active.Clone();
                }
                stampSlot = slot;
                if (stamps.Save())
                    Draw.LogSticky(180, Color.Green, "Stamp ", active.w, " x ", active.h, " kept in slot ", key, " (", StampSet.PathOf(layer.tileset), ")");
                else
                    Draw.LogSticky(180, Color.Orange, "Stamp kept in slot ", key, INTERNAL ? ", but its file could not be written" : " for this run (files are written in the internal mode)");
            } else if (stamps.slots[slot].w == 0) {
                Draw.LogSticky(180, Color.Orange, "Slot ", key, " is empty: pick a region (I and drag), Ctrl+", key, " keeps it there");
            } else {
                UseStamp(stamps.slots[slot], layer.tileset, slot);
                isRandom = false;
            }
        }
    }

    // The eyedropper let go over 'region' (in the layer): one cell picks its tile (the stamp
    // dropped), more cells become the stamp (in no slot yet; the brush paints it, unless Alt
    // picked it)
    void PickRegion(LevelLayer* layer, Recti region, bool alt) {
        if (region.w <= 0 || region.h <= 0)
            return;
        if (region.w == 1 && region.h == 1) {
            let picked = layer.tiles.Get(region.pos);
            if (picked != TILE_EMPTY) {
                tile = picked;
                DropStamp();
                isRandom = false;
            }
            return;
        }
        ScopeAllocTemp();
        let tiles = Grid[byte](region.w, region.h, TILE_EMPTY);
        let isEmpty = true;
        for (let y in 0..region.h) {
            for (let x in 0..region.w) {
                let value = layer.tiles.Get(Vec2i(region.x + x, region.y + y));
                tiles.Set(Vec2i(x, y), value);
                isEmpty = isEmpty && value == TILE_EMPTY;
            }
        }
        if (isEmpty) {
            Draw.LogSticky(180, Color.Orange, "Nothing picked: the region has no tiles");
            return;
        }
        UseStamp(tiles, layer.tileset, -1);
        isRandom = false;
        if (!alt)
            tool = EditorTool.Brush;
    }

    // The place of the stroke's stamp grid that 'cell' is in (place p: the stamp's left top at
    // stampAnchor + p * its size)
    Vec2i StampPlaceOf(Grid[byte]* tiles, Vec2i cell) {
        return Vec2i(FloorDiv(cell.x - stampAnchor.x, tiles.w), FloorDiv(cell.y - stampAnchor.y, tiles.h));
    }

    static int FloorDiv(int value, int divisor) { return value >= 0 ? value / divisor : -((-value + divisor - 1) / divisor); }

    // The stamp (its tiles, not its empty cells) at each of its places on the line from place
    // 'from' to place 'to' (Bresenham; place p: its left top at 'anchor' + p * its size)
    CellMask StampCells(Grid[byte]* tiles, Vec2i anchor, Vec2i from, Vec2i to) {
        let dim = tiles.dim;
        let low = Vec2i(anchor.x + Min(from.x, to.x) * dim.x, anchor.y + Min(from.y, to.y) * dim.y);
        let size = Vec2i((Abs(to.x - from.x) + 1) * dim.x, (Abs(to.y - from.y) + 1) * dim.y);
        let mask = CellMask.Make(Recti(low, size), true);
        Line(Vec2(from), Vec2(to)).IterateBresenham(true, (Vec2i place) => mask.PutStamp(tiles, Vec2i(anchor.x + place.x * dim.x - low.x, anchor.y + place.y * dim.y - low.y)));
        return mask;
    }

    // 'rect' filled with the stamp side by side (on the grid of the one at 'anchor')
    CellMask StampFill(Grid[byte]* tiles, Recti rect, Vec2i anchor) {
        let mask = CellMask.Make(rect, true);
        for (let y in 0..rect.h) {
            for (let x in 0..rect.w) {
                let inStamp = Vec2i(PositiveMod(rect.x + x - anchor.x, tiles.w), PositiveMod(rect.y + y - anchor.y, tiles.h));
                let value = tiles.Get(inStamp);
                if (value != TILE_EMPTY) {
                    mask.marks.Set(Vec2i(x, y), true);
                    mask.tiles.Set(Vec2i(x, y), value);
                }
            }
        }
        return mask;
    }

    static int PositiveMod(int value, int divisor) { return ((value % divisor) + divisor) % divisor; }

    // The brush ('size' cells across, square or round: isBrushRound) at each cell of the line from
    // 'from' to 'to' (Bresenham; the same cell: one stamp), the cell in the brush's middle (left
    // top of the middle for even sizes)
    CellMask StrokeCells(Vec2i from, Vec2i to, int size) {
        let half = (size - 1) / 2;
        let low = Vec2i(Min(from.x, to.x) - half, Min(from.y, to.y) - half);
        let mask = CellMask.Make(Recti(low, Vec2i(Abs(to.x - from.x) + size, Abs(to.y - from.y) + size)));
        let isRound = isBrushRound;
        Line(Vec2(from), Vec2(to)).IterateBresenham(true, (Vec2i point) => mask.Stamp(Vec2i(point.x - half - low.x, point.y - half - low.y), size, isRound));
        return mask;
    }

    CellMask RectCells(Recti rect) {
        let mask = CellMask.Make(rect);
        mask.marks.Fill(true);
        return mask;
    }

    // A line's end moved to the nearest of the 8 directions from its start (horizontal, vertical,
    // diagonal)
    static Vec2i SnappedLineEnd(Vec2i start, Vec2i end) {
        let dx = end.x - start.x;
        let dy = end.y - start.y;
        let ax = (float)Abs(dx);
        let ay = (float)Abs(dy);
        if (ay < ax * 0.4142)              // (tan 22.5 degrees)
            return Vec2i(end.x, start.y);
        if (ax < ay * 0.4142)
            return Vec2i(start.x, end.y);
        let length = Max(Abs(dx), Abs(dy));
        return Vec2i(start.x + (dx < 0 ? -length : length), start.y + (dy < 0 ? -length : length));
    }

    // The cells of 'mask' painted (those in the layer)
    void PaintMask(LevelLayer* layer, LayerDrawing* drawing, CellMask mask) {
        let bag = isErasing || mask.tiles.w > 0 ? null : RandomBagOf(layer);
        for (let y in 0..mask.marks.h) {
            for (let x in 0..mask.marks.w) {
                if (!mask.marks.Get(Vec2i(x, y)))
                    continue;
                let cell = Vec2i(mask.origin.x + x, mask.origin.y + y);
                if (bag != null) {
                    // (a tile from the bag for each cell the stroke has not painted yet: in the
                    // order PreviewMask shows them)
                    if (!layer.tiles.ContainsCoord(cell.x, cell.y) || IsStrokePainted(cell) || bag.len == 0)
                        continue;
                    strokePainted.Set(cell, true);
                    PaintCell(layer, drawing, cell, bag.Next());
                } else {
                    PaintCell(layer, drawing, cell, mask.tiles.w > 0 ? mask.tiles.Get(Vec2i(x, y)) : tile);
                }
            }
        }
    }

    //----------------------------------------------------------------------------------------------
    // Random painting

    // The bag the tiles come from (random painting on a Tiles layer without a stamp), else null
    ShuffleBag[byte]* RandomBagOf(LevelLayer* layer) {
        if (!isRandom || layer.case != LevelLayer.Tiles)
            return null;
        return TileBagOf(layer.tileset);
    }

    // The random bag of 'tileset' (a new one, empty, the first time)
    ShuffleBag[byte]* TileBagOf(string tileset) {
        for (let index in 0..tileBags.len) {
            if (tileBags[index].tileset.view == tileset)
                return &tileBags[index].bag;
        }
        ScopeAlloc(history.allocator);
        let name = String();
        name.Append(tileset);
        tileBags.Add(TileBag(name, ShuffleBag[byte]((ulong)LevelEditorRunId() ^ Hash(tileset))));
        return &tileBags[tileBags.len - 1].bag;
    }

    // A random stroke begins: none of the layer's cells painted by it yet
    void StartRandomStroke(LevelLayer* layer) {
        if (strokePainted.w != layer.tiles.w || strokePainted.h != layer.tiles.h) {
            ScopeAlloc(history.allocator);
            strokePainted.Free();
            strokePainted = Grid[bool](layer.tiles.w, layer.tiles.h, false);
        } else {
            strokePainted.Fill(false);
        }
    }

    bool IsStrokePainted(Vec2i cell) { return strokePainted.ContainsCoord(cell.x, cell.y) && strokePainted.Get(cell); }

    // What painting the cells of 'mask' would give, drawn over the level (just under the grid): the
    // palette's tile at 80%, erasing a red tint; an autotile layer's solid cells blue, open ones red
    void PreviewMask(LevelLayer* layer, LayerDrawing* drawing, CellMask* mask, Vec2i cellSize, bool erases) {
        let depth = Depth.Nearest - 1;
        let layerRect = layer.case == LevelLayer.Tiles ? layer.tiles.rect : layer.case == LevelLayer.Autotiles ? layer.solid.rect : Recti(0, 0, 0, 0);
        let clipped = Recti.Intersect(mask.rect, layerRect);
        let isTile = layer.case == LevelLayer.Tiles && !erases;
        let tileset = isTile ? &drawing.tilemap.tileset : null;
        // (random: the tiles the bag gives next, cell by cell in PaintMask's order; a stroke's
        // painted cells are the layer's already)
        let bag = isTile && mask.tiles.w == 0 ? RandomBagOf(layer) : null;
        let skipsPainted = bag != null && isPainting && tool == EditorTool.Brush;
        List[byte] coming;
        if (bag != null) {
            let count = 0;
            for (let y in clipped.y..clipped.y + clipped.h) {
                for (let x in clipped.x..clipped.x + clipped.w) {
                    if (mask.Has(x, y) && !(skipsPainted && IsStrokePainted(Vec2i(x, y))))
                        count++;
                }
            }
            coming = bag.Peek(count);
        }
        let comingIndex = 0;
        let tint = erases ? Color(0.45, 0.05, 0.05, 0.45) : Color(0.1, 0.25, 0.55, 0.45);
        for (let y in clipped.y..clipped.y + clipped.h) {
            for (let x in clipped.x..clipped.x + clipped.w) {
                if (!mask.Has(x, y) || (skipsPainted && IsStrokePainted(Vec2i(x, y))))
                    continue;
                let pos = Vec2(Vec2i(x, y) * cellSize);
                if (isTile) {
                    let value = bag != null ? (comingIndex < coming.len ? coming[comingIndex++] : TILE_EMPTY) : mask.TileAt(x, y, tile);
                    if (value < tileset.count)
                        tileset.Draw(value, pos, depth, DrawParams(color: Color(0.8, 0.8, 0.8, 0.8)));
                } else
                    Draw.Rect(pos, Vec2(cellSize), depth, DrawParams(color: tint));
            }
        }
    }

    // The outline of the cells of 'mask' (the edges between a marked cell and an unmarked one)
    void OutlineMask(CellMask* mask, Vec2i cellSize, Color color) {
        let width = 2 / Camera.zoom;
        let params = DrawParams(color: color, space: DrawSpace.ScreenWorld);
        for (let y in mask.origin.y..mask.origin.y + mask.marks.h) {
            for (let x in mask.origin.x..mask.origin.x + mask.marks.w) {
                if (!mask.Has(x, y))
                    continue;
                let left = (float)(x * cellSize.x);
                let top = (float)(y * cellSize.y);
                let right = (float)((x + 1) * cellSize.x);
                let bottom = (float)((y + 1) * cellSize.y);
                if (!mask.Has(x - 1, y))
                    Draw.Line(Vec2(left, top), Vec2(left, bottom), width, Depth.Nearest, params);
                if (!mask.Has(x + 1, y))
                    Draw.Line(Vec2(right, top), Vec2(right, bottom), width, Depth.Nearest, params);
                if (!mask.Has(x, y - 1))
                    Draw.Line(Vec2(left, top), Vec2(right, top), width, Depth.Nearest, params);
                if (!mask.Has(x, y + 1))
                    Draw.Line(Vec2(left, bottom), Vec2(right, bottom), width, Depth.Nearest, params);
            }
        }
    }

    // One cell of the stroke: the palette's tile (Tiles), solid (Autotiles), or erased
    void PaintCell(LevelLayer* layer, LayerDrawing* drawing, Vec2i cell, byte tileValue) {
        if (layer.case == LevelLayer.Tiles) {
            if (!layer.tiles.ContainsCoord(cell.x, cell.y))
                return;
            let value = isErasing ? TILE_EMPTY : tileValue;
            if (layer.tiles.Get(cell) == value)
                return;
            layer.tiles.Set(cell, value);
            drawing.tilemap.Set(cell, value);
            MarkDirty(selected + 1);
        } else if (layer.case == LevelLayer.Autotiles) {
            if (!layer.solid.ContainsCoord(cell.x, cell.y))
                return;
            let value = !isErasing;
            if (layer.solid.Get(cell) == value)
                return;
            layer.solid.Set(cell, value);
            drawing.autotiles.Set(cell, value);
            MarkDirty(selected + 1);
        }
    }

    void OutlineRect(Rect rect, Color color) {
        let width = 2 / Camera.zoom;
        let params = DrawParams(color: color, space: DrawSpace.ScreenWorld);
        let corners = [rect.pos, Vec2(rect.right, rect.top), Vec2(rect.right, rect.bottom), Vec2(rect.left, rect.bottom)];
        for (let index in 0..4) {
            Draw.Line(corners[index], corners[(index + 1) % 4], width, Depth.Nearest, params);
        }
    }

    // The level into its file (the internal mode); false if it was not saved
    bool Save() {
        if (!INTERNAL) {
            Draw.LogSticky(180, Color.Orange, "Not saved: levels are saved in the internal mode");
            return false;
        }
        let path = LevelPath(levelName);
        if (!data.SaveFile(path)) {
            Draw.LogSticky(300, Color.Red, "Could not save ", path);
            Window.ShowMessageBox("Level not saved", TFormat("Could not write ", path), ["OK"]);
            return false;
        }
        history.MarkSaved();
        WriteSession();
        Draw.LogSticky(180, Color.Green, "Saved ", path);
        return true;
    }

    // Before the level's unsaved changes would be lost ('doing': "quitting", "leaving the
    // level"): save them, drop them or stay; true: go on
    bool AskAboutChanges(string doing) {
        if (!isModified || isChangeDropped)
            return true;
        let choice = Window.ShowMessageBox("Unsaved level", TFormat("The level '", levelName, "' has unsaved changes. Save them before ", doing, "?"),
            ["Save", "Don't save", "Cancel"]);
        if (choice == 0)
            return Save();
        isChangeDropped = choice == 1;   // (-1, no message box: stay)
        return isChangeDropped;
    }

    //----------------------------------------------------------------------------------------------
    // Decals: Place (a ghost at the mouse, a click puts it down), Select (a click picks the topmost
    // under the mouse, dragging moves it, Delete removes it), V switches between them; Q/E rotate
    // (Shift: 1 degree, else 15), W/S scale, A/D opacity, F flips (Shift+F: vertically): the next
    // decal's, or the selected one's; held keys repeat

    // The layer's decals as sprites (the editor's: moved and deleted ones show at once)
    void DrawDecals(LevelLayer* layer) {
        for (let item in layer.decals) {
            let sprite = Draw.SpriteOrMissing(item.sprite, Vec2i(16, 16));
            Draw.Sprite(sprite, Transform(item.pos, item.angle, item.scale), layer.depth, DrawParams(color: item.color), item.flipHorizontal, item.flipVertical);
        }
    }

    // The decal's corners in the level (its sprite placed as it is drawn)
    static Quad DecalQuad(LevelDecal* item) {
        let sprite = Draw.SpriteOrMissing(item.sprite, Vec2i(16, 16));
        return sprite.ToQuad(Transform(item.pos, item.angle, item.scale), item.flipHorizontal, item.flipVertical);
    }

    static bool QuadContains(Quad quad, Vec2 point) {
        // (inside all four edges, going around: the same side of each)
        [Vec2, 4] corners = [quad.leftTop, quad.rightTop, quad.rightBottom, quad.leftBottom];
        let sign = 0.0;
        for (let index in 0..4) {
            let a = corners[index];
            let b = corners[(index + 1) % 4];
            let cross = (b.x - a.x) * (point.y - a.y) - (b.y - a.y) * (point.x - a.x);
            if (cross == 0)
                continue;
            if (sign == 0)
                sign = cross;
            else if ((cross > 0) != (sign > 0))
                return false;
        }
        return true;
    }

    void OutlineQuad(Quad quad, Color color) {
        let width = 2 / Camera.zoom;
        let params = DrawParams(color: color, space: DrawSpace.ScreenWorld);
        [Vec2, 4] corners = [quad.leftTop, quad.rightTop, quad.rightBottom, quad.leftBottom];
        for (let index in 0..4) {
            Draw.Line(corners[index], corners[(index + 1) % 4], width, Depth.Nearest, params);
        }
    }

    // A position as it is stored (to 1/100 px: not snapped, only no float noise in the file)
    static Vec2 StoredPos(Vec2 pos) { return Vec2(Round(pos.x * 100) / 100, Round(pos.y * 100) / 100); }

    void EditDecals(LevelLayer* layer) {
        let world = Input.cursors.world;
        let isOverUi = Ui.isMouseOverPanel;
        let shift = Input.KeyDown(Scancode.LShift) || Input.KeyDown(Scancode.RShift);
        let ctrl = Input.KeyDown(Scancode.LCtrl) || Input.KeyDown(Scancode.RCtrl);
        let refusal = WhyNotPaintable(layer);
        if (selectedDecal >= layer.decals.len)
            selectedDecal = -1;
        if (tool != EditorTool.Select)
            selectedDecal = -1;

        // The keys change the selected decal, else the next one
        let target = selectedDecal >= 0 ? &layer.decals[selectedDecal] : &decal;
        let angleStep = shift ? 1.0 : 15.0;          // (degrees, as Transform's)
        let changed = "";
        if (!ctrl) {
            // (held down: repeated; the steps of one kind join into one undo step)
            if (Input.KeyRepeated(Scancode.Q)) { target.angle -= angleStep; changed = "Rotate decal"; }
            if (Input.KeyRepeated(Scancode.E)) { target.angle += angleStep; changed = "Rotate decal"; }
            if (Input.KeyRepeated(Scancode.W)) { target.scale = target.scale * (float)(shift ? 1.05 : 1.25); changed = "Scale decal"; }
            if (Input.KeyRepeated(Scancode.S)) { target.scale = target.scale * (float)(shift ? 1 / 1.05 : 1 / 1.25); changed = "Scale decal"; }
            let opacityStep = shift ? 0.01 : 0.1;
            let opacity = target.color.a;
            let isOpacityChanged = false;
            if (Input.KeyRepeated(Scancode.A)) { opacity = Max(0.05, opacity - opacityStep); isOpacityChanged = true; }
            if (Input.KeyRepeated(Scancode.D)) { opacity = Min(1.0, opacity + opacityStep); isOpacityChanged = true; }
            if (isOpacityChanged) {
                opacity = Round(opacity * 100) / 100;
                target.color = Color(opacity, opacity, opacity, opacity);     // (premultiplied white)
                changed = "Change decal opacity";
            }
            if (Input.KeyPressed(Scancode.F)) {
                if (shift)
                    target.flipVertical = !target.flipVertical;
                else
                    target.flipHorizontal = !target.flipHorizontal;
                changed = "Flip decal";
            }
        }
        target.angle = Round(target.angle * 100) / 100;
        if (changed.len > 0 && selectedDecal >= 0)
            CommitDecals(changed, true);
        if (selectedDecal >= 0 && (Input.KeyPressed(Scancode.Delete) || Input.KeyPressed(Scancode.Backspace)) && refusal.len == 0) {
            layer.decals.RemoveAt(selectedDecal);
            selectedDecal = -1;
            CommitDecals("Delete decal", false);
        }

        if (tool == EditorTool.Place) {
            if (isOverUi)
                return;
            // (random: the rolled one; a right click rolls another)
            if (isDecalRandom && (needsRoll || rolledDecal.sprite != decal.sprite || Input.MousePressed(MouseButton.Right)))
                RollDecal();
            let next = isDecalRandom ? rolledDecal : decal;
            // (centered on the mouse: 'pos' is the sprite's pivot, the corner of a sprite without one)
            let ghost = next;
            ghost.pos = world;
            let quad = DecalQuad(&ghost);
            let center = (quad.leftTop + quad.rightTop + quad.rightBottom + quad.leftBottom) * 0.25;
            ghost.pos = StoredPos(world + (world - center));
            ghost.color = Color(ghost.color.r * 0.7, ghost.color.g * 0.7, ghost.color.b * 0.7, ghost.color.a * 0.7);
            let sprite = Draw.SpriteOrMissing(ghost.sprite, Vec2i(16, 16));
            Draw.Sprite(sprite, Transform(ghost.pos, ghost.angle, ghost.scale), Depth.Nearest - 1, DrawParams(color: ghost.color), ghost.flipHorizontal, ghost.flipVertical);
            OutlineQuad(DecalQuad(&ghost), refusal.len > 0 ? Color(0.8, 0.2, 0.2, 0.8) : Color(0.9, 0.9, 0.9, 0.9));
            if (Input.MousePressed(MouseButton.Left)) {
                if (refusal.len > 0) {
                    Draw.LogSticky(120, Color.Orange, "Not placed: ", refusal);
                } else {
                    let placed = next;
                    placed.pos = ghost.pos;
                    layer.decals.Add(placed);
                    CommitDecals("Place decal", false);
                    needsRoll = true;
                }
            }
            return;
        }

        // Select: the topmost under the mouse (the last drawn), dragging it moves it
        if (!isOverUi && Input.MousePressed(MouseButton.Left)) {
            selectedDecal = -1;
            for (let index = layer.decals.len - 1; index >= 0; index--) {
                if (QuadContains(DecalQuad(&layer.decals[index]), world)) {
                    selectedDecal = index;
                    isMovingDecal = refusal.len == 0;
                    moveGrab = world - layer.decals[index].pos;
                    break;
                }
            }
        }
        if (isMovingDecal && selectedDecal >= 0) {
            let moved = StoredPos(world - moveGrab);
            if (moved != layer.decals[selectedDecal].pos) {
                layer.decals[selectedDecal].pos = moved;
                MarkDirty(selected + 1);
            }
            if (!Input.MouseDown(MouseButton.Left)) {
                isMovingDecal = false;
                CommitDecals("Move decal", false);
            }
        }
        // The hovered one, the selected one
        if (!isOverUi) {
            for (let index = layer.decals.len - 1; index >= 0; index--) {
                if (index != selectedDecal && QuadContains(DecalQuad(&layer.decals[index]), world)) {
                    OutlineQuad(DecalQuad(&layer.decals[index]), Color(0.6, 0.6, 0.6, 0.6));
                    break;
                }
            }
        }
        if (selectedDecal >= 0)
            OutlineQuad(DecalQuad(&layer.decals[selectedDecal]), Color(1, 0.94, 0.55, 1));
    }

    // The next random decal: the next one's sprite, its angle, scale and opacity within the ranges
    // (to 1/100), flipped by chance where that is allowed
    void RollDecal() {
        let ranges = &decalRandom;
        let rng = &decalRandomGenerator;
        rolledDecal = decal;
        rolledDecal.angle = Round(rng.Range(ranges.angle.x, ranges.angle.y) * 100) / 100;
        let scale = Round(rng.Range(ranges.scale.x, ranges.scale.y) * 100) / 100;
        rolledDecal.scale = Vec2(scale, scale);
        let opacity = Round(rng.Range(ranges.opacity.x, ranges.opacity.y) * 100) / 100;
        rolledDecal.color = Color(opacity, opacity, opacity, opacity);     // (premultiplied white)
        rolledDecal.flipHorizontal = ranges.flipsHorizontal && rng.NextBool();
        rolledDecal.flipVertical = ranges.flipsVertical && rng.NextBool();
        needsRoll = false;
    }

    // A random range in a row: its name and values, a slider with a knob for each end (hope's
    // RangeSlider: they meet, they do not cross); true when it changed
    bool RangeRow(string name, Vec2* range, float min, float max, float step, int id) {
        let label = step >= 1 ? TFormat(name, " ", (int)Round(range.x), "..", (int)Round(range.y)) : TFormat(name, " ", FormatFloat(range.x, 2), "..", FormatFloat(range.y, 2));
        let from = range.x;
        let to = range.y;
        if (!Ui.RangeSlider(label, &from, &to, min, max, step, id: id))
            return false;
        range.x = Round(from * 100) / 100;
        range.y = Round(to * 100) / 100;
        return true;
    }

    // The selected Decals layer changed: a step ('merges': joins the last one of its name: a key
    // held, a slider dragged)
    void CommitDecals(string name, bool merges) {
        MarkDirty(selected + 1);
        ScopeAllocTemp();
        List[string] pieces;
        for (let index in 0..data.layers.len + 1) {
            let isDirty = index < dirtyPieces.len && dirtyPieces[index];
            pieces.Add(isDirty || index >= history.current.len ? PieceText(index) : history.current[index].view);
        }
        history.Commit(name, pieces, mergesWithLast: merges);
        for (let dirty in dirtyPieces) {
            *dirty = false;
        }
    }

    // The sprites decals can be (decal_ ones first, then every other one but font glyphs and
    // the atlas's own), made again when the atlas changes
    void RefreshDecalSprites() {
        if (decalSpritesAtlas == Draw.atlasVersion)
            return;
        decalSpritesAtlas = Draw.atlasVersion;
        decalSprites.Clear();
        ScopeAllocTemp();
        DictSet[ulong] glyphs;
        for (let font in Draw.state.pack.fonts) {
            for (let codepoint, glyph in font.glyphs) {
                glyphs.Add((ulong)(uptr)glyph.sprite);
            }
        }
        List[string] decals;
        List[string] others;
        for (let sprite in Draw.state.pack.atlas.sprites) {
            if (glyphs.Contains((ulong)(uptr)sprite) || sprite.name == "untextured" || sprite.name.StartsWith("@"))
                continue;
            if (sprite.name.StartsWith("decal_"))
                decals.Add(sprite.name);
            else
                others.Add(sprite.name);
        }
        {
            ScopeAlloc(decalSprites.allocator);
            for (let name in decals) {
                decalSprites.Add(name.Copy());
            }
            for (let name in others) {
                decalSprites.Add(name.Copy());
            }
        }
    }

    // The next decal's (or the selected one's) look, and the sprite list
    void DecalPanel(LevelLayer* layer) {
        let isSelected = selectedDecal >= 0 && selectedDecal < layer.decals.len;
        let target = isSelected ? &layer.decals[selectedDecal] : &decal;
        if (!isSelected) {
            Ui.Columns(2, 0.6);
            Ui.Label(TFormat("next: ", target.sprite), UiAlign.Left);
            if (Ui.Button("Random N", isToggled: isDecalRandom)) {
                isDecalRandom = !isDecalRandom;
                needsRoll = true;
            }
        } else {
            Ui.Label(TFormat("selected: ", target.sprite), UiAlign.Left);
        }
        if (!isSelected && isDecalRandom) {
            // Random placement: the ranges each decal is rolled in (a right click: another roll)
            let isChanged = RangeRow("angle", &decalRandom.angle, -180, 180, 1, 0);
            isChanged = RangeRow("scale", &decalRandom.scale, 0.25, 4, 0.05, 1) || isChanged;
            isChanged = RangeRow("opacity", &decalRandom.opacity, 0.05, 1, 0.05, 2) || isChanged;
            {
                Ui.Columns(2);
                isChanged = Ui.Checkbox("flips x", &decalRandom.flipsHorizontal) || isChanged;
                isChanged = Ui.Checkbox("flips y", &decalRandom.flipsVertical) || isChanged;
            }
            if (isChanged)
                needsRoll = true;
            Ui.Label("right click: another roll", UiAlign.Left, Ui.style.textDisabled);
        }
        let degrees = target.angle;
        let scale = target.scale.x;
        let alpha = target.color.a;
        let changed = "";
        // (the next decal's look, the selected one's; random placement has its ranges instead)
        if (isSelected || !isDecalRandom) {
            if (Ui.Slider("angle (Q/E)", &degrees, -180, 180, 1)) {
                target.angle = Round(degrees * 100) / 100;
                changed = "Rotate decal";
            }
            if (Ui.Slider("scale (W/S)", &scale, 0.25, 4, 0.05)) {
                target.scale = Vec2(scale, scale * (target.scale.x != 0 ? target.scale.y / target.scale.x : 1));
                changed = "Scale decal";
            }
            if (Ui.Slider("opacity (A/D)", &alpha, 0.05, 1, 0.05)) {
                target.color = Color(alpha, alpha, alpha, alpha);         // (premultiplied white)
                changed = "Change decal opacity";
            }
            {
                Ui.Columns(2);
                if (Ui.Checkbox("flip x (F)", &target.flipHorizontal))
                    changed = "Flip decal";
                if (Ui.Checkbox("flip y (Shift+F)", &target.flipVertical))
                    changed = "Flip decal";
            }
        }
        if (changed.len > 0 && isSelected)
            CommitDecals(changed, true);
        if (isSelected && Ui.Button("Delete (Del)")) {
            layer.decals.RemoveAt(selectedDecal);
            selectedDecal = -1;
            CommitDecals("Delete decal", false);
            return;
        }
        // The sprites: a click places that one (Place), Shift+click gives it to the selected decal
        RefreshDecalSprites();
        Ui.Label(TFormat(decalSprites.len, " sprites (Shift+click: to the selected)"), UiAlign.Left, Ui.style.textDisabled);
        let shift = Input.KeyDown(Scancode.LShift) || Input.KeyDown(Scancode.RShift);
        {
            Ui.Scroll(Ui.ButtonHeight() * 6 + Ui.style.spacing * 5);
            for (let index, name in decalSprites) {
                let shown = isSelected ? target.sprite : decal.sprite;
                if (SpriteRow(*name, *name == shown, index)) {
                    if (shift && isSelected) {
                        target.sprite = (*name).Copy(history.allocator);
                        CommitDecals("Change decal sprite", false);
                    } else {
                        decal.sprite = (*name).Copy(history.allocator);
                        tool = EditorTool.Place;
                        selectedDecal = -1;
                    }
                }
            }
        }
        Ui.Label(TFormat(layer.decals.len, " decals"), UiAlign.Left, Ui.style.textDisabled);
    }

    // A row of the sprite list: the sprite small (fitted into a square at the left), its name; true
    // when it was clicked
    bool SpriteRow(string name, bool isCurrent, int index) {
        let rect = Ui.NextRect(Ui.ButtonHeight());
        let interaction = Ui.Interact(Ui.Id(Here(), index), rect);
        if (!Ui.isVisible)
            return false;
        let box = Recti(rect.x, rect.y, rect.h, rect.h);
        Ui.DrawButton(Recti(rect.x + box.w + 2, rect.y, rect.w - box.w - 2, rect.h), name, interaction, true, UiAlign.Left, isCurrent);
        Ui.DrawRect(box, Color(0.05, 0.05, 0.07, 1));
        let sprite = Draw.SpriteOrMissing(name, Vec2i(16, 16));
        let quad = sprite.ToQuad(Transform(Vec2(0, 0), 0, Vec2(1, 1)));
        let low = Vec2(Min(Min(quad.leftTop.x, quad.leftBottom.x), Min(quad.rightTop.x, quad.rightBottom.x)), Min(Min(quad.leftTop.y, quad.leftBottom.y), Min(quad.rightTop.y, quad.rightBottom.y)));
        let high = Vec2(Max(Max(quad.leftTop.x, quad.leftBottom.x), Max(quad.rightTop.x, quad.rightBottom.x)), Max(Max(quad.leftTop.y, quad.leftBottom.y), Max(quad.rightTop.y, quad.rightBottom.y)));
        let size = high - low;
        let inner = (float)(box.w - 4);
        let scale = Min(inner / Max(1.0, size.x), inner / Max(1.0, size.y));
        let place = (Vec2 corner) => Vec2(box.x + 2, box.y + 2) + (corner - low) * scale + (Vec2(inner, inner) - size * scale) * 0.5;
        quad.leftTop = place(quad.leftTop);
        quad.leftBottom = place(quad.leftBottom);
        quad.rightTop = place(quad.rightTop);
        quad.rightBottom = place(quad.rightBottom);
        let clipped = quad.Clipped(Ui.currentClip);
        if (clipped.isVisible)
            Draw.SpriteQuad(sprite, clipped.quad, Ui.NextDepth(), DrawParams(space: DrawSpace.UI));
        return interaction.isClicked;
    }

    // The level's tile grid and its edge, at the window's resolution (thin at any zoom); only when
    // the tiles are at least 4 pixels on screen
    void DrawGrid(Rect view) {
        let size = data.pixelSize;
        let tile = data.tileSize;
        let lineWidth = 1 / Camera.zoom;
        let grid = DrawParams(color: Color(0.08, 0.08, 0.08, 0.08), space: DrawSpace.ScreenWorld);     // (premultiplied: white at 8%)
        if (tile * Camera.zoom >= 4) {
            let first = Vec2i(Max(0, (int)(view.left / tile)), Max(0, (int)(view.top / tile)));
            let last = Vec2i(Min(data.size.x, (int)(view.right / tile) + 1), Min(data.size.y, (int)(view.bottom / tile) + 1));
            for (let x in first.x..last.x + 1) {
                Draw.Line(Vec2(x * tile, 0), Vec2(x * tile, size.y), lineWidth, Depth.Nearest, grid);
            }
            for (let y in first.y..last.y + 1) {
                Draw.Line(Vec2(0, y * tile), Vec2(size.x, y * tile), lineWidth, Depth.Nearest, grid);
            }
        }
        let edge = DrawParams(color: Color(0.8, 0.64, 0.16, 0.8), space: DrawSpace.ScreenWorld);
        let corners = [Vec2(0, 0), Vec2(size.x, 0), Vec2(size.x, size.y), Vec2(0, size.y)];
        for (let index in 0..4) {
            Draw.Line(corners[index], corners[(index + 1) % 4], 2 * lineWidth, Depth.Nearest, edge);
        }
    }

    // The layers: click one to edit it (its kind, tile size), whether it is shown
    void LayerPanel() {
        Ui.WithFont(Ui.style.fontName, EditorTextScale);
        Ui.Panel(UiAnchor.RightBottom, 220 * EditorTextScale, 0, Vec2i(-8, -8));
        Ui.Label(TFormat("Level '", levelName, "'", isModified ? " *" : "", "  ", data.size.x, " x ", data.size.y, " tiles of ", data.tileSize),
            UiAlign.Left, Ui.style.textFocused);
        Ui.Space(2);
        for (let index, layer in data.layers) {
            Ui.Columns(2, 0.86);           // (the button, its shown checkbox)
            let label = TFormat(layer.name, "  (", layer.case, ", ", TileSizeOf(layer), " px)", layer.isLocked ? " locked" : "");
            if (Ui.Button(label, id: index, align: UiAlign.Left, isToggled: index == selected))
                selected = index;
            let shown = !layer.isHidden;
            if (Ui.Checkbox("", &shown, id: index)) {
                layer.isHidden = !shown;
                MarkDirty(index + 1);
                Commit(TFormat(shown ? "Show " : "Hide ", layer.name));
            }
        }
    }

    // The tools, and the selected Tiles layer's tileset to pick the tile from
    void ToolPanel() {
        if (data.layers.len == 0)
            return;
        let layer = &data.layers[selected];
        Ui.WithFont(Ui.style.fontName, EditorTextScale);
        // (as wide as the palette when that is wider: its tiles at the game's size)
        let paletteWidth = layer.case == LevelLayer.Tiles ? drawings.layers[selected].tilemap.tileset.columns * layer.tileDim.x * GameScale() : 0;
        Ui.Panel(UiAnchor.LeftBottom, Max(240 * EditorTextScale, paletteWidth + 2 * Ui.style.padding), 0, Vec2i(8, -8));
        if (layer.case == LevelLayer.Decals) {
            Ui.Columns(2);
            if (Ui.Button("Place V", isToggled: tool == EditorTool.Place))
                tool = EditorTool.Place;
            if (Ui.Button("Select V", isToggled: tool == EditorTool.Select))
                tool = EditorTool.Select;
        } else {
            Ui.Columns(4);
            if (Ui.Button("Brush B", isToggled: tool == EditorTool.Brush))
                tool = EditorTool.Brush;
            if (Ui.Button("Line L", isToggled: tool == EditorTool.Line))
                tool = EditorTool.Line;
            if (Ui.Button("Rect R", isToggled: tool == EditorTool.Rect))
                tool = EditorTool.Rect;
            if (Ui.Button("Pick I", isToggled: tool == EditorTool.Pick))
                tool = EditorTool.Pick;
        }
        {
            Ui.Columns(2);
            if (Ui.Button(history.canUndo ? "Undo Ctrl+Z" : "(no undo)", enabled: history.canUndo))
                Undo();
            if (Ui.Button(history.canRedo ? "Redo Ctrl+Y" : "(no redo)", enabled: history.canRedo))
                Redo();
        }
        if (history.canUndo)
            Ui.Label(TFormat("undo: ", history.undoName), UiAlign.Left, Ui.style.textDisabled);
        if (layer.case != LevelLayer.Decals) {
            // The brush's (and the line's) size and shape
            {
                Ui.Columns(3, 0.5);
                Ui.Label(TFormat("size ", brushSize, " W/S"), UiAlign.Left);
                if (Ui.Button("-", id: 100, enabled: brushSize > 1))
                    brushSize = Max(1, brushSize - 1);
                if (Ui.Button("+", id: 100, enabled: brushSize < BRUSH_SIZE_MAX))
                    brushSize = Min(BRUSH_SIZE_MAX, brushSize + 1);
            }
            {
                // (the brush's shape; random tiles from the bag: Tiles layers)
                Ui.Columns(2);
                Ui.Toggle("Round", &isBrushRound, id: 100);
                let canRandom = layer.case == LevelLayer.Tiles;
                if (Ui.Button("Random N", id: 100, enabled: canRandom, isToggled: isRandom && canRandom))
                    isRandom = !isRandom;
            }
        }
        if (layer.case == LevelLayer.Tiles) {
            let active = ActiveStamp(layer);
            if (isRandom) {
                Ui.Label(TFormat(layer.tileset, ": random, ", TileBagOf(layer.tileset).len, " in the bag"), UiAlign.Left);
                Ui.Label("palette: left in, right out (Shift 5, Ctrl 10)", UiAlign.Left, Ui.style.textDisabled);
            } else if (active == null)
                Ui.Label(TFormat(layer.tileset, ": tile ", tile), UiAlign.Left);
            else if (stampSlot >= 0)
                Ui.Label(TFormat(layer.tileset, ": stamp ", StampSet.KeyOf(stampSlot), " (", active.w, " x ", active.h, ")"), UiAlign.Left);
            else
                Ui.Label(TFormat(layer.tileset, ": stamp ", active.w, " x ", active.h, " (Ctrl+1..0 keeps it)"), UiAlign.Left);
            StampList(layer);
            Palette(layer, &drawings.layers[selected].tilemap.tileset);
        } else if (layer.case == LevelLayer.Autotiles) {
            Ui.Label("left: solid, right: open", UiAlign.Left);
        } else {
            DecalPanel(layer);
        }
    }

    // The tileset's stamp slots, two rows of five: the key and the stamp's size (a click: paint
    // with it; an empty slot greyed out)
    void StampList(LevelLayer* layer) {
        let stamps = StampSetOf(layer.tileset);
        let active = ActiveStamp(layer);
        Ui.WithFont(Ui.style.fontName, EditorTextScale - 1);
        for (let row in 0..2) {
            Ui.Columns(5);
            for (let column in 0..5) {
                let slot = row * 5 + column;
                let tiles = &stamps.slots[slot];
                let key = StampSet.KeyOf(slot);
                let label = tiles.w == 0 ? TFormat(key, ": -") : TFormat(key, ": ", tiles.w, "x", tiles.h);
                if (Ui.Button(label, id: slot, enabled: tiles.w > 0, align: UiAlign.Left, isToggled: active != null && stampSlot == slot))
                    UseStamp(*tiles, layer.tileset, slot);
            }
        }
    }

    // How big a canvas pixel is in the window when the game runs (its fixed canvas, scaled up
    // by a whole number): the palette's tiles look as they do in the game
    int GameScale() {
        let canvas = Draw.state.canvasDimFixed;
        return Max(1, Min(Input.windowDim.x / Max(1, canvas.x), Input.windowDim.y / Max(1, canvas.y)));
    }

    // The tileset's tiles (as big as in the game): click one to paint with it
    void Palette(LevelLayer* layer, Tileset* tileset) {
        let scale = GameScale();
        let tileSize = tileset.tileDim * scale;
        let rect = Ui.NextRect(tileset.rows * tileSize.y);
        let columns = Max(1, Min(tileset.columns, rect.w / tileSize.x));
        let mouse = Input.cursors.ui;
        let depth = Ui.NextDepth();
        let bag = RandomBagOf(layer);
        for (let index in 0..tileset.count) {
            let pos = Vec2i(rect.x + (index % tileset.columns) * tileSize.x, rect.y + (index / tileset.columns) * tileSize.y);
            let slice = tileset.GetQuad(index, Vec2(0, 0));
            if (slice.isVisible) {
                let quad = slice.quad;
                let place = (Vec2 corner) => Vec2(pos) + corner * scale;
                quad.leftTop = place(quad.leftTop);
                quad.leftBottom = place(quad.leftBottom);
                quad.rightTop = place(quad.rightTop);
                quad.rightBottom = place(quad.rightBottom);
                Draw.SpriteQuad(tileset.sprite, quad, depth, DrawParams(space: DrawSpace.UI));
            }
            let tileRect = Rect(Vec2(pos), Vec2(tileSize));
            // (random: left puts the tile in the bag, right takes one out; else left picks it)
            let inBag = bag != null ? bag.Count((byte)index) : 0;
            if (tileRect.Contains(mouse) && bag != null) {
                // (Shift: 5 at a time, Ctrl: 10)
                let ctrl = Input.KeyDown(Scancode.LCtrl) || Input.KeyDown(Scancode.RCtrl);
                let shift = Input.KeyDown(Scancode.LShift) || Input.KeyDown(Scancode.RShift);
                let count = ctrl ? 10 : shift ? 5 : 1;
                if (Input.MousePressed(MouseButton.Left))
                    bag.Add((byte)index, count);
                if (Input.MousePressed(MouseButton.Right)) {
                    for (let removal in 0..count) {
                        bag.Remove((byte)index);
                    }
                }
                inBag = bag.Count((byte)index);
            } else if (tileRect.Contains(mouse) && Input.MousePressed(MouseButton.Left)) {
                tile = (byte)index;
                DropStamp();               // (the tile again, not the stamp)
            }
            if (inBag > 0) {
                // (how often it is in the bag, at its bottom right)
                let count = TFormat(inBag);
                let box = Recti(pos.x + tileSize.x - Ui.TextWidth(count) - 4, pos.y + tileSize.y - Ui.lineHeight - 2, Ui.TextWidth(count) + 4, Ui.lineHeight + 2);
                Ui.DrawRect(box, Color(0.05, 0.05, 0.07, 0.85));
                Ui.DrawTextIn(count, box, UiAlign.Center, Color(1, 0.94, 0.55, 1));
            }
            let isMarked = bag != null ? inBag > 0 : index == tile;
            if (isMarked || tileRect.Contains(mouse)) {
                let color = isMarked ? Color(1, 0.94, 0.55, 1) : Color(0.6, 0.6, 0.6, 0.6);
                let outline = DrawParams(color: color, space: DrawSpace.UI);
                let near = Ui.NextDepth();
                Draw.Rect(Vec2(pos), Vec2(tileSize.x, 1), near, outline);
                Draw.Rect(Vec2(pos.x, pos.y + tileSize.y - 1), Vec2(tileSize.x, 1), near, outline);
                Draw.Rect(Vec2(pos), Vec2(1, tileSize.y), near, outline);
                Draw.Rect(Vec2(pos.x + tileSize.x - 1, pos.y), Vec2(1, tileSize.y), near, outline);
            }
        }
    }

    int TileSizeOf(LevelLayer* layer) {
        switch (layer.case) {
        case LevelLayer.Tiles: return layer.tileDim.x;
        case LevelLayer.Autotiles: return data.pixelSize.x / Max(1, layer.solid.w);
        case LevelLayer.Decals: return data.tileSize;
        }
    }
}
